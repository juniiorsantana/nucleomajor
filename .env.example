PORT=3000
PUBLIC_ORIGIN=https://nucleomajor.com
# O painel da plataforma: mesmo servidor, outro subdomínio, escolhido pelo Host.
# PAINEL_HOSTS é opcional (padrão: o host de PAINEL_ORIGIN e painel.localhost).
PAINEL_ORIGIN=https://painel.nucleomajor.com
# PAINEL_HOSTS=painel.nucleomajor.com,painel.localhost

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# O build web usa estas mesmas variáveis do servidor. Não exponha service_role.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=acesso@nucleomajor.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Núcleo Major
SMTP_FROM_EMAIL=acesso@nucleomajor.com

# Checkout no Asaas (ver scripts/sql/ligar-checkout-asaas.sql).
# ASAAS_WEBHOOK_TOKEN: o mesmo "Token de autenticação" cadastrado no webhook do
# painel do Asaas. ASAAS_API_KEY: só para ler o e-mail do cliente que pagou.
# ASAAS_API_URL: https://api-sandbox.asaas.com/v3 no ensaio,
# https://api.asaas.com/v3 em produção. BILLING_INTAKE_TOKEN: o valor que o
# BLOCO 1 do ligar-checkout-asaas.sql mostra uma única vez.
ASAAS_WEBHOOK_TOKEN=
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
BILLING_INTAKE_TOKEN=
# Endereço do Link de Pagamento do plano Base (botão "Assinar" do portal).
PUBLIC_CHECKOUT_URL=
# Quem recebe o aviso de nova venda (separe por vírgula).
OPS_NOTIFY_EMAILS=

# Formulário instantâneo do Meta (Lead Ads) → /api/webhooks/meta-leads.
# Ver docs/META-LEADS.md. Sem as quatro primeiras o webhook responde 503.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Token de usuário do sistema do portfólio, com leads_retrieval.
META_LEADS_ACCESS_TOKEN=
# {"<id da página do Facebook>": "<token gerado por scripts/sql/ligar-formulario-meta.sql>"}
META_LEADS_INTAKES=
# Opcional. Vazio usa a versão padrão do app no Meta.
META_GRAPH_VERSION=

# Inclua a extensão Chrome publicada e os endereços locais de desenvolvimento.
CORS_ALLOWED_ORIGINS=https://nucleomajor.com,http://localhost:4173
