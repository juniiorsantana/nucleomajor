  "allowedTools": ["calendar.read", "calendar.availability", "calendar.prepare", "calendar.confirm"],
  "guardrails": ["explicit_confirmation", "absolute_date", "idempotency", "no_task_substitution"],
  "handoff": ["tool_unavailable", "permission_denied", "participant_conflict"]
