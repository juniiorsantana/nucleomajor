+    def _diagnostico(self, inicio: float, resposta: Any) -> dict:
+        """O que dá para saber de uma falha sem guardar conversa nem resposta:
+        modelo, tempo, tamanho, código de saída e os dados técnicos da CLI.
+        Não há nova tentativa: `attempt` é sempre 1, para o dia em que houver."""
+        dados: dict = {
+            "model": str(self.modelo or "")[:80],
+            "latency_ms": int((time.monotonic() - inicio) * 1000),
+            "attempt": 1,
+        }
+        if resposta is not None:
+            dados["reply_chars"] = len(str(getattr(resposta, "reply", "") or ""))
+            dados["exit_code"] = getattr(resposta, "exit_code", None)
+            meta = getattr(resposta, "meta", None)
+            if isinstance(meta, dict):
+                dados.update({f"cli_{chave}": valor for chave, valor in meta.items()})
+        return dados
