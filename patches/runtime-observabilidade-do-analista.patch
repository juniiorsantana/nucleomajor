+class DiagnosticoDaFalhaTests(AnalistaTests):
+    """A falha de formato vai para o log com o que ajuda a achar a causa:
+    etapa, modelo, tempo, tamanho e dados técnicos da CLI. Nunca o texto."""
+
+    # Só os testes desta classe; os herdados já rodam em AnalistaTests.
+    test_sem_conta_logada_falha_sem_chamar_o_claude = None
+    test_analisa_com_a_conta_de_analise_sem_ferramentas = None
+    test_erro_do_claude_e_resposta_torta_viram_falha = None
+    test_fila_cheia_falha_na_hora = None
+
+    def _falha(self):
+        chamada = [c for c in self.log.call_args_list if c.args and c.args[0] == "analysis.failed"][-1]
+        return chamada.kwargs
+
+    def test_etapa_e_dados_tecnicos_sem_conteudo(self):
+        segredo = "Quanto custa o site? resposta do modelo sem JSON"
+        casos = [
+            (segredo, "json_ausente"),
+            ("{" + segredo + "}", "json_invalido"),
+            ("[1, 2]", "json_ausente"),
+            (json.dumps({"resumo": ""}), "schema_sem_resumo"),
+        ]
+        for reply, etapa in casos:
+            resposta = runner.RunResult(reply=reply, session_id=None, exit_code=0, duration_ms=1, tools_used=[],
+                                        meta={"stop_reason": "max_tokens", "output_tokens": 4096, "models": ["claude-sonnet-5"]})
+            a = self.novo(lambda *x, **k: resposta)
+            self.assertEqual(a.analisar(CARGA), "failed")
+            dados = self._falha()
+            self.assertEqual(dados["error_code"], "analysis_invalid_response")
+            self.assertEqual(dados["stage"], etapa, reply)
+            self.assertEqual((dados["model"], dados["attempt"], dados["exit_code"]), ("sonnet", 1, 0))
+            self.assertEqual(dados["reply_chars"], len(reply))
+            self.assertEqual((dados["cli_stop_reason"], dados["cli_output_tokens"]), ("max_tokens", 4096))
+            self.assertIsInstance(dados["latency_ms"], int)
+            self.assertNotIn("Quanto custa", json.dumps(dados, ensure_ascii=False))
+            # O banco continua recebendo só o código de sempre.
+            self.assertEqual(self.verifier.gravadas[-1], {"analysisId": CARGA["analysisId"], "status": "failed",
+                                                          "errorCode": "analysis_invalid_response", "model": "sonnet"})
+
+    def test_resposta_que_nao_e_objeto(self):
+        resposta = runner.RunResult(reply='"so um texto"', session_id=None, exit_code=0, duration_ms=1, tools_used=[])
+        with patch.object(analista, "_json_do_texto", return_value=["lista"]):
+            self.novo(lambda *x, **k: resposta).analisar(CARGA)
+        self.assertEqual(self._falha()["stage"], "schema_nao_objeto")
+
+    def test_erro_do_claude_tambem_leva_modelo_e_tempo(self):
+        def limite(*a, **k):
+            raise runner.RunnerError("limite", code="model_rate_limited")
+
+        self.novo(limite).analisar(CARGA)
+        dados = self._falha()
+        self.assertEqual((dados["error_code"], dados["model"], dados["attempt"]), ("model_rate_limited", "sonnet", 1))
+        self.assertNotIn("reply_chars", dados)
+
+
