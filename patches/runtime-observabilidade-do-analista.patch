+class ExtractMetaTest(unittest.TestCase):
+    """Os dados técnicos da execução, para diagnosticar sem guardar texto."""
+
+    def test_campos_tecnicos(self):
+        payload = {
+            "result": "a resposta inteira, que não pode ir para o meta",
+            "subtype": "success", "stop_reason": "max_tokens", "is_error": False, "num_turns": 1,
+            "usage": {"output_tokens": 812, "input_tokens": 9000},
+            "modelUsage": {"claude-sonnet-5": {"outputTokens": 812}},
+            "session_id": "s1",
+        }
+        meta = runner._extract_meta(payload)
+        self.assertEqual(meta, {
+            "subtype": "success", "stop_reason": "max_tokens", "is_error": False, "num_turns": 1,
+            "output_tokens": 812, "models": ["claude-sonnet-5"],
+        })
+        self.assertNotIn("resposta inteira", str(meta))
+
+    def test_texto_longo_e_forma_estranha_ficam_de_fora(self):
+        self.assertEqual(runner._extract_meta({"stop_reason": "x" * 41, "usage": "?"}), {})
+        self.assertEqual(runner._extract_meta("texto cru"), {})
+        self.assertEqual(runner._extract_meta(None), {})
+
+
