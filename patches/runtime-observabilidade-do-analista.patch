         tools_used=_extract_tools(payload),
+        meta=_extract_meta(payload),
     )
 
 
+def _extract_meta(payload: object) -> dict:
+    """Só campos técnicos e curtos do JSON da CLI, nunca o texto da resposta."""
+    if not isinstance(payload, dict):
+        return {}
+    meta: dict = {}
+    for chave in ("subtype", "stop_reason", "is_error", "num_turns"):
+        valor = payload.get(chave)
+        if isinstance(valor, bool) or isinstance(valor, int) or (isinstance(valor, str) and len(valor) <= 40):
+            meta[chave] = valor
+    uso = payload.get("usage")
+    if isinstance(uso, dict) and isinstance(uso.get("output_tokens"), int):
+        meta["output_tokens"] = uso["output_tokens"]
+    modelos = payload.get("modelUsage")
+    if isinstance(modelos, dict):
+        meta["models"] = [str(nome)[:60] for nome in list(modelos)[:3]]
+    return meta
+
