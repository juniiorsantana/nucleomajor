 class RunnerError(RuntimeError):
     """Falha para a qual nao existe resposta a enviar."""
 
-    def __init__(self, message: str, *, code: str = "model_unavailable") -> None:
+    def __init__(self, message: str, *, code: str = "model_unavailable", detalhe: str = "") -> None:
         super().__init__(message)
         self.code = code
+        # A mensagem de erro que a CLI devolveu no JSON (`result` com
+        # `is_error`), curta. É o texto da API ("You've hit your session
+        # limit..."), nunca o da conversa — ver `_erro_da_cli`.
+        self.detalhe = detalhe
+
+
+def _erro_da_cli(stdout: str) -> str:
+    """O texto de erro que a CLI põe no JSON quando a chamada falha.
+
+    Em 02/10/2026 uma análise falhou como `model_unavailable` sem pista
+    nenhuma, e a mensagem certa ("You've hit your session limit · resets
+    12:10am") estava no `result` do stdout, que ninguém lia. Só sai quando a
+    própria CLI marca `is_error`: nesse caso o `result` é o erro, e não uma
+    resposta do modelo.
+    """
+    try:
+        payload = json.loads(stdout or "")
+    except (ValueError, TypeError):
+        return ""
+    if not isinstance(payload, dict) or payload.get("is_error") is not True:
+        return ""
+    texto = " ".join(str(payload.get("result") or "").split())
+    return texto[:160]
 
 
