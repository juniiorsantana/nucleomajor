+class CamadaDeInteligenciaTests(unittest.TestCase):
+    """Fatos e notas prontos no prompt; evidência que aponta o message_id."""
+
+    def test_mensagens_numeradas(self):
+        prompt = analista.montar_prompt(CARGA_COM_FATOS)
+        self.assertIn("#1 [01/10 09:00] Contato: Quanto custa o site?", prompt)
+        self.assertIn("#3 [01/10 09:06] Contato: [áudio]", prompt)
+
+    def test_fatos_e_notas_entram_prontos(self):
+        prompt = analista.montar_prompt(CARGA_COM_FATOS)
+        self.assertIn("Primeira resposta da empresa: 5 min", prompt)
+        self.assertIn("o contato espera resposta há 26.5 h", prompt)
+        self.assertIn("negócio aberto na etapa Em contato", prompt)
+        self.assertIn("tarefas abertas 1 (atrasadas 1)", prompt)
+        self.assertIn("- lead: 70/100; não atendeu: prazo_definido", prompt)
+        # Família sem nota não aparece; sem fatos nem notas, nenhuma das seções.
+        self.assertNotIn("- atendimento:", prompt)
+        vazio = analista.montar_prompt(CARGA)
+        self.assertNotIn("Fatos medidos", vazio)
+        self.assertNotIn("Notas calculadas", vazio)
+
+    def test_evidencia_vira_message_id(self):
+        bruto = resposta(porque=[
+            {"texto": "Perguntou preço primeiro", "evidencia": "Quanto custa", "mensagens": [1, "3", 1, 99, 0, "x"]},
