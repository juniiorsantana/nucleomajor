+++ b/whatsapp-assistant/test_transcritor.py
@@ -0,0 +1,419 @@
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+import media
+import transcribe
+import transcritor
+from operator_verification import OperatorVerificationError
+
+
+class VerificadorFalso:
+    def __init__(self, pendentes=None, falhar_gravacao=False, arquivos=None):
+        self.pendentes = pendentes or []
+        self.falhar_gravacao = falhar_gravacao
+        self.arquivos = arquivos or {}
+        self.gravados = []
+        self.perguntas = []
+        self.baixados = []
+
+    def transcript_pending(self, payload):
+        self.perguntas.append(payload)
+        return {"items": self.pendentes}
+
+    def transcript_record(self, payload):
+        if self.falhar_gravacao:
+            raise OperatorVerificationError("fora do ar")
+        self.gravados.extend(payload["items"])
+        return {"recorded": len(payload["items"])}
+
+    def storage_download(self, bucket, path):
+        self.baixados.append((bucket, path))
+        return self.arquivos[path]
+
+
+class Base(unittest.TestCase):
+    def setUp(self):
+        self.pasta = Path(tempfile.mkdtemp())
+        self.cache = transcritor.Cache(self.pasta / "transcricoes.db")
+        self.transcritos = []
+
+    def transcrever(self, caminho, model_size, language):
+        self.transcritos.append((Path(caminho).read_bytes(), model_size, language))
+        return f"  texto de {Path(caminho).read_bytes().decode()}  "
+
+    def novo(self, verifier, **kw):
+        return transcritor.Transcritor(verifier=verifier, cache=self.cache, transcrever=self.transcrever, **kw)
+
+    def arquivo(self, nome, conteudo):
+        caminho = self.pasta / nome
+        caminho.write_bytes(conteudo.encode())
+        return caminho
+
+
+class ConversaDiretaTests(unittest.TestCase):
+    def test_so_telefone_e_lid(self):
+        self.assertTrue(transcritor.conversa_direta("5565999990000@s.whatsapp.net"))
+        self.assertTrue(transcritor.conversa_direta("185474454974600@lid"))
+        self.assertFalse(transcritor.conversa_direta("120363000000000001@g.us"))
+        self.assertFalse(transcritor.conversa_direta("status@broadcast"))
+        self.assertFalse(transcritor.conversa_direta(""))
+
+
+class CacheTests(Base):
+    def test_guarda_e_le(self):
+        self.assertIsNone(self.cache.ler("m1"))
+        self.cache.guardar("m1", "oi")
+        self.assertEqual(self.cache.ler("m1"), "oi")
+
+    def test_texto_vazio_e_resposta(self):
+        # Áudio sem fala: vazio é resposta, não ausência — não transcreve de novo.
+        self.cache.guardar("m1", "")
+        self.assertEqual(self.cache.ler("m1"), "")
+
+    def test_poda_o_que_passou_da_janela(self):
+        self.cache.guardar("velho", "x")
+        with sqlite3.connect(self.cache.caminho) as c:
+            c.execute("UPDATE transcricoes SET quando = 0")
+        self.cache._podado_em = 0
+        self.cache.guardar("novo", "y")
+        self.assertIsNone(self.cache.ler("velho"))
+        self.assertEqual(self.cache.ler("novo"), "y")
+
+
+class FilaTests(Base):
+    def test_audio_novo_vira_texto_gravado_e_o_arquivo_some(self):
+        verifier = VerificadorFalso()
+        t = self.novo(verifier, modelo="small", idioma="pt")
+        caminho = self.arquivo("a.ogg", "a1")
+        self.assertTrue(t.submit("a1", str(caminho)))
+        t.start()
+        t.stop()
+        self.assertEqual(verifier.gravados, [{"id": "a1", "text": "texto de a1"}])
+        self.assertEqual(self.transcritos, [(b"a1", "small", "pt")])
+        self.assertFalse(caminho.exists())
+        self.assertEqual(self.cache.ler("a1"), "texto de a1")
+
+    def test_ja_no_cache_so_grava(self):
+        self.cache.guardar("a1", "o atendente já transcreveu")
+        verifier = VerificadorFalso()
+        t = self.novo(verifier)
+        caminho = self.arquivo("a.ogg", "a1")
+        t.submit("a1", str(caminho))
+        t.start()
+        t.stop()
+        self.assertEqual(self.transcritos, [])
+        self.assertEqual(verifier.gravados, [{"id": "a1", "text": "o atendente já transcreveu"}])
+        self.assertFalse(caminho.exists())
+
+    def test_falha_na_transcricao_nao_grava_e_apaga(self):
+        def falha(*a, **k):
+            raise transcribe.TranscribeError("arquivo torto")
+
+        verifier = VerificadorFalso()
+        t = transcritor.Transcritor(verifier=verifier, cache=self.cache, transcrever=falha)
+        caminho = self.arquivo("a.ogg", "a1")
+        t.submit("a1", str(caminho))
+        with mock.patch("audit.log") as log:
+            t.start()
+            t.stop()
+        self.assertEqual(verifier.gravados, [])
+        self.assertFalse(caminho.exists())
+        self.assertIn("audio.transcript_failed", [c.args[0] for c in log.call_args_list])
+
+    def test_banco_fora_do_ar_deixa_o_texto_no_cache(self):
+        verifier = VerificadorFalso(falhar_gravacao=True)
+        t = self.novo(verifier)
+        t.submit("a1", str(self.arquivo("a.ogg", "a1")))
+        with mock.patch("audit.log") as log:
+            t.start()
+            t.stop()
+        self.assertEqual(self.cache.ler("a1"), "texto de a1")
+        self.assertIn("audio.transcript_record_failed", [c.args[0] for c in log.call_args_list])
+
+    def test_fila_cheia_devolve_o_arquivo(self):
+        with mock.patch.object(transcritor, "FILA_MAXIMA", 1):
+            t = self.novo(VerificadorFalso())
+        self.assertTrue(t.submit("a1", "x"))
+        with mock.patch("audit.log"):
+            self.assertFalse(t.submit("a2", "y"))
+
+    def test_o_texto_nao_vai_para_o_log(self):
+        verifier = VerificadorFalso()
+        t = self.novo(verifier)
+        t.submit("a1", str(self.arquivo("a.ogg", "segredo")))
+        with mock.patch("audit.log") as log:
+            t.start()
+            t.stop()
+        self.assertNotIn("segredo", repr(log.call_args_list))
+
+
+class CompletarTests(Base):
+    def carga(self):
+        return {
+            "analysisId": "an1",
+            "messages": [
+                {"id": "t1", "mediaType": "", "content": "oi"},
+                {"id": "a1", "mediaType": "ptt", "content": ""},
+                {"id": "a2", "mediaType": "audio", "content": ""},
+                {"id": "a3", "mediaType": "audio", "content": "legenda"},
+                {"id": "i1", "mediaType": "image", "content": ""},
+            ],
+        }
+
+    def test_transcreve_do_bucket_grava_e_preenche_a_carga(self):
+        verifier = VerificadorFalso(
+            pendentes=[{"id": "a2", "mediaPath": "org/con/5565/a2.ogg"}, {"id": "a1", "mediaPath": "org/con/5565/a1.ogg"}],
+            arquivos={"org/con/5565/a1.ogg": b"um", "org/con/5565/a2.ogg": b"dois"},
+        )
+        t = self.novo(verifier)
