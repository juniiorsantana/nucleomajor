+"""O transcritor: todo áudio de conversa direta vira texto no espelho.
+
+Até 02/10/2026 a VPS transcrevia áudio só para o atendente responder, e jogava
+o texto fora. Quem lia a conversa pelo banco — o Agente Analista, o Jev, a
+linha do tempo do relatório, a equipe no portal — via só "[áudio]". Medido na
+Adriani: 22% do que a empresa manda é áudio. A análise julgava o atendimento
+sem ouvir um quinto dele.
+
+Decisões do dono (02/10/2026):
+
+  * só conversa direta — grupo não, porque ninguém lê grupo pelo banco hoje;
+  * o áudio NOVO é transcrito quando chega: o `media_mirror` já baixa cada um
+    para subir ao bucket, e em vez de apagar a cópia local entrega a ela;
+  * o áudio ANTIGO só quando alguém pede a análise daquela conversa: o
+    analista chama `completar` antes de analisar, e ela transcreve o que o
+    banco disser que falta (`nucleo_message_transcript_pending`), baixando do
+    bucket — que não depende de o WhatsApp ainda ter a mídia.
+
+O texto vai para o `content` da própria mensagem
+(`nucleo_message_transcript_record`, migration 20261007100000), e só onde ele
+está vazio. O analista e o Jev já montam "[áudio] <texto>", então passam a
+ouvir o áudio sem mudar.
+
+O CACHE LOCAL. Cada texto também fica num SQLite ao lado do `messages.db`,
+pelo id da mensagem. É ele que evita transcrever duas vezes: o atendente
+transcreve o áudio do cliente para responder antes de o espelho chegar a ele
+(e guarda aqui), e o transcritor, quando chega a vez, só grava o que já está
+pronto. Se a gravação no banco falhar, o texto continua no cache e a próxima
+análise da conversa grava sem transcrever de novo.
+
+O texto transcrito nunca vai para log: só id, tamanho e tempo.
+"""
+
+from __future__ import annotations
+
+import queue
+import sqlite3
+import tempfile
+import threading
+import time
+from pathlib import Path
+from typing import Any, Callable, Optional
+
+import audit
+import media
+import transcribe
+from operator_verification import OperatorVerificationError
+
+BUCKET = "whatsapp-media"
+TIPOS_DE_AUDIO = frozenset({"audio", "ptt"})
+# Conversa direta no Bridge: telefone ou LID. Grupo é `@g.us`; canal, lista e
+# status são outros sufixos, e nenhum deles entra.
+SUFIXOS_DIRETOS = ("@s.whatsapp.net", "@lid")
+
+FILA_MAXIMA = 500
+# Quanto a análise espera pela transcrição dos áudios antigos antes de seguir
+# com o que tiver. O pedido expira em 15 minutos; sobra folga para o Jev e
+# para o Claude (até 4 minutos).
+PRAZO_DA_ANALISE = 420.0
+# O mesmo teto do `content` na sincronia e na RPC.
+TETO_TEXTO = 8000
+RETENCAO_DO_CACHE = 90 * 24 * 3600.0
+
+
+def conversa_direta(chat_jid: Any) -> bool:
+    return str(chat_jid or "").strip().endswith(SUFIXOS_DIRETOS)
+
+
+def caminho_do_cache() -> Path:
+    import messages
+
+    return messages.configured_messages_db().with_name("transcricoes.db")
+
+
+class Cache:
+    """Texto por id de mensagem, num SQLite da instância.
+
+    Uma conexão por operação: o atendente, o transcritor e o analista vivem em
+    threads diferentes, e o SQLite não divide conexão entre threads.
+    """
+
+    def __init__(self, caminho: Path) -> None:
+        self.caminho = Path(caminho)
+        self._podado_em = 0.0
+
+    def _abrir(self) -> sqlite3.Connection:
+        conexao = sqlite3.connect(self.caminho, timeout=5)
+        conexao.execute(
+            "CREATE TABLE IF NOT EXISTS transcricoes ("
+            " message_id TEXT PRIMARY KEY, texto TEXT NOT NULL, quando REAL NOT NULL)"
+        )
+        return conexao
+
+    def ler(self, message_id: str) -> Optional[str]:
+        if not message_id:
+            return None
+        try:
+            conexao = self._abrir()
+        except sqlite3.Error:
+            return None
+        try:
+            linha = conexao.execute(
+                "SELECT texto FROM transcricoes WHERE message_id = ?", (message_id,)
+            ).fetchone()
+        except sqlite3.Error:
+            return None
+        finally:
+            conexao.close()
+        return None if linha is None else str(linha[0])
+
+    def guardar(self, message_id: str, texto: str) -> None:
+        if not message_id:
+            return
+        agora = time.time()
+        try:
+            conexao = self._abrir()
+        except sqlite3.Error as exc:
+            audit.log("audio.transcript_cache_failed", error=type(exc).__name__)
+            return
+        try:
+            with conexao:
+                conexao.execute(
+                    "INSERT OR REPLACE INTO transcricoes (message_id, texto, quando) VALUES (?, ?, ?)",
+                    (message_id, texto, agora),
+                )
+                # A janela do espelho. Uma vez por dia basta.
+                if agora - self._podado_em > 24 * 3600:
+                    conexao.execute(
+                        "DELETE FROM transcricoes WHERE quando < ?", (agora - RETENCAO_DO_CACHE,)
+                    )
+                    self._podado_em = agora
+        except sqlite3.Error as exc:
+            audit.log("audio.transcript_cache_failed", error=type(exc).__name__)
+        finally:
+            conexao.close()
+
+
+class Transcritor:
+    def __init__(
+        self,
+        *,
+        verifier,
+        cache: Cache,
+        modelo: str = "small",
+        idioma: Optional[str] = "pt",
+        api_base_url: str = "",
+        token_loader: Callable[[], Optional[str]] = lambda: None,
+        messages_db: Optional[Path] = None,
+        transcrever: Callable[..., str] = transcribe.transcribe_audio,
+        relogio: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self.verifier = verifier
+        self.cache = cache
+        self.modelo = modelo
+        self.idioma = idioma
+        self.api_base_url = str(api_base_url or "").rstrip("/")
+        self.token_loader = token_loader
+        self.messages_db = Path(messages_db) if messages_db else None
+        self._transcrever = transcrever
+        self._relogio = relogio
+        self.fila: "queue.Queue[Optional[tuple[str, str]]]" = queue.Queue(maxsize=FILA_MAXIMA)
+        self._thread: Optional[threading.Thread] = None
+
+    # ------------------------------------------------------------ a fila
+
+    def submit(self, message_id: str, caminho_local: str) -> bool:
+        """Entrega um áudio novo, já baixado. O arquivo passa a ser daqui: é
+        apagado depois de transcrito. Fila cheia devolve False e o arquivo
+        continua de quem chamou."""
+        if not message_id or not caminho_local:
+            return False
+        try:
+            self.fila.put_nowait((str(message_id), str(caminho_local)))
+            return True
+        except queue.Full:
+            audit.log("audio.transcript_queue_full")
+            return False
+
+    def start(self) -> None:
+        if self._thread and self._thread.is_alive():
+            return
+        self._thread = threading.Thread(target=self._run, name="transcritor", daemon=True)
+        self._thread.start()
+
+    def stop(self) -> None:
+        try:
+            self.fila.put_nowait(None)
+        except queue.Full:
+            pass
+        if self._thread:
+            self._thread.join(timeout=5)
+
+    def _run(self) -> None:
+        while True:
+            item = self.fila.get()
+            if item is None:
+                return
+            message_id, caminho = item
+            try:
+                texto = self._texto(message_id, lambda: caminho)
+                if texto is not None:
+                    self._gravar({message_id: texto})
+            except Exception as exc:  # pragma: no cover - última barreira de um daemon
+                audit.log("audio.transcript_failed", message_id=message_id, error_code="unexpected",
+                          error=type(exc).__name__)
+            finally:
+                _apagar(caminho)
+
+    # ------------------------------------------------------------ o trabalho
+
+    def _texto(self, message_id: str, obter_arquivo: Callable[[], Optional[str]]) -> Optional[str]:
+        """O texto do áudio: do cache, ou transcrevendo o arquivo. None quando
+        não deu (falha já registrada no log)."""
+        pronto = self.cache.ler(message_id)
+        if pronto is not None:
+            return pronto
+        inicio = self._relogio()
+        try:
+            caminho = obter_arquivo()
+            if not caminho:
+                audit.log("audio.transcript_failed", message_id=message_id, error_code="no_file")
+                return None
+            texto = self._transcrever(caminho, model_size=self.modelo, language=self.idioma)
+        except (transcribe.TranscribeError, media.MediaError, OperatorVerificationError, OSError) as exc:
+            audit.log("audio.transcript_failed", message_id=message_id, error_code=type(exc).__name__)
+            return None
+        texto = str(texto or "").strip()[:TETO_TEXTO]
+        self.cache.guardar(message_id, texto)
+        audit.log("audio.transcribed", message_id=message_id, transcript_len=len(texto),
+                  latency_ms=int((self._relogio() - inicio) * 1000), source="transcritor")
+        return texto
+
+    def _gravar(self, textos: dict[str, str]) -> int:
+        if not textos:
+            return 0
+        itens = [{"id": chave, "text": valor} for chave, valor in textos.items()]
+        gravadas = 0
+        try:
+            for inicio in range(0, len(itens), 50):
+                resposta = self.verifier.transcript_record({"items": itens[inicio : inicio + 50]})
+                gravadas += int((resposta or {}).get("recorded") or 0)
+        except OperatorVerificationError as exc:
+            # O texto ficou no cache: a próxima análise da conversa grava.
+            audit.log("audio.transcript_record_failed", count=len(itens), error=str(exc)[:120])
+        return gravadas
+
+    # ------------------------------------------------------------ na análise
+
+    def completar(self, carga: dict, prazo: float = PRAZO_DA_ANALISE) -> dict:
+        """Transcreve os áudios sem texto da carga de uma análise e devolve a
+        carga com o texto no lugar. O que não couber no prazo segue como
+        "[áudio]"."""
+        mensagens = carga.get("messages") if isinstance(carga.get("messages"), list) else []
+        candidatas = [
+            str(m.get("id") or "")
+            for m in mensagens
+            if isinstance(m, dict)
+            and str(m.get("mediaType") or "").strip().lower() in TIPOS_DE_AUDIO
+            and not str(m.get("content") or "").strip()
+            and m.get("id")
+        ]
+        if not candidatas:
+            return carga
+        inicio = self._relogio()
+        try:
+            resposta = self.verifier.transcript_pending({"ids": candidatas[:80]})
+        except OperatorVerificationError as exc:
+            audit.log("analysis.transcript_failed", error_code="control_plane_unavailable", error=str(exc)[:120])
+            return carga
+        pendentes = [
+            item for item in (resposta or {}).get("items") or []
+            if isinstance(item, dict) and item.get("id")
+        ]
+        textos: dict[str, str] = {}
+        sem_prazo = 0
+        for item in pendentes:
+            if self._relogio() - inicio > prazo:
+                sem_prazo += 1
+                continue
+            message_id = str(item["id"])
+            caminho_no_bucket = str(item.get("mediaPath") or "").strip()
+            baixado: list[str] = []
+
+            def obter(message_id=message_id, caminho_no_bucket=caminho_no_bucket, baixado=baixado):
+                caminho = self._baixar(message_id, caminho_no_bucket)
+                if caminho:
+                    baixado.append(caminho)
+                return caminho
+
+            try:
+                texto = self._texto(message_id, obter)
+            finally:
+                for caminho in baixado:
+                    _apagar(caminho)
+            if texto is not None:
+                textos[message_id] = texto
+        gravadas = self._gravar(textos)
+        for m in mensagens:
+            if isinstance(m, dict) and str(m.get("id") or "") in textos:
+                m["content"] = textos[str(m["id"])]
+        audit.log("analysis.transcribed", analysis_id=str(carga.get("analysisId") or ""), pending=len(pendentes), transcribed=len(textos),
+                  recorded=gravadas, skipped_deadline=sem_prazo,
+                  latency_ms=int((self._relogio() - inicio) * 1000))
+        return carga
+
+    def _baixar(self, message_id: str, caminho_no_bucket: str) -> Optional[str]:
+        """O arquivo do áudio no disco: do bucket quando o espelho já o subiu
+        (num temporário), senão pelo Bridge. Quem chama apaga."""
+        if caminho_no_bucket:
+            dados = self.verifier.storage_download(BUCKET, caminho_no_bucket)
+            extensao = caminho_no_bucket.rsplit(".", 1)[-1] if "." in caminho_no_bucket else "ogg"
+            with tempfile.NamedTemporaryFile(suffix=f".{extensao}", delete=False) as arquivo:
+                arquivo.write(dados)
+            return arquivo.name
+        chat = self._chat_da_mensagem(message_id)
+        if not chat or not conversa_direta(chat):
+            return None
+        return media.download_media(self.api_base_url, self.token_loader() or "", message_id, chat)
+
+    def _chat_da_mensagem(self, message_id: str) -> str:
+        if self.messages_db is None:
+            return ""
+        try:
+            conexao = sqlite3.connect(f"file:{self.messages_db}?mode=ro", uri=True)
+        except sqlite3.Error:
+            return ""
+        try:
+            linha = conexao.execute("SELECT chat_jid FROM messages WHERE id = ? LIMIT 1", (message_id,)).fetchone()
+        except sqlite3.Error:
+            return ""
+        finally:
+            conexao.close()
+        return str(linha[0] or "") if linha else ""
+
+
+def _apagar(caminho: Any) -> None:
+    try:
+        Path(str(caminho)).unlink()
+    except OSError:
+        pass
