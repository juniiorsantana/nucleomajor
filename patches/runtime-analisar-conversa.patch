new file mode 100644
index 0000000..4a41ef6
--- /dev/null
+++ b/whatsapp-assistant/analista.py
@@ -0,0 +1,317 @@
+"""O Agente Analista: a análise completa de uma conversa, pedida pelo botão.
+
+O portal pede (`conversation_analysis_request`, migration 20261002100000), a
+fila de comandos entrega `conversation_analyze` a este runtime, e o executor
+de comandos passa a carga para cá. Aqui a análise roda numa fila PRÓPRIA, uma
+de cada vez, para nunca segurar a fila de comandos (envio de mensagem pelo
+portal) nem o atendimento ao cliente.
+
+O Claude roda na SEGUNDA conta da Major (`NUCLEO_ANALYSIS_CLAUDE_CONFIG_DIR`),
+separada da conta do atendimento por decisão do dono (02/10/2026): cada uma
+com o próprio limite. Sem essa conta logada, a análise FALHA com motivo
+(`analysis_account_missing`) e o crédito volta — ela nunca cai, escondida, na
+conta do atendimento.
+
+O Claude não recebe ferramenta nenhuma, nem pasta, nem sessão: lê o texto que
+vai por stdin e devolve JSON. O texto da conversa não vai para log.
+"""
+
+from __future__ import annotations
+
+import json
+import queue
+import re
+import threading
+import time
+from pathlib import Path
+from typing import Any, Callable, Optional
+from zoneinfo import ZoneInfo
+
+import audit
+from operator_verification import OperatorVerificationError
+
+FUSO = ZoneInfo("America/Sao_Paulo")
+TIMEOUT = 240
+
+SISTEMA = (
+    "Você é o Agente Analista do Núcleo Major. Você lê uma conversa de WhatsApp "
+    "entre uma empresa e um contato e escreve uma análise para o dono da empresa. "
+    "Seja direto, em português do Brasil, sem floreio. Use só o que está na "
+    "conversa: não invente fatos, valores, nomes ou datas. Cite trechos curtos das "
+    "mensagens como evidência. Responda SOMENTE com um objeto JSON válido, sem "
+    "texto antes ou depois e sem bloco de código."
+)
+
+FOCO = {
+    "comercial": (
+        "Análise COMERCIAL: avalie o lead (interesse, temperatura, objeções, prazo, "
+        "quem decide) e a condução da venda pela empresa (perguntou antes do preço? "
+        "mostrou valor? tratou a objeção? propôs próximo passo? cumpriu o que "
+        "prometeu?). Se a venda foi perdida ou esfriou, diga o motivo provável."
+    ),
+    "atendimento": (
+        "Análise de ATENDIMENTO: avalie a satisfação do contato, se o que ele pediu "
+        "foi resolvido, o tempo e o tom das respostas da empresa, e o que ainda está "
+        "pendente."
+    ),
+}
+
+FORMATO = """Formato da resposta (JSON):
+{
+  "resumo": "duas ou três frases sobre o que aconteceu e em que pé está",
+  "indicadores": {"rotulo": "valor curto", "...": "..."},
+  "porque": [{"texto": "o que você concluiu", "evidencia": "trecho curto da mensagem", "quando": "DD/MM HH:MM"}],
+  "oQueFaltou": ["o que a empresa deixou de fazer, comparando com o playbook quando houver"],
+  "proximoPasso": "a ação mais importante agora, concreta",
+  "sugestoes": [{"tipo": "etapa|etiqueta|tarefa|compromisso", "valor": "nome exato da etapa ou etiqueta da lista, ou título da tarefa/compromisso", "motivo": "por quê", "prazoDias": 0}]
+}
+Regras: até 6 indicadores; até 5 itens em "porque" e em "oQueFaltou"; até 4 sugestões.
+Sugestão de "etapa" e de "etiqueta" só com um nome que esteja nas listas da empresa.
+Sugestão de "tarefa" e "compromisso" só se o contato estiver no CRM (indicado abaixo).
+Se não houver nada a sugerir, devolva "sugestoes": []."""
+
+ROTULO_AUTOR = {"ia": "Empresa (agente de IA)", "bot": "Empresa (mensagem automática)"}
+ROTULO_MIDIA = {"audio": "[áudio]", "ptt": "[áudio]", "image": "[imagem]", "video": "[vídeo]", "document": "[documento]", "sticker": "[figurinha]"}
+TIPOS = ("etapa", "etiqueta", "tarefa", "compromisso")
+
+
+class AnaliseInvalida(ValueError):
+    pass
+
+
+def _quando(valor: Any) -> str:
+    try:
+        from datetime import datetime
+
+        return datetime.fromisoformat(str(valor).replace("Z", "+00:00")).astimezone(FUSO).strftime("%d/%m %H:%M")
+    except ValueError:
+        return "--/-- --:--"
+
+
+def _texto(valor: Any, teto: int) -> str:
+    return " ".join(str(valor or "").split())[:teto]
+
+
+def montar_prompt(carga: dict) -> str:
+    """A conversa e o contexto da empresa, para ir por stdin."""
+    tipo = carga.get("kind") if carga.get("kind") in FOCO else "comercial"
+    linhas = []
+    for m in carga.get("messages") or []:
+        if not isinstance(m, dict):
+            continue
+        autor = "Contato" if not m.get("fromMe") else ROTULO_AUTOR.get(m.get("authorKind"), "Empresa (equipe)")
+        texto = str(m.get("content") or "").strip()
+        midia = str(m.get("mediaType") or "").strip().lower()
+        if midia:
+            texto = (ROTULO_MIDIA.get(midia) or f"[{midia}]") + (f" {texto}" if texto else "")
+        if texto:
+            linhas.append(f"[{_quando(m.get('sentAt'))}] {autor}: {texto}")
+    partes = [FOCO[tipo], ""]
+    agente = carga.get("agent") if isinstance(carga.get("agent"), dict) else None
+    if agente:
+        partes.append(f"Agente que atende esta conversa: {_texto(agente.get('name'), 80)}. Jeito esperado: {_texto(agente.get('tone'), 300)}")
+    leitura = carga.get("reading") if isinstance(carga.get("reading"), dict) else {}
+    if leitura:
+        resumo = ", ".join(f"{k}={v.get('a')}" for k, v in leitura.items() if isinstance(v, dict) and v.get("a"))
+        partes.append(f"Leitura automática (Jev), para conferir e não para repetir: {resumo[:1500]}")
+    playbook = carga.get("playbook") if isinstance(carga.get("playbook"), dict) else None
+    if playbook:
+        partes.append("Playbook comercial da empresa (o que ela espera da conversa):\n" + json.dumps(playbook, ensure_ascii=False)[:6000])
+    partes.append("Etapas do funil da empresa: " + ", ".join(_texto(s, 80) for s in (carga.get("stages") or [])[:20]))
+    partes.append("Etiquetas da empresa: " + ", ".join(_texto(t, 80) for t in (carga.get("tags") or [])[:40]))
+    partes.append("O contato está no CRM: " + ("sim" if carga.get("hasContact") else "não"))
+    partes.append("")
+    partes.append(FORMATO)
+    partes.append("")
+    partes.append("Conversa:")
+    partes.append("\n".join(linhas)[-60000:])
+    return "\n".join(partes)
+
+
+def _json_do_texto(texto: str) -> Any:
+    bruto = str(texto or "").strip()
+    bruto = re.sub(r"^```(?:json)?\s*|\s*```$", "", bruto)
+    inicio, fim = bruto.find("{"), bruto.rfind("}")
+    if inicio < 0 or fim <= inicio:
+        raise AnaliseInvalida("sem objeto JSON")
+    try:
+        return json.loads(bruto[inicio:fim + 1])
+    except ValueError as exc:
+        raise AnaliseInvalida("JSON inválido") from exc
+
+
+def ler_resultado(texto: str, carga: dict) -> dict:
+    """O JSON do Claude, conferido e aparado, no formato que o banco guarda."""
+    dados = _json_do_texto(texto)
+    if not isinstance(dados, dict):
+        raise AnaliseInvalida("resposta não é objeto")
+    resumo = _texto(dados.get("resumo"), 600)
+    if not resumo:
+        raise AnaliseInvalida("sem resumo")
+    indicadores = {}
+    if isinstance(dados.get("indicadores"), dict):
+        for chave, valor in list(dados["indicadores"].items())[:6]:
+            rotulo, conteudo = _texto(chave, 40), _texto(valor if not isinstance(valor, list) else ", ".join(map(str, valor)), 120)
+            if rotulo and conteudo:
+                indicadores[rotulo] = conteudo
+    porque = []
+    for item in (dados.get("porque") or [])[:5]:
+        if isinstance(item, dict) and _texto(item.get("texto"), 300):
+            porque.append({
+                "texto": _texto(item.get("texto"), 300),
+                "evidencia": _texto(item.get("evidencia"), 240),
+                "quando": _texto(item.get("quando"), 20),
+            })
+    faltou = [_texto(item, 240) for item in (dados.get("oQueFaltou") or [])[:5] if _texto(item, 240)]
+    etapas = {str(s).casefold(): str(s) for s in carga.get("stages") or []}
+    etiquetas = {str(t).casefold(): str(t) for t in carga.get("tags") or []}
+    sugestoes = []
+    for item in (dados.get("sugestoes") or [])[:6]:
+        if not isinstance(item, dict) or item.get("tipo") not in TIPOS:
+            continue
+        valor = _texto(item.get("valor"), 120)
+        if not valor:
+            continue
+        # Etapa e etiqueta só com nome que existe na empresa: é o que deixa o
+        # "Aplicar" do portal encontrar o alvo sem adivinhar.
+        if item["tipo"] == "etapa":
+            if valor.casefold() not in etapas:
+                continue
+            valor = etapas[valor.casefold()]
+        if item["tipo"] == "etiqueta" and valor.casefold() in etiquetas:
+            valor = etiquetas[valor.casefold()]
+        if item["tipo"] in ("tarefa", "compromisso") and not carga.get("hasContact"):
+            continue
+        try:
+            prazo = max(0, min(30, int(item.get("prazoDias") or 0)))
+        except (TypeError, ValueError):
+            prazo = 0
+        sugestoes.append({"tipo": item["tipo"], "valor": valor, "motivo": _texto(item.get("motivo"), 200), "prazoDias": prazo})
+        if len(sugestoes) == 4:
+            break
+    return {
+        "resumo": resumo,
+        "indicadores": indicadores,
+        "porque": porque,
+        "oQueFaltou": faltou,
+        "proximoPasso": _texto(dados.get("proximoPasso"), 400),
+        "sugestoes": sugestoes,
+    }
+
+
+def conta_logada(pasta: Optional[Path]) -> bool:
+    return bool(pasta) and (Path(pasta) / ".credentials.json").is_file()
+
+
+class Analista:
+    def __init__(
+        self,
+        *,
+        verifier,
+        executar: Callable[..., Any],
+        claude_bin: str,
+        vault: Path,
+        config_dir: Optional[Path],
+        modelo: Optional[str] = None,
+        timeout: int = TIMEOUT,
+    ) -> None:
+        self.verifier = verifier
+        self.executar = executar
+        self.claude_bin = claude_bin
+        self.vault = Path(vault)
+        self.config_dir = Path(config_dir) if config_dir else None
+        self.modelo = modelo
+        self.timeout = timeout
+        self.fila: "queue.Queue[Optional[dict]]" = queue.Queue(maxsize=50)
+        self._thread: Optional[threading.Thread] = None
+
+    # ------------------------------------------------------------ a fila
+
+    def submit(self, carga: dict) -> bool:
+        try:
+            self.fila.put_nowait(carga)
+            return True
+        except queue.Full:
+            self._gravar(carga.get("analysisId"), "failed", erro="analysis_queue_full")
+            return False
+
+    def start(self) -> None:
+        if self._thread and self._thread.is_alive():
+            return
+        self._thread = threading.Thread(target=self._run, name="analista", daemon=True)
+        self._thread.start()
+
+    def stop(self) -> None:
+        self.fila.put(None)
+        if self._thread:
+            self._thread.join(timeout=5)
+
+    def _run(self) -> None:
+        while True:
+            carga = self.fila.get()
+            if carga is None:
+                return
+            try:
+                self.analisar(carga)
+            except Exception as exc:  # pragma: no cover - última barreira de um daemon
+                audit.log("analysis.failed", error_code="unexpected", error=type(exc).__name__)
+                self._gravar(carga.get("analysisId"), "failed", erro="unexpected")
+
+    # ------------------------------------------------------------ uma análise
+
+    def analisar(self, carga: dict) -> str:
+        import runner
+
+        analise = str(carga.get("analysisId") or "")
+        if not analise:
+            return "failed"
+        if not conta_logada(self.config_dir):
+            self._gravar(analise, "failed", erro="analysis_account_missing")
+            audit.log("analysis.failed", analysis_id=analise, error_code="analysis_account_missing")
+            return "failed"
+        self._gravar(analise, "running")
+        inicio = time.monotonic()
+        try:
+            resposta = self.executar(
+                montar_prompt(carga),
+                self.claude_bin,
+                self.vault,
+                self.timeout,
+                model=self.modelo,
+                tools=[],
+                include_vault=False,
+                no_session_persistence=True,
+                system_prompt=SISTEMA,
+                claude_config_dir=self.config_dir,
+            )
+            resultado = ler_resultado(getattr(resposta, "reply", ""), carga)
+        except runner.RunnerError as exc:
+            self._gravar(analise, "failed", erro=exc.code)
+            audit.log("analysis.failed", analysis_id=analise, error_code=exc.code)
+            return "failed"
+        except AnaliseInvalida:
+            self._gravar(analise, "failed", erro="analysis_invalid_response")
+            audit.log("analysis.failed", analysis_id=analise, error_code="analysis_invalid_response")
+            return "failed"
+        ms = int((time.monotonic() - inicio) * 1000)
+        self._gravar(analise, "done", resultado=resultado, ms=ms)
+        audit.log("analysis.done", analysis_id=analise, kind=carga.get("kind"), latency_ms=ms,
+                  suggestions=len(resultado["sugestoes"]))
+        return "done"
+
+    def _gravar(self, analise: Any, situacao: str, *, erro: str = "", resultado: Optional[dict] = None, ms: int = 0) -> None:
+        if not analise:
+            return
+        payload = {"analysisId": str(analise), "status": situacao}
+        if erro:
+            payload["errorCode"] = erro
+        if resultado is not None:
+            payload["result"] = resultado
+        if self.modelo:
+            payload["model"] = str(self.modelo)[:80]
+        if ms:
+            payload["latencyMs"] = ms
+        try:
+            self.verifier.analysis_record(payload)
+        except OperatorVerificationError as exc:
+            audit.log("analysis.record_failed", analysis_id=str(analise), status=situacao, error=str(exc))
