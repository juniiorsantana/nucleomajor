diff --git a/whatsapp-assistant/test_analista.py b/whatsapp-assistant/test_analista.py
new file mode 100644
index 0000000..1bb0db4
--- /dev/null
+++ b/whatsapp-assistant/test_analista.py
@@ -0,0 +1,198 @@
+"""O Agente Analista: a análise do botão "Analisar conversa".
+
+O que estes testes prendem:
+  * o prompt leva a conversa, o foco do tipo, o jeito do agente, a leitura do
+    Jev, o playbook, o funil e as etiquetas — e a resposta volta conferida:
+    etapa só se existir na empresa, tarefa só com contato no CRM, tetos;
+  * sem a conta de análise logada, falha com motivo e não chama o Claude;
+  * erro do Claude e resposta torta viram falha (o banco devolve o crédito);
+  * o executor de comandos entrega à fila e libera o comando na hora.
+"""
+
+import inspect
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import analista
+import runner
+from config import Config
+
+CARGA = {
+    "analysisId": "8d0f6f6e-3c8b-4c86-8c3b-0d8c2a7f0001",
+    "kind": "comercial",
+    "messages": [
+        {"sentAt": "2026-10-01T12:00:00Z", "fromMe": False, "authorKind": "", "content": "Quanto custa o site?"},
+        {"sentAt": "2026-10-01T12:05:00Z", "fromMe": True, "authorKind": "ia", "content": "Depende do escopo. Para qual negócio é?"},
+        {"sentAt": "2026-10-01T12:06:00Z", "fromMe": False, "mediaType": "audio", "content": ""},
+    ],
+    "reading": {"temperatura": {"a": "morno", "p": 0.7}, "objecao_principal": {"a": "preco", "p": 0.8}},
+    "playbook": {"objecoes": [{"chave": "preco", "nome": "Preço", "resposta": "fazer o recorte"}]},
+    "agent": {"name": "Assistente Major", "tone": "direto e consultivo"},
+    "stages": ["Lead", "Em contato", "Negociação"],
+    "tags": ["Lead quente", "Cliente"],
+    "hasContact": True,
+}
+
+
+def resposta(**sobrepor):
+    dados = {
+        "resumo": "Lead morno, perguntou preço de site e foi ao áudio.",
+        "indicadores": {"Temperatura": "Morna", "Objeção": ["Preço"]},
+        "porque": [{"texto": "Perguntou preço antes de contar o negócio", "evidencia": "Quanto custa o site?", "quando": "01/10 09:00"}],
+        "oQueFaltou": ["Não ofereceu a conversa de diagnóstico"],
+        "proximoPasso": "Ouvir o áudio e propor a conversa de diagnóstico com dois horários.",
+        "sugestoes": [
+            {"tipo": "etapa", "valor": "em contato", "motivo": "já conversou", "prazoDias": 0},
+            {"tipo": "etapa", "valor": "Etapa que não existe", "motivo": "x"},
+            {"tipo": "etiqueta", "valor": "lead quente", "motivo": "interesse"},
+            {"tipo": "tarefa", "valor": "Ouvir o áudio", "motivo": "pendente", "prazoDias": 99},
+            {"tipo": "compromisso", "valor": "Diagnóstico", "motivo": "próximo passo", "prazoDias": 2},
+        ],
+    }
+    dados.update(sobrepor)
+    return dados
+
+
+class PromptTests(unittest.TestCase):
+    def test_leva_conversa_e_contexto_da_empresa(self):
+        prompt = analista.montar_prompt(CARGA)
+        self.assertIn("Análise COMERCIAL", prompt)
+        self.assertIn("[01/10 09:00] Contato: Quanto custa o site?", prompt)
+        self.assertIn("Empresa (agente de IA): Depende do escopo", prompt)
+        self.assertIn("Contato: [áudio]", prompt)
+        self.assertIn("direto e consultivo", prompt)
+        self.assertIn("temperatura=morno", prompt)
+        self.assertIn('"chave": "preco"', prompt)
+        self.assertIn("Etapas do funil da empresa: Lead, Em contato, Negociação", prompt)
+        self.assertIn("O contato está no CRM: sim", prompt)
+
+    def test_tipo_atendimento_e_tipo_desconhecido(self):
+        self.assertIn("Análise de ATENDIMENTO", analista.montar_prompt({**CARGA, "kind": "atendimento"}))
+        self.assertIn("Análise COMERCIAL", analista.montar_prompt({**CARGA, "kind": "outro"}))
+
+
+class ResultadoTests(unittest.TestCase):
+    def test_confere_e_apara(self):
+        r = analista.ler_resultado("```json\n" + json.dumps(resposta()) + "\n```", CARGA)
+        self.assertTrue(r["resumo"].startswith("Lead morno"))
+        self.assertEqual(r["indicadores"], {"Temperatura": "Morna", "Objeção": "Preço"})
+        self.assertEqual(r["porque"][0]["evidencia"], "Quanto custa o site?")
+        tipos = [(s["tipo"], s["valor"]) for s in r["sugestoes"]]
+        # Etapa inexistente sai; nomes voltam com a grafia da empresa; teto de 4.
+        self.assertEqual(tipos, [("etapa", "Em contato"), ("etiqueta", "Lead quente"), ("tarefa", "Ouvir o áudio"), ("compromisso", "Diagnóstico")])
+        self.assertEqual(r["sugestoes"][2]["prazoDias"], 30)
+
+    def test_sem_contato_tarefa_e_compromisso_saem(self):
+        r = analista.ler_resultado(json.dumps(resposta()), {**CARGA, "hasContact": False})
+        self.assertEqual([s["tipo"] for s in r["sugestoes"]], ["etapa", "etiqueta"])
+
+    def test_resposta_torta_e_recusada(self):
+        for texto in ("não é json", "[]", json.dumps({"resumo": ""}), "{quebrado"):
+            with self.assertRaises(analista.AnaliseInvalida):
+                analista.ler_resultado(texto, CARGA)
+
+    def test_cabe_no_banco(self):
+        grande = resposta(resumo="x" * 5000, porque=[{"texto": "y" * 900, "evidencia": "z" * 900}] * 9, oQueFaltou=["w" * 900] * 9)
+        r = analista.ler_resultado(json.dumps(grande), CARGA)
+        self.assertLessEqual(len(json.dumps(r, ensure_ascii=False).encode("utf-8")), 32768)
+        self.assertEqual(len(r["porque"]), 5)
+
+
+class FakeVerifier:
+    def __init__(self):
+        self.gravadas = []
+
+    def analysis_record(self, payload):
+        self.gravadas.append(payload)
+        return {"recorded": True}
+
+
+class AnalistaTests(unittest.TestCase):
+    def setUp(self):
+        self.pasta = tempfile.TemporaryDirectory()
+        self.addCleanup(self.pasta.cleanup)
+        self.conta = Path(self.pasta.name) / "analise"
+        self.conta.mkdir()
+        (self.conta / ".credentials.json").write_text("{}", encoding="utf-8")
+        patcher = patch.object(analista.audit, "log")
+        self.log = patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def novo(self, executar, conta=None):
+        self.verifier = FakeVerifier()
+        return analista.Analista(
+            verifier=self.verifier, executar=executar, claude_bin="claude",
+            vault=Path(self.pasta.name), config_dir=conta if conta is not None else self.conta, modelo="sonnet",
+        )
+
+    def test_sem_conta_logada_falha_sem_chamar_o_claude(self):
+        chamadas = []
+        a = self.novo(lambda *a, **k: chamadas.append(1), conta=Path(self.pasta.name) / "nao-existe")
+        self.assertEqual(a.analisar(CARGA), "failed")
+        self.assertEqual(chamadas, [])
+        self.assertEqual(self.verifier.gravadas[-1]["errorCode"], "analysis_account_missing")
+
+    def test_analisa_com_a_conta_de_analise_sem_ferramentas(self):
+        recebido = {}
+
+        def executar(prompt, claude_bin, vault, timeout, **kwargs):
+            recebido.update(kwargs, prompt=prompt)
+            return runner.RunResult(reply=json.dumps(resposta()), session_id=None, exit_code=0, duration_ms=10, tools_used=[])
+
+        a = self.novo(executar)
+        self.assertEqual(a.analisar(CARGA), "done")
+        self.assertEqual(recebido["claude_config_dir"], self.conta)
+        self.assertEqual(recebido["tools"], [])
+        self.assertFalse(recebido["include_vault"])
+        self.assertTrue(recebido["no_session_persistence"])
+        self.assertEqual(recebido["system_prompt"], analista.SISTEMA)
+        self.assertEqual([g["status"] for g in self.verifier.gravadas], ["running", "done"])
+        self.assertEqual(self.verifier.gravadas[-1]["result"]["sugestoes"][0]["valor"], "Em contato")
+        bruto = json.dumps([c.kwargs for c in self.log.call_args_list], ensure_ascii=False, default=str)
+        self.assertNotIn("Quanto custa", bruto)
+
+    def test_erro_do_claude_e_resposta_torta_viram_falha(self):
+        def limite(*a, **k):
+            raise runner.RunnerError("limite", code="model_quota_exhausted")
+
+        a = self.novo(limite)
+        self.assertEqual(a.analisar(CARGA), "failed")
+        self.assertEqual(self.verifier.gravadas[-1]["errorCode"], "model_quota_exhausted")
+        a = self.novo(lambda *x, **k: runner.RunResult(reply="desculpe", session_id=None, exit_code=0, duration_ms=1, tools_used=[]))
+        a.analisar(CARGA)
+        self.assertEqual(self.verifier.gravadas[-1]["errorCode"], "analysis_invalid_response")
+
+    def test_fila_cheia_falha_na_hora(self):
+        a = self.novo(lambda *x, **k: None)
+        for _ in range(50):
+            self.assertTrue(a.submit(dict(CARGA)))
+        self.assertFalse(a.submit(dict(CARGA)))
+        self.assertEqual(self.verifier.gravadas[-1]["errorCode"], "analysis_queue_full")
+
