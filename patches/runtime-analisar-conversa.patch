+class AnaliseDaConversaTests(Bancada, unittest.TestCase):
+    """O botão "Analisar conversa": o comando entrega à fila e libera na hora."""
+
+    ANALISE = "8d0f6f6e-3c8b-4c86-8c3b-0d8c2a7f0001"
+
+    def _montar(self):
+        directory, poller, verifier, _control, arbitro = self._runtime(
+            self._comando_de_conversa("conversation_analyze", {"analysisId": self.ANALISE, "kind": "comercial"})
+        )
+        self.addCleanup(directory.cleanup)
+        self.addCleanup(arbitro.close)
+        verifier.analises = []
+        verifier.analysis_record = lambda payload: verifier.analises.append(payload) or {"recorded": True}
+        return poller, verifier
+
+    def test_sem_analista_falha_e_devolve_o_credito(self):
+        poller, verifier = self._montar()
+        poller.poll_once()
+        self.assertEqual(verifier.completed[0][1:3], ("failed", "analysis_disabled"))
+        self.assertEqual(verifier.analises, [{"analysisId": self.ANALISE, "status": "failed", "errorCode": "analysis_disabled"}])
+
+    def test_entrega_a_fila_e_libera_o_comando(self):
+        class Analista:
+            def __init__(self, aceita):
+                self.aceita = aceita
+                self.cargas = []
+
+            def submit(self, carga):
+                self.cargas.append(carga)
+                return self.aceita
+
+        poller, verifier = self._montar()
+        poller.analista = Analista(True)
+        with mock.patch("runtime_commands.audit.log"):
+            poller.poll_once()
+        self.assertEqual(verifier.completed[0][1:4], ("completed", "", {"queued": True}))
+        self.assertEqual(poller.analista.cargas[0]["analysisId"], self.ANALISE)
+
+        poller, verifier = self._montar()
+        poller.analista = Analista(False)
+        poller.poll_once()
+        self.assertEqual(verifier.completed[0][1:3], ("failed", "analysis_queue_full"))
