+        store.close()
+
+        self.registry = ConnectionRegistry(self.raiz / "connections.json")
+        self.registry.register(Connection(
+            connection_id=CONN,
+            organization_id=ORG,
+            name="WhatsApp principal",
+            internal_base_url="http://127.0.0.1:8100/api/internal/v1",
+            store_dir=str(self.raiz / "store"),
