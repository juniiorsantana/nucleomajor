+    def mensagem(self, identificador, *, jid=CLIENTE, quando=instante(2), minha=False,
+                 tipo="audio", arquivo="audio_x.ogg", com_chaves=True, tamanho=1024):
+        db = sqlite3.connect(self.banco)
+        db.execute(
+            "INSERT OR REPLACE INTO chats (jid, name, last_message_time) VALUES (?, ?, ?)",
+            (jid, "Marina", quando),
+        )
+        db.execute(
+            "INSERT OR REPLACE INTO messages (id, chat_jid, sender, content, timestamp,"
+            " is_from_me, media_type, filename, url, media_key, file_sha256, file_length)"
+            " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+            (identificador, jid, "5511987654321", "", quando, 1 if minha else 0, tipo, arquivo,
+             "https://mmg.whatsapp.net/x.enc" if com_chaves else "",
+             b"chave" if com_chaves else b"", b"sha", tamanho),
+        )
+        db.commit()
+        db.close()
