+"""O arquivo da mídia sobe para o bucket, um ciclo depois da mensagem.
+
+O que estes testes prendem: o caminho do objeto (organização, conexão, chat e
+id — nunca a chave nem a URL do CDN), o orçamento por ciclo, a desistência
+depois de três falhas, e a regra de o mesmo id nunca aparecer duas vezes no
+mesmo lote. E a poda: uma vez por dia, só o que passou de 90 dias.
+"""
+
+import sqlite3
+import tempfile
+import unittest
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from unittest import mock
+
+import media
+from arbitro import Arbitro
+from connections import Connection, ConnectionRegistry
+from conversation_sync import ConversationSync
+from media_mirror import BUCKET, MediaMirror, ORCAMENTO_POR_CICLO
+from operator_verification import OperatorVerificationError
+from test_conversation_sync import CLIENTE, CONN, ORG, SCHEMA, SCHEMA_STORE, instante
+
+
+class FakeVerifier:
+    def __init__(self):
+        self.lotes = []
+        self.uploads = []
+        self.listagens = []
+        self.removidos = []
+        self.falhar_upload = 0
+        self.pastas = []
+        self.objetos = {}
+
+    def conversation_sync(self, payload):
+        self.lotes.append(payload)
+        return {"accepted": True}
+
+    def storage_upload(self, bucket, path, data, content_type):
+        if self.falhar_upload > 0:
+            self.falhar_upload -= 1
+            raise OperatorVerificationError("Supabase recusou envio de mídia ao Storage (HTTP 500)")
+        self.uploads.append((bucket, path, bytes(data), content_type))
+
+    def storage_list(self, bucket, prefix, limit=1000, offset=0):
+        self.listagens.append(prefix)
+        if prefix.count("/") == 1:
+            return [{"name": pasta, "id": None} for pasta in self.pastas]
+        return self.objetos.get(prefix, [])[offset : offset + limit]
+
+    def storage_delete(self, bucket, paths):
+        self.removidos.extend(paths)
+
+
