@@ -0,0 +1,368 @@
+"""O arquivo da mídia recebida, do Bridge para o Storage do plano de controle.
+
+Até 16/09/2026 o espelho subia de uma mídia só o rótulo — "sem bytes, sem
+chave, sem URL" —, e a tela dizia "🎤 Áudio" sem ninguém conseguir ouvir. A
+decisão do dono, em 15/09/2026, foi guardar o arquivo com prazo: bucket
+PRIVADO, lido só por membro da organização com URL assinada, apagado com a
+mesma janela de 90 dias das mensagens.
+
+O caminho continua o mesmo de sempre: o Bridge é quem fala com o WhatsApp
+(`/api/download` baixa e decripta para o disco da VPS), e este módulo só leva
+o arquivo dali para `<org>/<conexão>/<chat>/<id>.<ext>` no bucket, com a
+credencial do robô. A chave da mídia e a URL do CDN nunca saem do Bridge.
+
+Três limites, e por quê:
+
+  * ORÇAMENTO POR CICLO. Baixar e subir um arquivo custa segundos, e a
+    sincronia roda a cada quinze. Um lote antigo de cem fotos não pode segurar
+    a lista de conversas por minutos; sobe aos poucos, e o texto da mensagem já
+    está no espelho desde o primeiro ciclo — o arquivo chega uma sincronia
+    depois, e a RPC preenche `media_path` sobre valor vazio.
+  * TENTATIVAS. Uma mídia que o WhatsApp já expirou (o CDN some depois de um
+    tempo) falha sempre; insistir para sempre seria trabalho perpétuo. Três
+    tentativas espaçadas e a mensagem fica só com o rótulo, como antes.
+  * TETO DE TAMANHO. O bucket recusa acima de 16 MB, e conferir o tamanho que
+    o Bridge já conhece (`file_length`) evita baixar o que não vai subir.
+
+Falhar aqui nunca derruba a sincronia. O pior desfecho é o de ontem: a bolha
+com rótulo e sem arquivo.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import sqlite3
+import time
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from typing import Any, Callable, Optional
+
+import audit
+import media
+from operator_verification import OperatorVerificationError
+
+BUCKET = "whatsapp-media"
+
+# O que ganha arquivo. Documento, vídeo e figurinha continuam como rótulo —
+# decisão de escopo de 15/09/2026, não limitação técnica.
+TIPOS_COM_ARQUIVO = frozenset({"audio", "ptt", "image"})
+
+ORCAMENTO_POR_CICLO = 4
+TETO_BYTES = 16 * 1024 * 1024
+TENTATIVAS = 3
+ESPERA_ENTRE_TENTATIVAS = 300.0
+
+# Quantas mensagens já publicadas o estado lembra. Serve só para não subir a
+# mesma mídia duas vezes quando a marca d'água recua; acima disto, o pior caso
+# é um upload repetido, que o `x-upsert` engole.
+LIMITE_DE_PUBLICADAS = 3000
+
+# O que o bucket aceita, pela extensão que o Bridge dá ao arquivo.
+MIME_POR_EXTENSAO = {
+    "ogg": "audio/ogg",
+    "opus": "audio/ogg",
+    "mp3": "audio/mpeg",
+    "m4a": "audio/mp4",
+    "mp4": "audio/mp4",
+    "aac": "audio/aac",
+    "wav": "audio/wav",
+    "jpg": "image/jpeg",
+    "jpeg": "image/jpeg",
+    "png": "image/png",
+    "webp": "image/webp",
+}
+
+# A janela do espelho, e portanto a do bucket.
+RETENCAO_DIAS = 90
+INTERVALO_DA_PODA = 24 * 3600.0
+# Tetos de uma passada de poda. O resto fica para amanhã.
+PODA_MAX_PASTAS = 300
+PODA_MAX_OBJETOS = 2000
+
+SQL_LINHA = """
+SELECT id, chat_jid, content, timestamp, is_from_me, media_type, filename, file_length,
+       (COALESCE(url, '') <> '' AND COALESCE(LENGTH(media_key), 0) > 0) AS tem_arquivo
+FROM messages
+WHERE id = ? AND chat_jid = ?
+"""
+
+
+def _extensao(nome: str) -> str:
+    return str(nome or "").rsplit(".", 1)[-1].lower() if "." in str(nome or "") else ""
+
+
+def _seguro(texto: str, limite: int) -> str:
+    return re.sub(r"[^A-Za-z0-9_-]", "", str(texto or ""))[:limite]
+
+
+class MediaMirror:
+    def __init__(
+        self,
+        *,
+        verifier,
+        api_base_url: str,
+        token_loader: Callable[[], Optional[str]],
+        state_path: Path,
+        orcamento: int = ORCAMENTO_POR_CICLO,
+        relogio: Callable[[], float] = time.time,
+    ) -> None:
+        self.verifier = verifier
+        self.api_base_url = str(api_base_url or "").rstrip("/")
+        self.token_loader = token_loader
+        self.state_path = Path(state_path)
+        self.orcamento = max(1, int(orcamento))
+        self._relogio = relogio
+        # id da mensagem → o que falta para publicá-la.
+        self._pendentes: dict[str, dict[str, Any]] = {}
+        # id da mensagem → caminho no bucket.
+        self._publicadas: dict[str, str] = {}
+        self._podado_em = 0.0
+        self._carregar()
+
+    # ------------------------------------------------------------- estado
+
+    def _carregar(self) -> None:
+        try:
+            dados = json.loads(self.state_path.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            return
+        if not isinstance(dados, dict):
+            return
+        pendentes = dados.get("pendentes")
+        if isinstance(pendentes, dict):
+            self._pendentes = {
+                str(chave): dict(valor) for chave, valor in pendentes.items() if isinstance(valor, dict)
+            }
+        publicadas = dados.get("publicadas")
+        if isinstance(publicadas, dict):
+            self._publicadas = {str(chave): str(valor) for chave, valor in publicadas.items()}
+        try:
+            self._podado_em = float(dados.get("podadoEm") or 0.0)
+        except (TypeError, ValueError):
+            self._podado_em = 0.0
+
+    def _salvar(self) -> None:
+        if len(self._publicadas) > LIMITE_DE_PUBLICADAS:
+            excedente = len(self._publicadas) - LIMITE_DE_PUBLICADAS
+            for chave in list(self._publicadas)[:excedente]:
+                del self._publicadas[chave]
+        temporario = self.state_path.with_suffix(".tmp")
+        try:
+            temporario.write_text(
+                json.dumps(
+                    {
+                        "pendentes": self._pendentes,
+                        "publicadas": self._publicadas,
+                        "podadoEm": self._podado_em,
+                    },
+                    ensure_ascii=False,
+                ),
+                encoding="utf-8",
+            )
+            os.replace(temporario, self.state_path)
+        except OSError as exc:  # pragma: no cover - disco cheio ou permissão
+            audit.log("media.mirror_state_failed", error_code="state_write", error=str(exc))
+
+    # ------------------------------------------------------------ entrada
+
+    @staticmethod
+    def _candidata(linha) -> bool:
+        """Só o que tem arquivo para baixar. Saída digitada no celular chega
+        sem `url`/`media_key` (o Bridge não guarda o que ele mesmo mandou), e
+        fica como rótulo — como antes."""
+        tipo = str(linha["media_type"] or "").strip().lower()
+        if tipo not in TIPOS_COM_ARQUIVO:
+            return False
+        return "tem_arquivo" not in linha.keys() or bool(linha["tem_arquivo"])
+
+    def anotar(self, linhas) -> None:
+        """As linhas do Bridge deste ciclo que ainda precisam de arquivo."""
+        for linha in linhas:
+            if not self._candidata(linha):
+                continue
+            identificador = str(linha["id"] or "").strip()
+            if not identificador or identificador in self._publicadas or identificador in self._pendentes:
+                continue
+            self._pendentes[identificador] = {
+                "chat": str(linha["chat_jid"] or ""),
+                "tentativas": 0,
+                "proxima": 0.0,
+            }
+
+    # ----------------------------------------------------------- espelho
+
+    def espelhar(
+        self,
+        banco: sqlite3.Connection,
+        construir_item: Callable[[Any], Optional[dict]],
+        connection,
+    ) -> list[dict]:
+        """Publica até `orcamento` pendentes e devolve os itens para reoferecer
+        à RPC, já com `mediaPath` e `mediaMime`.
+
+        `construir_item` é o mesmo tradutor de linha da sincronia, para o item
+        reoferecido ser idêntico ao que subiu antes — a RPC só preenche o que
+        estava vazio, e um item diferente não mudaria nada mesmo. `connection`
+        é a conexão registrada que a sincronia resolveu: organização e conexão
+        do caminho saem dela, nunca de um campo do payload.
+        """
+        prefixo = _prefixo(connection)
+        if not prefixo:
+            return []
+        agora = self._relogio()
+        # As mais NOVAS primeiro. A entrada segue a ordem do Bridge (timestamp
+        # crescente), então o fim do dicionário é o presente — e é o áudio que
+        # o cliente acabou de mandar que a equipe está esperando ouvir, não a
+        # foto de grupo de anteontem que entrou na fila quando a marca d'água
+        # recuou. O que ficou para trás sobe nos ciclos seguintes.
+        prontos = [
+            chave
+            for chave, valor in reversed(list(self._pendentes.items()))
+            if float(valor.get("proxima") or 0.0) <= agora
+        ][: self.orcamento]
+        if not prontos:
+            return []
+
+        saida = []
+        for identificador in prontos:
+            pendente = self._pendentes[identificador]
+            linha = banco.execute(SQL_LINHA, (identificador, pendente.get("chat", ""))).fetchone()
+            item = construir_item(linha) if linha is not None else None
+            if item is None:
+                # A linha sumiu do Bridge ou a conversa não sobe: nada a fazer.
+                del self._pendentes[identificador]
+                continue
+            try:
+                caminho, mime = self._publicar(linha, item["phone"], prefixo)
+            except (media.MediaError, OperatorVerificationError, OSError, ValueError) as exc:
+                self._falhou(identificador, pendente, exc, agora)
+                continue
+            del self._pendentes[identificador]
+            self._publicadas[identificador] = caminho
+            item["mediaPath"] = caminho
+            item["mediaMime"] = mime
+            saida.append(item)
+        self._salvar()
+        return saida
+
+    def _falhou(self, identificador: str, pendente: dict, exc: Exception, agora: float) -> None:
+        tentativas = int(pendente.get("tentativas") or 0) + 1
+        # Só o tipo do erro vai para o log: a mensagem pode carregar o caminho
+        # do arquivo, e o caminho carrega o telefone.
+        if tentativas >= TENTATIVAS or isinstance(exc, ValueError):
+            del self._pendentes[identificador]
+            audit.log("media.mirror_abandoned", error_code=type(exc).__name__, attempts=tentativas)
+            return
+        pendente["tentativas"] = tentativas
+        pendente["proxima"] = agora + ESPERA_ENTRE_TENTATIVAS
+        audit.log("media.mirror_failed", error_code=type(exc).__name__, attempts=tentativas)
+
+    def _publicar(self, linha, chat: str, prefixo: str) -> tuple[str, str]:
+        tamanho = int(linha["file_length"] or 0) if "file_length" in linha.keys() else 0
+        if tamanho > TETO_BYTES:
+            raise ValueError("mídia acima do teto do bucket")
+        extensao = _extensao(linha["filename"])
+        mime = MIME_POR_EXTENSAO.get(extensao)
+        if not mime:
+            raise ValueError("extensão sem tipo conhecido")
+
+        token = self.token_loader() or ""
+        local = media.download_media(
+            self.api_base_url, token, str(linha["id"]), str(linha["chat_jid"])
+        )
+        caminho_local = Path(local)
+        if caminho_local.stat().st_size > TETO_BYTES:
+            raise ValueError("mídia acima do teto do bucket")
+        dados = caminho_local.read_bytes()
+
+        identificador = _seguro(linha["id"], 96)
+        pasta = re.sub(r"[^0-9-]", "", str(chat or ""))[:40]
+        if not identificador or not pasta:
+            raise ValueError("caminho do objeto incompleto")
+        caminho = f"{prefixo}/{pasta}/{identificador}.{extensao}"
+        self.verifier.storage_upload(BUCKET, caminho, dados, mime)
+
+        # O arquivo já vive no bucket; a cópia local só ocuparia disco. Se a
+        # transcrição para a IA precisar dele de novo, o Bridge baixa outra vez.
+        try:
+            caminho_local.unlink()
+        except OSError:
+            pass
+        return caminho, mime
+
+    # --------------------------------------------------------------- poda
+
+    def podar(self, connection) -> int:
+        """Apaga do bucket o que passou da janela. Uma vez por dia, por pastas.
+
+        A listagem do Storage é por nível: primeiro as pastas de chat desta
+        conexão, depois os arquivos de cada uma, com `created_at`. Nada aqui
+        depende do espelho de mensagens — um arquivo cuja mensagem já foi
+        podada também some, e um órfão de upload interrompido também.
+        """
+        agora = self._relogio()
+        if agora - self._podado_em < INTERVALO_DA_PODA:
+            return 0
+        prefixo = _prefixo(connection)
+        if not prefixo:
+            return 0
+        self._podado_em = agora
+        self._salvar()
+
+        corte = datetime.now(timezone.utc) - timedelta(days=RETENCAO_DIAS)
+        apagados = 0
+        try:
+            pastas = self.verifier.storage_list(BUCKET, prefixo, limit=PODA_MAX_PASTAS)
+            for pasta in pastas:
+                nome = str(pasta.get("name") or "").strip("/")
+                if not nome or pasta.get("id"):
+                    continue
+                vencidos = []
+                deslocamento = 0
+                while len(vencidos) < PODA_MAX_OBJETOS:
+                    pagina = self.verifier.storage_list(
+                        BUCKET, f"{prefixo}/{nome}", limit=1000, offset=deslocamento
+                    )
+                    for objeto in pagina:
+                        if not objeto.get("id"):
+                            continue
+                        quando = _instante(objeto.get("created_at"))
+                        if quando is not None and quando < corte:
+                            vencidos.append(f"{prefixo}/{nome}/{objeto.get('name')}")
+                    if len(pagina) < 1000:
+                        break
+                    deslocamento += 1000
+                for inicio in range(0, len(vencidos), 100):
+                    self.verifier.storage_delete(BUCKET, vencidos[inicio : inicio + 100])
+                apagados += len(vencidos)
+                if apagados >= PODA_MAX_OBJETOS:
+                    break
+        except OperatorVerificationError as exc:
+            audit.log("media.prune_failed", error_code="storage", error=str(exc)[:120])
+        if apagados:
+            audit.log("media.pruned", count=apagados)
+        return apagados
+
+
+def _prefixo(connection) -> str:
+    """`<org>/<conexão>`, ou vazio quando a conexão não tem os dois ids."""
+    organizacao = str(getattr(connection, "organization_id", "") or "").strip()
+    conexao = str(getattr(connection, "connection_id", "") or "").strip()
+    if not re.fullmatch(r"[0-9a-fA-F-]{36}", organizacao) or not re.fullmatch(r"[0-9a-fA-F-]{36}", conexao):
+        return ""
+    return f"{organizacao}/{conexao}"
+
+
+def _instante(valor: Any) -> Optional[datetime]:
+    texto = str(valor or "").strip()
+    if not texto:
+        return None
+    try:
+        quando = datetime.fromisoformat(texto.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    if quando.tzinfo is None:
+        quando = quando.replace(tzinfo=timezone.utc)
+    return quando
