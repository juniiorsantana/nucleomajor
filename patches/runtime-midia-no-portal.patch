+// Com anexo o texto vira legenda: pode faltar, mas o que vier continua
+// passando pelas mesmas regras (teto, NUL).
+func TestValidateHumanMessageComAnexo(t *testing.T) {
+	resultado, err := validateHumanMessage("   ", true)
+	if err != nil || resultado != "" {
+		t.Fatalf("legenda vazia com anexo devia passar; = %q, %v", resultado, err)
+	}
+	resultado, err = validateHumanMessage("  Segue a foto  ", true)
+	if err != nil || resultado != "Segue a foto" {
+		t.Fatalf("legenda com anexo = %q, %v; quero %q", resultado, err, "Segue a foto")
+	}
+	if _, err := validateHumanMessage("oi\x00tudo bem", true); err == nil {
+		t.Fatal("legenda com NUL devia ser recusada mesmo com anexo")
+	}
+	if _, err := validateHumanMessage(strings.Repeat("a", humanMessageLimit+1), true); err == nil {
+		t.Fatal("legenda acima do teto devia ser recusada mesmo com anexo")
+	}
