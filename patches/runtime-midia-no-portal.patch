+        def baixar(api_base_url, token, message_id, chat_jid):
+            self.baixados.append((message_id, chat_jid, token))
+            pasta = self.raiz / "store" / chat_jid.replace(":", "_")
+            pasta.mkdir(parents=True, exist_ok=True)
+            arquivo = pasta / f"{message_id}.ogg"
+            arquivo.write_bytes(b"OggS-conteudo-" + message_id.encode())
+            return str(arquivo)
+
+        self.baixar = baixar
+        patcher = mock.patch.object(media, "download_media", side_effect=baixar)
+        patcher.start()
+        self.addCleanup(patcher.stop)
