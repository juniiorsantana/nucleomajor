+def _linha_segura(stderr: str, prompt: str) -> str:
+    """A primeira linha do stderr, curta, quando ela não carrega a conversa.
+
+    Em 03/10/2026 a análise da Adriani caiu duas vezes em milissegundos, sem
+    JSON no stdout, e o log não tinha nada além de `model_unavailable`. O
+    stderr é onde a CLI explica falha de partida, mas pode ecoar o prompt:
+    por isso só sai a primeira linha, sem números longos (telefone), e nada
+    se ela contiver um pedaço de qualquer linha do prompt.
+    """
+    linha = next((l.strip() for l in str(stderr or "").splitlines() if l.strip()), "")
+    if not linha:
+        return ""
+    for trecho in str(prompt or "").splitlines():
+        trecho = trecho.strip()
+        if len(trecho) >= 12 and (trecho[:40] in linha or linha[:40] in trecho):
+            return "[omitida: contém trecho da conversa]"
+    linha = re.sub(r"\d{6,}", "#", linha)
+    return linha[:160]
+
