+            audit.log(
+                "runtime.command_failed",
+                command_id=command_id,
+                command_type=command_type,
+                error_code=motivo,
+            )
+            return
+
+        if troca:
+            try:
+                self.registry.set_expected_last4(
+                    connection.organization_id, connection.connection_id, final
+                )
+            except (OSError, ValueError) as exc:
