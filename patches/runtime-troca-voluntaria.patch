+func TestReleaseWithSessionLogsOutAndAsksForRestart(t *testing.T) {
+	useTempSessionControl(t)
+	marker := useTempLogoutMarker(t)
+	if err := recordLogout(time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	session := &fakeSession{has: true}
+	releaser, control, state := newTestReleaser(t, session)
+
+	result, err := releaser.Release(1, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Status != "applied" || result.Generation != 1 || !result.RemoteLogout || !result.restart || result.Repeated {
+		t.Fatalf("result = %#v", result)
+	}
+	if session.logouts != 1 || session.drops != 0 {
+		t.Fatalf("logouts=%d drops=%d", session.logouts, session.drops)
+	}
+	saved := readControlFile(t)
+	if saved.Generation != 1 || !saved.ReleasedByOwner || !saved.ImportHistory ||
+		saved.ExpectedPhoneHash != phoneHashFor(testConnectionID, oldAccountPhone) || saved.ExpectedPhoneLast4 != "8362" {
+		t.Fatalf("control file = %#v", saved)
+	}
+	if _, err := os.Stat(marker); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("a voluntary release left the logout marker behind")
+	}
+	if got := state.snapshot().Status; got != statusWhatsAppDisconnected {
+		t.Fatalf("status = %q", got)
+	}
+	if !control.Releasing() {
+		t.Fatal("a LoggedOut arriving now would be taken for an unlink")
+	}
+
+	reloaded, err := loadSessionControl(envIdentity())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reloaded.ReleasedByOwner() || reloaded.Generation() != 1 {
+		t.Fatal("the release did not survive a restart")
+	}
+}
