+func TestReleaseFailsWhenTheControlFileCannotBeWritten(t *testing.T) {
+	useTempSessionControl(t)
+	useTempLogoutMarker(t)
+	session := &fakeSession{has: true}
+	releaser, control, _ := newTestReleaser(t, session)
+
+	// Depois de carregar: o diretorio do arquivo passa a ser um arquivo, e a
+	// gravacao falha (no Linux e no Windows, por motivos diferentes).
+	blocker := filepath.Join(t.TempDir(), "um-arquivo")
+	if err := os.WriteFile(blocker, []byte("x"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	sessionControlPath = filepath.Join(blocker, "controle_da_sessao.json")
+
+	result, err := releaser.Release(1, nil)
+	if err == nil || !result.restart {
+		t.Fatalf("err=%v restart=%v", err, result.restart)
+	}
+	if control.Generation() != 0 {
+		t.Fatal("the generation advanced without the file")
+	}
+}
