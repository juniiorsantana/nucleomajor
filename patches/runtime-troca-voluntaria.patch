+                audit.log(
+                    "runtime.session_registry_not_updated",
+                    command_id=command_id,
+                    error=type(exc).__name__,
+                )
+
+        remoto = sessao.get("remoteLogout")
+        self._complete(command_id, "completed", "", {
+            "status": "applied",
+            "generation": geracao,
+            # None quando não havia sessão para desligar: aí não há aparelho
+            # a remover no celular antigo, e a tela não pode pedir isso.
+            "remoteLogout": remoto if isinstance(remoto, bool) else None,
+        })
