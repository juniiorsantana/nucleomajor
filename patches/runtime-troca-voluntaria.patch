+        """Desconecta o WhatsApp desta conexão ou troca o número dela.
+
+        Quem decidiu foi o banco: o pedido chega aqui já confirmado no portal
+        por quem administra a empresa. Este lado confere a forma e entrega ao
+        Bridge, que é quem sabe se há sessão viva e quem guarda a geração — um
+        pedido atrasado volta como `stale_generation`, e a repetição do mesmo
+        devolve o mesmo resultado sem tocar no WhatsApp de novo.
+
+        O "applied" que sai daqui é o que o portal espera para dizer que deu
+        certo, e o banco só o aceita com a geração do pedido. Telefone, nunca:
+        o número novo chega como hash e final, e só o final fica neste host.
+        """
+        geracao = payload.get("generation")
+        if isinstance(geracao, bool) or not isinstance(geracao, int) or geracao <= 0:
+            self._complete(command_id, "failed", "invalid_payload")
+            return
+        troca = command_type == "connection_identity_replace"
+        final = str(payload.get("newLast4") or "").strip()
+        hash_do_numero = str(payload.get("newPhoneHash") or "").strip().lower()
+        if troca and (
+            not FINAL_DO_NUMERO_RE.fullmatch(final)
+            or (hash_do_numero and not HASH_DO_NUMERO_RE.fullmatch(hash_do_numero))
+        ):
+            self._complete(command_id, "failed", "invalid_payload")
+            return
+
+        control = self.manager.control_for(connection)
+        if control is None:
+            self._complete(command_id, "failed", "bridge_offline")
+            return
+        try:
+            if troca:
+                resposta = control.session_identity(
+                    connection.connection_id,
+                    geracao,
+                    hash_do_numero,
+                    final,
+                    bool(payload.get("importHistory")),
+                )
+            else:
+                resposta = control.session_logout(connection.connection_id, geracao)
+        except BridgeUnavailable:
