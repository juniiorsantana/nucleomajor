+class SessionReleaseTests(Bancada, unittest.TestCase):
+    """A troca voluntária de WhatsApp, do lado do runtime.
+
+    O banco decidiu; aqui se confere a forma e se entrega ao Bridge. O que
+    estes testes prendem: só "applied" com a geração do pedido vira sucesso,
+    cada recusa do Bridge tem o próprio motivo, e o número novo nunca volta
+    pela fila — só o final fica no registro deste host.
+    """
+
+    def _liberar(self, tipo, payload, response=None, control_hook=None):
+        comando = self._comando_de_conversa(tipo, payload)
+        directory, poller, verifier, control, arbitro = self._runtime(comando, response=response)
+        try:
+            if control_hook:
+                control_hook(poller, control)
+            poller.poll_once()
+            registro = ConnectionRegistry(Path(directory.name) / "connections.json")
+            final_no_host = registro.find(ORG, CONN).expected_phone_last4
+        finally:
+            arbitro.close()
+            directory.cleanup()
+        return verifier.completed[0], control, final_no_host
+
+    @staticmethod
+    def _aplicado(geracao, remoto=True):
+        return BridgeResponse(200, {"success": True, "session": {
+            "status": "applied", "generation": geracao, "remoteLogout": remoto, "repeated": False,
+        }})
+
+    def test_desconectar_entrega_ao_bridge_e_conclui_aplicado(self):
+        (comando_id, status, motivo, resultado, _), control, _ = self._liberar(
+            "connection_logout", {"requestId": COMMAND, "generation": 3, "kind": "disconnect"},
+            response=self._aplicado(3),
+        )
+        self.assertEqual((comando_id, status, motivo), (COMMAND, "completed", ""))
+        self.assertEqual(resultado, {"status": "applied", "generation": 3, "remoteLogout": True})
+        self.assertEqual(control.calls, [("session_logout", CONN, 3)])
+
+    def test_trocar_leva_hash_e_final_e_atualiza_so_o_final_no_host(self):
+        (_, status, motivo, resultado, _), control, final = self._liberar(
+            "connection_identity_replace",
+            {"generation": 4, "newLast4": "7777", "newPhoneHash": HASH_NOVO.upper(),
+             "previousLast4": "8362", "importHistory": False},
+            response=self._aplicado(4, remoto=False),
+        )
+        self.assertEqual((status, motivo), ("completed", ""))
+        self.assertEqual(control.calls, [("session_identity", CONN, 4, HASH_NOVO, "7777", False)])
+        self.assertEqual(resultado, {"status": "applied", "generation": 4, "remoteLogout": False})
+        self.assertNotIn(HASH_NOVO, str(resultado))
+        self.assertEqual(final, "7777")
+
+    def test_sem_sessao_para_desligar_o_remote_logout_vai_nulo(self):
+        """Trocar o número de uma conexão já desconectada não desliga aparelho
+        nenhum. Mandar `False` faria a tela pedir para removê-lo no celular."""
+        sem_sessao = BridgeResponse(200, {"success": True, "session": {
