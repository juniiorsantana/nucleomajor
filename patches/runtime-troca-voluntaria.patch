+    def _liberar_sessao(self, command_id: str, connection, command_type: str, payload: dict) -> None:
+        """Desconecta o WhatsApp desta conexão ou troca o número dela.
+
+        Quem decidiu foi o banco: o pedido chega aqui já confirmado no portal
+        por quem administra a empresa. Este lado confere a forma e entrega ao
+        Bridge, que é quem sabe se há sessão viva e quem guarda a geração — um
+        pedido atrasado volta como `stale_generation`, e a repetição do mesmo
+        devolve o mesmo resultado sem tocar no WhatsApp de novo.
+
+        O "applied" que sai daqui é o que o portal espera para dizer que deu
+        certo, e o banco só o aceita com a geração do pedido. Telefone, nunca:
+        o número novo chega como hash e final, e só o final fica neste host.
+        """
+        geracao = payload.get("generation")
+        if isinstance(geracao, bool) or not isinstance(geracao, int) or geracao <= 0:
+            self._complete(command_id, "failed", "invalid_payload")
+            return
+        troca = command_type == "connection_identity_replace"
+        final = str(payload.get("newLast4") or "").strip()
+        hash_do_numero = str(payload.get("newPhoneHash") or "").strip().lower()
+        if troca and (
+            not FINAL_DO_NUMERO_RE.fullmatch(final)
+            or (hash_do_numero and not HASH_DO_NUMERO_RE.fullmatch(hash_do_numero))
+        ):
+            self._complete(command_id, "failed", "invalid_payload")
+            return
+
+        control = self.manager.control_for(connection)
+        if control is None:
+            self._complete(command_id, "failed", "bridge_offline")
+            return
+        try:
+            if troca:
+                resposta = control.session_identity(
+                    connection.connection_id,
+                    geracao,
+                    hash_do_numero,
+                    final,
+                    bool(payload.get("importHistory")),
+                )
+            else:
+                resposta = control.session_logout(connection.connection_id, geracao)
+        except BridgeUnavailable:
+            # Não saber não é ter falhado, mas também não é ter aplicado: o
+            # portal mostra a falha e oferece repetir. A repetição sobe a
+            # geração, e um Bridge já sem sessão só regrava o arquivo.
+            self._complete(command_id, "failed", "bridge_offline")
+            return
+
+        if resposta.status == 404:
+            # Binário antigo, sem as rotas da troca: a ação é implantar.
+            motivo = "session_control_unsupported"
+        elif resposta.status == 409:
+            motivo = "stale_generation"
+        elif resposta.status >= 400:
+            motivo = "session_release_failed"
+        else:
+            sessao = resposta.body.get("session")
+            sessao = sessao if isinstance(sessao, dict) else {}
+            aplicado = sessao.get("status") == "applied" and sessao.get("generation") == geracao
+            motivo = "" if aplicado else "unexpected_bridge_result"
+        if motivo:
+            self._complete(command_id, "failed", motivo)
+            audit.log(
+                "runtime.command_failed",
+                command_id=command_id,
+                command_type=command_type,
+                error_code=motivo,
+            )
+            return
+
+        if troca:
+            try:
+                self.registry.set_expected_last4(
+                    connection.organization_id, connection.connection_id, final
+                )
+            except (OSError, ValueError) as exc:
+                # Só a exibição neste host fica velha; o Bridge já tem o número.
+                audit.log(
+                    "runtime.session_registry_not_updated",
+                    command_id=command_id,
+                    error=type(exc).__name__,
+                )
+
+        self._complete(command_id, "completed", "", {
+            "status": "applied",
+            "generation": geracao,
+            "remoteLogout": bool(sessao.get("remoteLogout")),
+        })
+        audit.log(
+            "runtime.command_completed",
+            command_id=command_id,
+            command_type=command_type,
+            generation=geracao,
+        )
+
