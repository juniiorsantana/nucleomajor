+func newSessionTestHandler(releaser sessionReleaserAPI, restarts *int) http.Handler {
+	mux := http.NewServeMux()
+	state := newConnectionState(testOrganizationID, testConnectionID)
+	registerSessionRoutes(mux, "test-token", state, releaser, func() { *restarts++ })
+	return mux
+}
+
+func sessionRequest(t *testing.T, path string, body interface{}) *http.Request {
+	t.Helper()
+	data, err := json.Marshal(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest(http.MethodPost, path, bytes.NewReader(data))
+	req.Header.Set("Authorization", "Bearer test-token")
+	return req
+}
+
+func decodeSessionBody(t *testing.T, recorder *httptest.ResponseRecorder) map[string]interface{} {
+	t.Helper()
+	var body map[string]interface{}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
+		t.Fatalf("body %q: %v", recorder.Body.String(), err)
+	}
+	return body
+}
