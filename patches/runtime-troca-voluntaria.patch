+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/store"
+)
+
+const (
+	// A conta antiga como o WhatsApp a guarda: sem o nono digito.
+	oldAccountPhone = "556599998362"
+	newAccountPhone = "5565999997777"
+)
+
+func boolPtr(v bool) *bool { return &v }
+
+func useTempSessionControl(t *testing.T) string {
+	t.Helper()
+	previous := sessionControlPath
+	sessionControlPath = filepath.Join(t.TempDir(), "controle_da_sessao.json")
+	t.Cleanup(func() { sessionControlPath = previous })
+	return sessionControlPath
+}
+
+func envIdentity() *runtimeConfig {
+	return &runtimeConfig{
+		OrganizationID:     testOrganizationID,
+		ConnectionID:       testConnectionID,
+		ExpectedPhoneHash:  phoneHashFor(testConnectionID, oldAccountPhone),
+		ExpectedPhoneLast4: "8362",
+	}
+}
+
+type fakeSession struct {
+	has         bool
+	logoutErr   error
+	dropErr     error
+	logouts     int
+	drops       int
+	disconnects int
+}
+
+func (f *fakeSession) HasSession() bool { return f.has }
+
