+func TestIdentityTreatsTheNinthDigitAsTheSameNumber(t *testing.T) {
+	withNine := "5565999998362"
+	cases := []struct {
+		name     string
+		expected string
+		actual   string
+		want     bool
+	}{
+		{"portal com o 9, conta sem", withNine, oldAccountPhone, true},
+		{"portal sem o 9, conta com", oldAccountPhone, withNine, true},
+		{"o mesmo, igual", withNine, withNine, true},
+		{"outro numero", withNine, "5565999990000", false},
+		{"mesmo final, outro numero", withNine, "5511988888362", false},
+	}
+	for _, tc := range cases {
+		cfg := &runtimeConfig{ConnectionID: testConnectionID, ExpectedPhoneHash: phoneHashFor(testConnectionID, tc.expected)}
+		if got := cfg.MatchesIdentity(tc.actual); got != tc.want {
+			t.Fatalf("%s: MatchesIdentity = %v, want %v", tc.name, got, tc.want)
+		}
+	}
+	// Sem hash, so o final: o mesmo de antes.
+	byLast4 := &runtimeConfig{ConnectionID: testConnectionID, ExpectedPhoneLast4: "8362"}
+	if !byLast4.MatchesIdentity(oldAccountPhone) || byLast4.MatchesIdentity(newAccountPhone) {
+		t.Fatal("last4 comparison changed")
+	}
+}
