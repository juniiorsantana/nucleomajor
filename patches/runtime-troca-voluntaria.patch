+	if !control.HasExpectedIdentity() || !control.MatchesIdentity(oldAccountPhone) {
+		t.Fatal("identity from the environment was not used")
+	}
+	if control.MatchesIdentity(newAccountPhone) {
+		t.Fatal("a different number matched")
+	}
+	if !control.ImportHistory() || control.ReleasedByOwner() || control.Generation() != 0 {
+		t.Fatalf("defaults changed: import=%v released=%v generation=%d",
+			control.ImportHistory(), control.ReleasedByOwner(), control.Generation())
+	}
