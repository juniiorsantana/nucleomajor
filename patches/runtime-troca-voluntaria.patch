+func TestSessionRoutesAnswerAppliedStaleAndFailure(t *testing.T) {
+	restarts := 0
+	hash := phoneHashFor(testConnectionID, newAccountPhone)
+
+	applied := &fakeReleaser{result: sessionReleaseResult{Status: "applied", RemoteLogout: boolPtr(true), restart: true}}
+	recorder := httptest.NewRecorder()
+	newSessionTestHandler(applied, &restarts).ServeHTTP(recorder, sessionRequest(t, "/api/internal/v1/session/identity",
+		map[string]interface{}{"connectionId": testConnectionID, "generation": 4, "phoneHash": strings.ToUpper(hash), "phoneLast4": "7777", "importHistory": true}))
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("applied: %d %s", recorder.Code, recorder.Body.String())
+	}
+	session, _ := decodeSessionBody(t, recorder)["session"].(map[string]interface{})
+	if session["status"] != "applied" || session["generation"] != float64(4) || session["remoteLogout"] != true {
+		t.Fatalf("session = %#v", session)
+	}
+	if applied.change == nil || applied.change.PhoneHash != hash || applied.change.PhoneLast4 != "7777" || !applied.change.ImportHistory {
+		t.Fatalf("change = %#v", applied.change)
+	}
+	if strings.Contains(recorder.Body.String(), hash) {
+		t.Fatal("the response echoed the phone hash")
+	}
+	if restarts != 1 {
+		t.Fatalf("restarts = %d after a release that touched a live session", restarts)
+	}
+
+	stale := &fakeReleaser{err: errStaleGeneration}
+	recorder = httptest.NewRecorder()
+	newSessionTestHandler(stale, &restarts).ServeHTTP(recorder, sessionRequest(t, "/api/internal/v1/session/logout",
+		map[string]interface{}{"connectionId": testConnectionID, "generation": 2}))
+	if recorder.Code != http.StatusConflict || decodeSessionBody(t, recorder)["code"] != "stale_generation" {
+		t.Fatalf("stale: %d %s", recorder.Code, recorder.Body.String())
+	}
+
+	failed := &fakeReleaser{err: errors.New("could not drop the session: disk full at /var/lib/x"), result: sessionReleaseResult{restart: true}}
+	recorder = httptest.NewRecorder()
+	newSessionTestHandler(failed, &restarts).ServeHTTP(recorder, sessionRequest(t, "/api/internal/v1/session/logout",
+		map[string]interface{}{"connectionId": testConnectionID, "generation": 5}))
+	if recorder.Code != http.StatusInternalServerError || decodeSessionBody(t, recorder)["code"] != "session_release_failed" {
+		t.Fatalf("failed: %d %s", recorder.Code, recorder.Body.String())
+	}
+	if strings.Contains(recorder.Body.String(), "/var/lib") {
+		t.Fatal("the response leaked the internal error")
+	}
+	if restarts != 2 {
+		t.Fatalf("restarts = %d: a failure after touching the session must restart too", restarts)
+	}
+}
