+func TestReleaseFailsWhenTheSessionCannotBeDropped(t *testing.T) {
+	useTempSessionControl(t)
+	useTempLogoutMarker(t)
+	session := &fakeSession{has: true, logoutErr: errors.New("offline"), dropErr: errors.New("disk")}
+	releaser, control, _ := newTestReleaser(t, session)
