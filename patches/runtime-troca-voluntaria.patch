--- /dev/null
+++ b/whatsapp-bridge/troca.go
@@ -0,0 +1,613 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waHistorySync"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+// A troca voluntaria de numero (ORCH-014/016) acontece na MESMA conexao: o
+// portal pede pela fila de comandos, o runtime chama as rotas abaixo e o
+// bridge aplica. O que o portal decidiu sobre a sessao fica em
+// controle_da_sessao.json, que atravessa o reinicio do processo:
+//
+//   - generation ordena os pedidos. Pedido com geracao menor que a ja
+//     aplicada chegou atrasado e e recusado; a mesma geracao e repeticao e
+//     devolve o mesmo resultado, sem tocar no WhatsApp de novo.
+//   - a identidade esperada: depois de uma troca vale a daqui, e nao a do
+//     .env, que guarda o numero do provisionamento.
+//   - releasedByOwner: a sessao foi encerrada por pedido do administrador. O
+//     processo nao abre QR sozinho; espera o portal pedir o pareamento.
+//   - importHistory: se o historico que o WhatsApp manda ao parear entra no
+//     messages.db.
+//
+// O messages.db nunca e apagado aqui: as conversas sao da conexao, nao do
+// numero.
+var sessionControlPath = filepath.Join("store", "controle_da_sessao.json")
+
+var errStaleGeneration = errors.New("stale generation: a newer session change was already applied")
+
+var phoneHashPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+
+type sessionControlState struct {
+	Generation         int64  `json:"generation"`
+	ExpectedPhoneHash  string `json:"expectedPhoneHash,omitempty"`
+	ExpectedPhoneLast4 string `json:"expectedPhoneLast4,omitempty"`
+	ImportHistory      bool   `json:"importHistory"`
+	// HistoryCutoff: com importHistory=false, a hora em que o número
+	// esperado conectou pela primeira vez. Do histórico que o WhatsApp mandar
+	// depois, entra só o que é desta hora em diante: o de antes (as conversas
+	// pessoais do celular) fica de fora; o de depois (o que a conexão já
+	// atendia) pode voltar sem expor nada. Vazio: ainda não conectou, nada
+	// entra.
+	HistoryCutoff    string `json:"historyCutoff,omitempty"`
+	ReleasedByOwner  bool   `json:"releasedByOwner"`
+	LastRemoteLogout *bool  `json:"lastRemoteLogout,omitempty"`
+	UpdatedAt        string `json:"updatedAt"`
+}
+
+// sessionControl e a fonte da identidade esperada deste processo. Sem o
+// arquivo, devolve a do .env, como sempre foi.
+type sessionControl struct {
+	mu      sync.Mutex
+	base    *runtimeConfig
+	state   sessionControlState
+	present bool
+	// releasing marca o desligamento pedido pelo portal enquanto ele
+	// acontece: um LoggedOut que o WhatsApp mande em seguida nao e desvinculo.
+	releasing bool
+	now       func() time.Time
+}
+
+// loadSessionControl falha alto com arquivo ilegivel, pelo mesmo motivo de
+// loadRuntimeConfig: subir com a identidade errada e pior que nao subir. O
+// arquivo e gravado por troca atomica; ilegivel so por mao humana.
+func loadSessionControl(base *runtimeConfig) (*sessionControl, error) {
+	control := &sessionControl{base: base, now: time.Now}
+	data, err := os.ReadFile(sessionControlPath)
+	if errors.Is(err, os.ErrNotExist) {
+		return control, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("nao foi possivel ler %s: %w", sessionControlPath, err)
+	}
+	var state sessionControlState
+	if err := json.Unmarshal(data, &state); err != nil {
+		return nil, fmt.Errorf("%s ilegivel: %w", sessionControlPath, err)
+	}
+	if state.Generation <= 0 {
+		return nil, fmt.Errorf("%s sem geracao valida", sessionControlPath)
+	}
+	if state.ExpectedPhoneHash != "" && !phoneHashPattern.MatchString(state.ExpectedPhoneHash) {
+		return nil, fmt.Errorf("%s com hash de telefone invalido", sessionControlPath)
+	}
+	if state.ExpectedPhoneLast4 != "" && len(onlyDigits(state.ExpectedPhoneLast4)) != 4 {
+		return nil, fmt.Errorf("%s com final de telefone invalido", sessionControlPath)
+	}
+	control.state = state
+	control.present = true
+	return control, nil
+}
+
+func (s *sessionControl) expectedLocked() (string, string) {
+	if s.present && (s.state.ExpectedPhoneHash != "" || s.state.ExpectedPhoneLast4 != "") {
+		return s.state.ExpectedPhoneHash, s.state.ExpectedPhoneLast4
+	}
+	if s.base == nil {
+		return "", ""
+	}
+	return s.base.ExpectedPhoneHash, s.base.ExpectedPhoneLast4
+}
+
+func (s *sessionControl) connectionID() string {
+	if s.base == nil {
+		return ""
+	}
+	return s.base.ConnectionID
+}
+
+// Source diz de onde vem a identidade esperada, para o log de partida.
+func (s *sessionControl) Source() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.present && (s.state.ExpectedPhoneHash != "" || s.state.ExpectedPhoneLast4 != "") {
+		return fmt.Sprintf("controle da sessao, geracao %d", s.state.Generation)
+	}
+	return "ambiente"
+}
+
+func (s *sessionControl) HasExpectedIdentity() bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	hash, last := s.expectedLocked()
+	return hash != "" || last != ""
+}
+
+func (s *sessionControl) ExpectedLast4() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	_, last := s.expectedLocked()
+	return last
+}
+
+func (s *sessionControl) MatchesIdentity(phone string) bool {
+	s.mu.Lock()
+	hash, last := s.expectedLocked()
+	s.mu.Unlock()
+	return matchesExpectedIdentity(s.connectionID(), hash, last, phone)
+}
+
+func (s *sessionControl) Generation() int64 {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.state.Generation
+}
+
+// ImportHistory e verdadeiro sem o arquivo: e o comportamento de sempre.
+func (s *sessionControl) ImportHistory() bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.present {
+		return true
+	}
+	return s.state.ImportHistory
+}
+
+// HistoryKeep diz que historico entra no messages.db. nil: tudo, como sempre
+// foi. Uma funcao: so o que ela aceita pela hora da mensagem.
+//
+// O Connected e o HistorySync chegam por goroutines diferentes do whatsmeow,
+// em qualquer ordem. Um historico que chegue antes de o recorte existir nao
+// leva nada: o lado seguro, porque ate ali so pode haver conversa de antes do
+// pareamento.
+func (s *sessionControl) HistoryKeep() func(time.Time) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.present || s.state.ImportHistory {
+		return nil
+	}
+	cutoff, err := time.Parse(time.RFC3339, s.state.HistoryCutoff)
+	if s.state.HistoryCutoff == "" || err != nil {
+		return func(time.Time) bool { return false }
+	}
+	return func(ts time.Time) bool { return !ts.Before(cutoff) }
+}
+
+// MarkIdentityConfirmed roda quando o numero CERTO conecta (nunca num
+// identity_mismatch: o recorte marcado ali deixaria entrar o historico
+// pessoal do numero certo entre as duas leituras de QR). Com
+// importHistory=false e sem recorte ainda, o recorte passa a ser agora. Nao
+// liga a importacao: so diz a partir de quando ela vale.
+func (s *sessionControl) MarkIdentityConfirmed() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.present || s.state.ImportHistory || s.state.HistoryCutoff != "" {
+		return nil
+	}
+	next := s.state
+	next.HistoryCutoff = s.now().UTC().Format(time.RFC3339)
+	return s.commitLocked(next)
+}
+
+// keptHistoryMessages devolve, na mesma ordem, so as mensagens que keep
+// aceita pela hora. Mensagem sem hora fica de fora: na duvida, nao entra.
+func keptHistoryMessages(messages []*waHistorySync.HistorySyncMsg, keep func(time.Time) bool) []*waHistorySync.HistorySyncMsg {
+	kept := make([]*waHistorySync.HistorySyncMsg, 0, len(messages))
+	for _, msg := range messages {
+		if msg == nil || msg.Message == nil {
+			continue
+		}
+		ts := msg.Message.GetMessageTimestamp()
+		if ts == 0 || !keep(time.Unix(int64(ts), 0)) {
+			continue
+		}
+		kept = append(kept, msg)
+	}
+	return kept
+}
+
+func (s *sessionControl) ReleasedByOwner() bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.present && s.state.ReleasedByOwner
+}
+
+// Releasing cobre o LoggedOut que chega durante ou depois do desligamento
+// pedido pelo portal.
+func (s *sessionControl) Releasing() bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.releasing || (s.present && s.state.ReleasedByOwner)
+}
+
+func (s *sessionControl) setReleasing(value bool) {
+	s.mu.Lock()
+	s.releasing = value
+	s.mu.Unlock()
+}
+
+// ClearRelease roda no Connected: com sessao de novo, a liberacao acabou.
+func (s *sessionControl) ClearRelease() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.present || !s.state.ReleasedByOwner {
+		return nil
+	}
+	next := s.state
+	next.ReleasedByOwner = false
+	return s.commitLocked(next)
+}
+
+// apply grava o estado novo do pedido `generation`. Devolve o estado anterior
+// a gravacao para o chamador montar a resposta.
+func (s *sessionControl) apply(generation int64, mutate func(*sessionControlState)) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if generation <= s.state.Generation {
+		return errStaleGeneration
+	}
+	next := s.state
+	if !s.present {
+		// O primeiro arquivo leva a identidade do .env, para ser completo
+		// sozinho: depois dele, o .env deixa de mandar.
+		next.ExpectedPhoneHash, next.ExpectedPhoneLast4 = s.expectedLocked()
+		next.ImportHistory = true
+	}
+	mutate(&next)
+	next.Generation = generation
+	return s.commitLocked(next)
+}
+
+func (s *sessionControl) commitLocked(next sessionControlState) error {
+	next.UpdatedAt = s.now().UTC().Format(time.RFC3339)
+	if err := writeSessionControl(next); err != nil {
+		return err
+	}
+	s.state = next
+	s.present = true
+	return nil
+}
+
+// writeSessionControl troca o arquivo inteiro de uma vez: quem le nunca ve a
+// metade de uma gravacao.
+func writeSessionControl(state sessionControlState) error {
+	data, err := json.MarshalIndent(state, "", "  ")
+	if err != nil {
+		return err
+	}
+	dir := filepath.Dir(sessionControlPath)
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return err
+	}
+	temporary, err := os.CreateTemp(dir, ".controle_da_sessao-*.tmp")
+	if err != nil {
+		return err
+	}
+	name := temporary.Name()
+	defer os.Remove(name)
+	if _, err := temporary.Write(append(data, '\n')); err != nil {
+		temporary.Close()
+		return err
+	}
+	if err := temporary.Sync(); err != nil {
+		temporary.Close()
+		return err
+	}
+	if err := temporary.Close(); err != nil {
+		return err
+	}
+	if err := os.Chmod(name, 0600); err != nil {
+		return err
+	}
+	return os.Rename(name, sessionControlPath)
+}
+
+// matchesExpectedIdentity compara a identidade real com a esperada.
+//
+// Ordem deliberada: o hash manda quando existe. Os ultimos quatro digitos sao
+// conferencia humana e colidem com facilidade; sozinhos nunca deveriam
+// autorizar envio, mas servem quando o hash ainda nao foi registrado.
+//
+// O mesmo celular brasileiro com e sem o nono digito e o mesmo numero. O
+// portal registra o numero como a pessoa o conhece hoje, com o 9, e o
+// WhatsApp ainda guarda muitas contas antigas sem ele (ver lid.go). Sem esta
+// equivalencia, conectar o numero certo cairia em identity_mismatch.
+func matchesExpectedIdentity(connectionID, expectedHash, expectedLast4, phone string) bool {
+	digits := onlyDigits(phone)
+	if digits == "" {
+		return false
+	}
+	if expectedHash != "" {
+		for _, alias := range brazilianPhoneAliases(digits) {
+			if phoneHashFor(connectionID, alias) == expectedHash {
+				return true
+			}
+		}
+		return false
+	}
+	if expectedLast4 != "" {
+		return last4(digits) == onlyDigits(expectedLast4)
+	}
+	return true
+}
+
+// sessionClient e o pedaco do whatsmeow que a troca usa. Existe para os
+// testes; o caminho real e whatsmeowSession.
+type sessionClient interface {
+	HasSession() bool
+	// Logout pede ao WhatsApp para desligar o aparelho e apaga a sessao
+	// local. Se o WhatsApp nao responder, nao apaga nada.
+	Logout(ctx context.Context) error
+	// DropLocalSession apaga a sessao so daqui. O aparelho pode continuar
+	// listado no celular ate alguem remove-lo la.
+	DropLocalSession(ctx context.Context) error
+	Disconnect()
+}
+
+type whatsmeowSession struct {
+	client *whatsmeow.Client
+}
+
+func (s whatsmeowSession) HasSession() bool {
+	return s.client.Store != nil && s.client.Store.ID != nil
+}
+
+func (s whatsmeowSession) Logout(ctx context.Context) error {
+	return s.client.Logout(ctx)
+}
+
+func (s whatsmeowSession) DropLocalSession(ctx context.Context) error {
+	s.client.Disconnect()
+	if s.client.Store == nil {
+		return nil
+	}
+	return s.client.Store.Delete(ctx)
+}
+
+func (s whatsmeowSession) Disconnect() {
+	s.client.Disconnect()
+}
+
+// identityChange e o numero novo, como o banco o guarda: hash salgado pela
+// conexao e os quatro ultimos digitos. O telefone inteiro nunca chega aqui.
+type identityChange struct {
+	PhoneHash     string
+	PhoneLast4    string
+	ImportHistory bool
+}
+
+type sessionReleaseResult struct {
+	Status     string `json:"status"`
+	Generation int64  `json:"generation"`
+	// RemoteLogout: o WhatsApp confirmou o desligamento do aparelho? nil
+	// quando nao havia sessao para desligar: ai nao ha o que remover no
+	// celular antigo, e a tela nao pode mandar ninguem procurar o aparelho.
+	RemoteLogout *bool `json:"remoteLogout"`
+	Repeated     bool  `json:"repeated"`
+	// restart: o processo encostou numa sessao viva e precisa recomecar com
+	// um device limpo (o whatsmeow nao pareia de novo com o device apagado).
+	restart bool
+}
+
+// O orcamento de uma liberacao cabe nos 30 s que o assistente espera
+// (SESSION_TIMEOUT em bridge_control.py): ate 15 s para o WhatsApp confirmar
+// o desligamento e, se ele nao confirmar, ate 5 s proprios para apagar a
+// sessao daqui. O prazo da limpeza e separado de proposito: um Logout que
+// esgotou o dele deixaria o contexto cancelado, e apagar a sessao local
+// falharia justamente quando a rede caiu.
+const (
+	defaultLogoutTimeout       = 15 * time.Second
+	defaultLocalCleanupTimeout = 5 * time.Second
+)
+
+type sessionReleaser struct {
+	mu             sync.Mutex
+	control        *sessionControl
+	session        sessionClient
+	state          *connectionState
+	logger         waLog.Logger
+	logoutTimeout  time.Duration
+	cleanupTimeout time.Duration
+}
+
+func newSessionReleaser(control *sessionControl, session sessionClient, state *connectionState, logger waLog.Logger) *sessionReleaser {
+	return &sessionReleaser{
+		control:        control,
+		session:        session,
+		state:          state,
+		logger:         logger,
+		logoutTimeout:  defaultLogoutTimeout,
+		cleanupTimeout: defaultLocalCleanupTimeout,
+	}
+}
+
+func (r *sessionReleaser) warnf(format string, args ...interface{}) {
+	if r.logger != nil {
+		r.logger.Warnf(format, args...)
+	}
+}
+
+// Release encerra a sessao desta conexao por pedido do portal e, com
+// `change`, troca a identidade esperada. Um pedido por vez.
+func (r *sessionReleaser) Release(generation int64, change *identityChange) (sessionReleaseResult, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	current := r.control.Generation()
+	if generation < current {
+		return sessionReleaseResult{}, errStaleGeneration
+	}
+	if generation == current && current > 0 {
+		r.control.mu.Lock()
+		remote := r.control.state.LastRemoteLogout
+		r.control.mu.Unlock()
+		return sessionReleaseResult{Status: "applied", Generation: generation, RemoteLogout: remote, Repeated: true}, nil
+	}
+
+	hadSession := r.session.HasSession()
+	var remote *bool
+	if hadSession {
+		confirmado := false
+		r.control.setReleasing(true)
+		logoutCtx, cancelLogout := context.WithTimeout(context.Background(), r.logoutTimeout)
+		err := r.session.Logout(logoutCtx)
+		cancelLogout()
+		if err != nil {
+			// O WhatsApp nao confirmou o desligamento (rede, sessao ja
+			// invalida, prazo esgotado). Quem pediu para desconectar nao pode
+			// continuar conectado porque o servidor nao respondeu: a sessao
+			// sai daqui do mesmo jeito, com um prazo proprio.
+			r.warnf("WhatsApp did not confirm the logout; dropping the local session (%v)", err)
+			cleanupCtx, cancelCleanup := context.WithTimeout(context.Background(), r.cleanupTimeout)
+			dropErr := r.session.DropLocalSession(cleanupCtx)
+			cancelCleanup()
+			if dropErr != nil {
+				r.control.setReleasing(false)
+				return sessionReleaseResult{restart: true}, fmt.Errorf("could not drop the session: %w", dropErr)
+			}
+		} else {
+			confirmado = true
+		}
+		// Sem sucesso enquanto a sessao nao saiu de fato.
+		if r.session.HasSession() {
+			r.control.setReleasing(false)
+			return sessionReleaseResult{restart: true}, errors.New("the WhatsApp session is still stored after the release")
+		}
+		remote = &confirmado
+	} else {
+		// Sem sessao: so fecha um pareamento que esteja aberto.
+		r.session.Disconnect()
+	}
+
+	err := r.control.apply(generation, func(next *sessionControlState) {
+		next.ReleasedByOwner = true
+		next.LastRemoteLogout = remote
+		if change != nil {
+			next.ExpectedPhoneHash = change.PhoneHash
+			next.ExpectedPhoneLast4 = change.PhoneLast4
+			next.ImportHistory = change.ImportHistory
+			// Numero novo, recorte novo: vale a primeira conexao dele.
+			next.HistoryCutoff = ""
+		}
+	})
+	if err != nil {
+		return sessionReleaseResult{restart: hadSession}, fmt.Errorf("could not persist the session control: %w", err)
+	}
+	// O desligamento foi pedido: nao ha desvinculo para diagnosticar.
+	if err := clearLogoutMarker(); err != nil {
+		r.warnf("Could not clear logout marker: %v", err)
+	}
+	r.state.setDisconnected()
+	return sessionReleaseResult{Status: "applied", Generation: generation, RemoteLogout: remote, restart: hadSession}, nil
+}
+
+type sessionReleaserAPI interface {
+	Release(generation int64, change *identityChange) (sessionReleaseResult, error)
+}
+
+// registerSessionRoutes expoe a troca na API interna. Quem chama e o runtime
+// desta conexao, com o token dela, depois de a fila entregar um pedido
+// confirmado no portal.
+func registerSessionRoutes(mux *http.ServeMux, token string, state *connectionState, releaser sessionReleaserAPI, restart func()) {
+	mux.HandleFunc("/api/internal/v1/session/logout", requirePOST(requireToken(token, func(w http.ResponseWriter, r *http.Request) {
+		var req struct {
+			ConnectionID string `json:"connectionId"`
+			Generation   int64  `json:"generation"`
+		}
+		if !decodeSessionRequest(w, r, state, &req, &req.ConnectionID) {
+			return
+		}
+		if req.Generation <= 0 {
+			writeSessionError(w, http.StatusBadRequest, "invalid_generation", "generation must be positive")
+			return
+		}
+		result, err := releaser.Release(req.Generation, nil)
+		respondSessionRelease(w, result, err, restart)
+	})))
+
+	mux.HandleFunc("/api/internal/v1/session/identity", requirePOST(requireToken(token, func(w http.ResponseWriter, r *http.Request) {
+		var req struct {
+			ConnectionID  string `json:"connectionId"`
+			Generation    int64  `json:"generation"`
+			PhoneHash     string `json:"phoneHash"`
+			PhoneLast4    string `json:"phoneLast4"`
+			ImportHistory bool   `json:"importHistory"`
+		}
+		if !decodeSessionRequest(w, r, state, &req, &req.ConnectionID) {
+			return
+		}
+		if req.Generation <= 0 {
+			writeSessionError(w, http.StatusBadRequest, "invalid_generation", "generation must be positive")
+			return
+		}
+		hash := strings.ToLower(strings.TrimSpace(req.PhoneHash))
+		last := strings.TrimSpace(req.PhoneLast4)
+		if hash != "" && !phoneHashPattern.MatchString(hash) {
+			writeSessionError(w, http.StatusBadRequest, "invalid_identity", "phone hash must be a sha256 in hex")
+			return
+		}
+		if len(last) != 4 || onlyDigits(last) != last {
+			writeSessionError(w, http.StatusBadRequest, "invalid_identity", "phone last4 must have 4 digits")
+			return
+		}
+		result, err := releaser.Release(req.Generation, &identityChange{
+			PhoneHash:     hash,
+			PhoneLast4:    last,
+			ImportHistory: req.ImportHistory,
+		})
+		respondSessionRelease(w, result, err, restart)
+	})))
+}
+
+func decodeSessionRequest(w http.ResponseWriter, r *http.Request, state *connectionState, target interface{}, connectionID *string) bool {
+	decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4096))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		writeSessionError(w, http.StatusBadRequest, "invalid_request", "invalid request format")
+		return false
+	}
+	if strings.TrimSpace(*connectionID) == "" || *connectionID != state.snapshot().ConnectionID {
+		writeSessionError(w, http.StatusForbidden, "connection_mismatch", "connection does not match this bridge")
+		return false
+	}
+	return true
+}
+
+func writeSessionError(w http.ResponseWriter, status int, code, message string) {
+	writeJSON(w, status, map[string]interface{}{
+		"success": false,
+		"code":    code,
+		"message": message,
+	})
+}
+
+func respondSessionRelease(w http.ResponseWriter, result sessionReleaseResult, err error, restart func()) {
+	switch {
+	case errors.Is(err, errStaleGeneration):
+		writeSessionError(w, http.StatusConflict, "stale_generation", err.Error())
+	case err != nil:
+		// O motivo detalhado fica no log do processo; a resposta so diz o que
+		// o runtime precisa para gravar o slug.
+		writeSessionError(w, http.StatusInternalServerError, "session_release_failed", "could not release the WhatsApp session")
+	default:
+		writeJSON(w, http.StatusOK, map[string]interface{}{
+			"success": true,
+			"session": result,
+		})
+	}
+	if result.restart && restart != nil {
+		restart()
+	}
+}
diff --git a/whatsapp-bridge/troca_prazos_test.go b/whatsapp-bridge/troca_prazos_test.go
new file mode 100644
index 0000000..8077e92
--- /dev/null
+++ b/whatsapp-bridge/troca_prazos_test.go
@@ -0,0 +1,299 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/proto/waHistorySync"
+	"go.mau.fi/whatsmeow/proto/waWeb"
+	"google.golang.org/protobuf/proto"
+)
+
+// sessaoTravada imita a rede que caiu: o Logout so volta quando o prazo dele
+// acaba. A limpeza local registra o contexto que recebeu.
+type sessaoTravada struct {
+	fakeSession
+	logoutBlocks bool
+	dropBlocks   bool
+	dropCtxVivo  bool
+	dropTemPrazo bool
+	dropPrazo    time.Duration
+}
+
+func (s *sessaoTravada) Logout(ctx context.Context) error {
+	s.logouts++
+	if s.logoutBlocks {
+		<-ctx.Done()
+		return ctx.Err()
+	}
+	s.has = false
+	return nil
+}
+
+func (s *sessaoTravada) DropLocalSession(ctx context.Context) error {
+	s.drops++
+	s.dropCtxVivo = ctx.Err() == nil
+	if deadline, ok := ctx.Deadline(); ok {
+		s.dropTemPrazo = true
+		s.dropPrazo = time.Until(deadline)
+	}
+	if s.dropBlocks {
+		<-ctx.Done()
+		return ctx.Err()
+	}
+	s.has = false
+	return nil
+}
+
+// sessaoTeimosa diz que desligou, mas a sessao continua guardada.
+type sessaoTeimosa struct {
+	fakeSession
+}
+
+func (s *sessaoTeimosa) Logout(context.Context) error {
+	s.logouts++
+	return nil
+}
+
+func releaserCom(t *testing.T, session sessionClient) (*sessionReleaser, *sessionControl) {
+	t.Helper()
+	control, err := loadSessionControl(envIdentity())
+	if err != nil {
+		t.Fatal(err)
+	}
+	state := newConnectionState(testOrganizationID, testConnectionID)
+	state.setConnected(oldAccountPhone)
+	return newSessionReleaser(control, session, state, nil), control
+}
+
+func TestOsPrazosCabemNoQueOAssistenteEspera(t *testing.T) {
+	// SESSION_TIMEOUT em whatsapp-assistant/bridge_control.py e 30 s.
+	if total := defaultLogoutTimeout + defaultLocalCleanupTimeout; total >= 30*time.Second {
+		t.Fatalf("logout + limpeza = %s: o assistente desistiria antes do bridge responder", total)
+	}
+}
+
+func TestLogoutQueEsgotaOPrazoNaoContaminaALimpezaLocal(t *testing.T) {
+	useTempSessionControl(t)
+	useTempLogoutMarker(t)
+	session := &sessaoTravada{fakeSession: fakeSession{has: true}, logoutBlocks: true}
+	releaser, control := releaserCom(t, session)
+	releaser.logoutTimeout = 20 * time.Millisecond
+	releaser.cleanupTimeout = 2 * time.Second
+
+	inicio := time.Now()
+	result, err := releaser.Release(1, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !session.dropCtxVivo {
+		t.Fatal("a limpeza local recebeu o contexto do Logout, ja cancelado")
+	}
+	if !session.dropTemPrazo || session.dropPrazo <= 0 || session.dropPrazo > 2*time.Second {
+		t.Fatalf("a limpeza local precisa de prazo proprio e limitado: tem=%v prazo=%s", session.dropTemPrazo, session.dropPrazo)
+	}
+	if result.RemoteLogout == nil || *result.RemoteLogout || !result.restart || control.Generation() != 1 {
+		t.Fatalf("result=%#v generation=%d", result, control.Generation())
+	}
+	if time.Since(inicio) > time.Second {
+		t.Fatalf("a liberacao levou %s, alem dos prazos", time.Since(inicio))
+	}
+}
+
+func TestALimpezaLocalTambemTemPrazoEFalhaComHonestidade(t *testing.T) {
+	useTempSessionControl(t)
+	useTempLogoutMarker(t)
+	session := &sessaoTravada{fakeSession: fakeSession{has: true}, logoutBlocks: true, dropBlocks: true}
+	releaser, control := releaserCom(t, session)
+	releaser.logoutTimeout = 20 * time.Millisecond
+	releaser.cleanupTimeout = 30 * time.Millisecond
+
+	inicio := time.Now()
+	result, err := releaser.Release(1, &identityChange{
+		PhoneHash:  phoneHashFor(testConnectionID, newAccountPhone),
+		PhoneLast4: "7777",
+	})
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("err = %v, want o prazo da limpeza", err)
+	}
+	if !result.restart {
+		t.Fatal("o processo ficou de pe com a sessao pela metade")
+	}
+	if time.Since(inicio) > time.Second {
+		t.Fatalf("a falha levou %s", time.Since(inicio))
+	}
+	if _, statErr := os.Stat(sessionControlPath); !errors.Is(statErr, os.ErrNotExist) {
+		t.Fatal("a falha gravou o arquivo de controle")
+	}
+	if control.Generation() != 0 || control.Releasing() {
+		t.Fatalf("generation=%d releasing=%v", control.Generation(), control.Releasing())
+	}
+	if !control.MatchesIdentity(oldAccountPhone) || control.MatchesIdentity(newAccountPhone) {
+		t.Fatal("a falha trocou a identidade esperada")
+	}
+}
+
+func TestSemSucessoEnquantoASessaoContinuaGuardada(t *testing.T) {
+	useTempSessionControl(t)
+	useTempLogoutMarker(t)
+	releaser, control := releaserCom(t, &sessaoTeimosa{fakeSession: fakeSession{has: true}})
+
+	result, err := releaser.Release(1, nil)
+	if err == nil || !result.restart {
+		t.Fatalf("err=%v restart=%v: a sessao nao saiu e a liberacao disse que saiu", err, result.restart)
+	}
+	if control.Generation() != 0 {
+		t.Fatal("a geracao andou sem a sessao sair")
+	}
+}
+
+func TestFalhaENovaTentativaNaoReaplicamIdentidadeErradaNemTocamNoHistorico(t *testing.T) {
+	useTempSessionControl(t)
+	useTempLogoutMarker(t)
+	anterior := messagesStorePath
+	messagesStorePath = filepath.Join(t.TempDir(), "messages.db")
+	t.Cleanup(func() { messagesStorePath = anterior })
+	if err := os.WriteFile(messagesStorePath, []byte("conversas da conexao"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	session := &fakeSession{has: true, logoutErr: errors.New("offline"), dropErr: errors.New("disco")}
+	releaser, control, _ := newTestReleaser(t, session)
+	novo := &identityChange{PhoneHash: phoneHashFor(testConnectionID, newAccountPhone), PhoneLast4: "7777"}
+
+	if _, err := releaser.Release(1, novo); err == nil {
+		t.Fatal("a primeira tentativa deveria falhar")
+	}
+	if control.Generation() != 0 || !control.MatchesIdentity(oldAccountPhone) || control.MatchesIdentity(newAccountPhone) {
+		t.Fatal("a tentativa que falhou mexeu na identidade")
+	}
+
+	// O portal repete com uma geracao nova; agora a limpeza funciona.
+	session.dropErr = nil
+	if _, err := releaser.Release(2, novo); err != nil {
+		t.Fatal(err)
+	}
+	if control.Generation() != 2 || !control.MatchesIdentity(newAccountPhone) {
+		t.Fatal("a nova tentativa nao aplicou o numero novo")
+	}
+
+	// O comando da primeira tentativa, se ainda aparecer, chega atrasado.
+	velho := &identityChange{PhoneHash: phoneHashFor(testConnectionID, "5565999990000"), PhoneLast4: "0000"}
+	if _, err := releaser.Release(1, velho); !errors.Is(err, errStaleGeneration) {
+		t.Fatalf("err = %v, want stale", err)
+	}
+	if !control.MatchesIdentity(newAccountPhone) || control.ExpectedLast4() != "7777" {
+		t.Fatal("o comando atrasado reaplicou uma identidade")
+	}
+
+	data, err := os.ReadFile(messagesStorePath)
+	if err != nil || string(data) != "conversas da conexao" {
+		t.Fatalf("o messages.db mudou: %q, %v", data, err)
+	}
+}
+
+func TestOHistoricoDoNumeroNovoSoEntraDepoisDeEleConectar(t *testing.T) {
+	useTempSessionControl(t)
+	useTempLogoutMarker(t)
+	control, err := loadSessionControl(envIdentity())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if control.HistoryKeep() != nil {
+		t.Fatal("sem troca, o historico deixou de entrar inteiro")
+	}
+	releaser := newSessionReleaser(control, &fakeSession{}, newConnectionState(testOrganizationID, testConnectionID), nil)
+	trocar := func(geracao int64, final string, importar bool) {
+		t.Helper()
+		_, err := releaser.Release(geracao, &identityChange{
+			PhoneHash:     phoneHashFor(testConnectionID, "55659999"+final+"0"),
+			PhoneLast4:    final,
+			ImportHistory: importar,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	trocar(1, "7777", false)
+	if keep := control.HistoryKeep(); keep == nil || keep(time.Now()) {
+		t.Fatal("antes de o numero novo conectar, nada do historico pode entrar")
+	}
+
+	agora := time.Date(2026, 10, 10, 18, 0, 0, 0, time.UTC)
+	control.now = func() time.Time { return agora }
+	if err := control.MarkIdentityConfirmed(); err != nil {
+		t.Fatal(err)
+	}
+	keep := control.HistoryKeep()
+	if keep(agora.Add(-time.Second)) {
+		t.Fatal("conversa de antes do pareamento entrou")
+	}
+	if !keep(agora) || !keep(agora.Add(time.Hour)) {
+		t.Fatal("o que chegou depois de conectar ficou de fora")
+	}
+
+	// Reconectar nao move o recorte.
+	control.now = func() time.Time { return agora.Add(24 * time.Hour) }
+	if err := control.MarkIdentityConfirmed(); err != nil {
+		t.Fatal(err)
+	}
+	if !control.HistoryKeep()(agora.Add(time.Minute)) {
+		t.Fatal("a reconexao moveu o recorte e escondeu o que ja era do numero")
+	}
+
+	// O recorte atravessa o reinicio.
+	reloaded, err := loadSessionControl(envIdentity())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reloaded.HistoryKeep()(agora.Add(-time.Second)) || !reloaded.HistoryKeep()(agora.Add(time.Second)) {
+		t.Fatal("o recorte nao sobreviveu ao reinicio")
+	}
+
+	// Desconectar o mesmo numero mantem o recorte; trocar de novo zera.
+	if _, err := releaser.Release(2, nil); err != nil {
+		t.Fatal(err)
+	}
+	if !control.HistoryKeep()(agora.Add(time.Second)) {
+		t.Fatal("a desconexao apagou o recorte do mesmo numero")
+	}
+	trocar(3, "8888", false)
+	if control.HistoryKeep()(agora.Add(48 * time.Hour)) {
+		t.Fatal("o recorte do numero anterior valeu para o novo")
+	}
+
+	// Com importHistory=true, tudo entra, como antes.
+	trocar(4, "9999", true)
+	if control.HistoryKeep() != nil {
+		t.Fatal("importHistory=true deixou de importar tudo")
+	}
+}
+
+func TestKeptHistoryMessagesSoDeixaPassarODepoisDoRecorte(t *testing.T) {
+	recorte := time.Date(2026, 10, 10, 18, 0, 0, 0, time.UTC)
+	mensagem := func(ts int64) *waHistorySync.HistorySyncMsg {
+		return &waHistorySync.HistorySyncMsg{Message: &waWeb.WebMessageInfo{MessageTimestamp: proto.Uint64(uint64(ts))}}
+	}
+	depois := mensagem(recorte.Add(time.Hour).Unix())
+	naHora := mensagem(recorte.Unix())
+	entrada := []*waHistorySync.HistorySyncMsg{
+		depois,
+		nil,
+		{Message: nil},
+		mensagem(0),
+		naHora,
+		mensagem(recorte.Add(-time.Minute).Unix()),
+	}
+	saida := keptHistoryMessages(entrada, func(ts time.Time) bool { return !ts.Before(recorte) })
+	if len(saida) != 2 || saida[0] != depois || saida[1] != naHora {
+		t.Fatalf("saida = %v", saida)
+	}
+	if len(keptHistoryMessages(entrada, func(time.Time) bool { return false })) != 0 {
+		t.Fatal("sem recorte, algo entrou")
+	}
+}
