+func TestStartAfterReleaseWaitsForPortalInsteadOfPairing(t *testing.T) {
+	useTempSessionControl(t)
+	useTempLogoutMarker(t)
+	releaser, _, _ := newTestReleaser(t, &fakeSession{has: true})
+	if _, err := releaser.Release(1, nil); err != nil {
+		t.Fatal(err)
+	}
+	// O processo novo, depois do reinicio.
+	reloaded, err := loadSessionControl(envIdentity())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	state := newConnectionState(testOrganizationID, testConnectionID)
+	client := whatsmeow.NewClient(&store.Device{}, nil)
+	connector := newWhatsAppConnector(client, state, nil)
+	connector.control = reloaded
+
+	if err := connector.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	if got := state.snapshot().Status; got != statusWhatsAppDisconnected {
+		t.Fatalf("status = %q, want %q", got, statusWhatsAppDisconnected)
