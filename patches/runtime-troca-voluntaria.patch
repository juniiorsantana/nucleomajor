+func TestIdentityChangeWithoutSessionSwitchesTheExpectedNumber(t *testing.T) {
+	useTempSessionControl(t)
+	useTempLogoutMarker(t)
+	session := &fakeSession{has: false}
+	releaser, control, _ := newTestReleaser(t, session)
+
+	result, err := releaser.Release(2, &identityChange{
+		PhoneHash:     phoneHashFor(testConnectionID, newAccountPhone),
+		PhoneLast4:    "7777",
+		ImportHistory: false,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.restart || result.RemoteLogout != nil || session.logouts != 0 || session.disconnects != 1 {
+		t.Fatalf("result=%#v logouts=%d disconnects=%d", result, session.logouts, session.disconnects)
+	}
+	if !control.MatchesIdentity(newAccountPhone) || !control.MatchesIdentity("556599997777") {
+		t.Fatal("the new number (with and without the ninth digit) does not match")
+	}
+	if control.MatchesIdentity(oldAccountPhone) {
+		t.Fatal("the old number still matches: pairing it must fall in identity_mismatch")
+	}
+	if control.ExpectedLast4() != "7777" || control.ImportHistory() || !control.ReleasedByOwner() {
+		t.Fatalf("last4=%q import=%v released=%v", control.ExpectedLast4(), control.ImportHistory(), control.ReleasedByOwner())
+	}
+	if !strings.Contains(control.Source(), "geracao 2") {
+		t.Fatalf("source = %q", control.Source())
+	}
+
+	// O numero novo conectou: a liberacao acaba, e o arquivo diz isso.
+	if err := control.ClearRelease(); err != nil {
+		t.Fatal(err)
+	}
+	if control.ReleasedByOwner() || control.Releasing() || readControlFile(t).ReleasedByOwner {
+		t.Fatal("the release survived the connection")
+	}
+}
