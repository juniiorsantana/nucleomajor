+
+type fakeReleaser struct {
+	calls  int
+	change *identityChange
+	result sessionReleaseResult
+	err    error
+}
+
+func (f *fakeReleaser) Release(generation int64, change *identityChange) (sessionReleaseResult, error) {
+	f.calls++
+	f.change = change
+	result := f.result
+	if result.Generation == 0 && f.err == nil {
+		result.Generation = generation
+	}
+	return result, f.err
+}
+
+func newSessionTestHandler(releaser sessionReleaserAPI, restarts *int) http.Handler {
+	mux := http.NewServeMux()
+	state := newConnectionState(testOrganizationID, testConnectionID)
+	registerSessionRoutes(mux, "test-token", state, releaser, func() { *restarts++ })
+	return mux
+}
+
+func sessionRequest(t *testing.T, path string, body interface{}) *http.Request {
+	t.Helper()
+	data, err := json.Marshal(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest(http.MethodPost, path, bytes.NewReader(data))
+	req.Header.Set("Authorization", "Bearer test-token")
+	return req
+}
+
+func decodeSessionBody(t *testing.T, recorder *httptest.ResponseRecorder) map[string]interface{} {
+	t.Helper()
+	var body map[string]interface{}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
+		t.Fatalf("body %q: %v", recorder.Body.String(), err)
+	}
+	return body
+}
+
+func TestSessionRoutesRequireTokenPostAndThisConnection(t *testing.T) {
+	restarts := 0
+	releaser := &fakeReleaser{}
+	handler := newSessionTestHandler(releaser, &restarts)
+
+	unauthorized := httptest.NewRecorder()
+	handler.ServeHTTP(unauthorized, httptest.NewRequest(http.MethodPost, "/api/internal/v1/session/logout", strings.NewReader(`{}`)))
+	if unauthorized.Code != http.StatusUnauthorized {
+		t.Fatalf("unauthorized = %d", unauthorized.Code)
+	}
+
+	get := httptest.NewRecorder()
+	handler.ServeHTTP(get, authorizedRequest(t, http.MethodGet, "/api/internal/v1/session/logout"))
+	if get.Code != http.StatusMethodNotAllowed {
+		t.Fatalf("GET = %d", get.Code)
+	}
+
+	for name, tc := range map[string]struct {
+		path   string
+		body   interface{}
+		status int
+		code   string
+	}{
+		"outra conexao": {"/api/internal/v1/session/logout",
+			map[string]interface{}{"connectionId": "33333333-3333-4333-8333-333333333333", "generation": 1}, http.StatusForbidden, "connection_mismatch"},
+		"campo estranho": {"/api/internal/v1/session/logout",
+			map[string]interface{}{"connectionId": testConnectionID, "generation": 1, "phone": "5565999997777"}, http.StatusBadRequest, "invalid_request"},
+		"geracao zero": {"/api/internal/v1/session/logout",
+			map[string]interface{}{"connectionId": testConnectionID, "generation": 0}, http.StatusBadRequest, "invalid_generation"},
+		"hash invalido": {"/api/internal/v1/session/identity",
+			map[string]interface{}{"connectionId": testConnectionID, "generation": 1, "phoneHash": "abc", "phoneLast4": "7777"}, http.StatusBadRequest, "invalid_identity"},
+		"final invalido": {"/api/internal/v1/session/identity",
+			map[string]interface{}{"connectionId": testConnectionID, "generation": 1, "phoneLast4": "77a7"}, http.StatusBadRequest, "invalid_identity"},
+	} {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, sessionRequest(t, tc.path, tc.body))
+		if recorder.Code != tc.status || decodeSessionBody(t, recorder)["code"] != tc.code {
+			t.Fatalf("%s: status=%d body=%s", name, recorder.Code, recorder.Body.String())
+		}
+	}
+	if releaser.calls != 0 || restarts != 0 {
+		t.Fatalf("a refused request reached the releaser: calls=%d restarts=%d", releaser.calls, restarts)
+	}
+}
+
+func TestSessionRoutesAnswerAppliedStaleAndFailure(t *testing.T) {
+	restarts := 0
+	hash := phoneHashFor(testConnectionID, newAccountPhone)
+
+	applied := &fakeReleaser{result: sessionReleaseResult{Status: "applied", RemoteLogout: true, restart: true}}
+	recorder := httptest.NewRecorder()
+	newSessionTestHandler(applied, &restarts).ServeHTTP(recorder, sessionRequest(t, "/api/internal/v1/session/identity",
+		map[string]interface{}{"connectionId": testConnectionID, "generation": 4, "phoneHash": strings.ToUpper(hash), "phoneLast4": "7777", "importHistory": true}))
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("applied: %d %s", recorder.Code, recorder.Body.String())
+	}
+	session, _ := decodeSessionBody(t, recorder)["session"].(map[string]interface{})
+	if session["status"] != "applied" || session["generation"] != float64(4) || session["remoteLogout"] != true {
+		t.Fatalf("session = %#v", session)
+	}
+	if applied.change == nil || applied.change.PhoneHash != hash || applied.change.PhoneLast4 != "7777" || !applied.change.ImportHistory {
+		t.Fatalf("change = %#v", applied.change)
+	}
+	if strings.Contains(recorder.Body.String(), hash) {
+		t.Fatal("the response echoed the phone hash")
+	}
+	if restarts != 1 {
+		t.Fatalf("restarts = %d after a release that touched a live session", restarts)
+	}
+
+	stale := &fakeReleaser{err: errStaleGeneration}
+	recorder = httptest.NewRecorder()
+	newSessionTestHandler(stale, &restarts).ServeHTTP(recorder, sessionRequest(t, "/api/internal/v1/session/logout",
+		map[string]interface{}{"connectionId": testConnectionID, "generation": 2}))
+	if recorder.Code != http.StatusConflict || decodeSessionBody(t, recorder)["code"] != "stale_generation" {
+		t.Fatalf("stale: %d %s", recorder.Code, recorder.Body.String())
+	}
+
+	failed := &fakeReleaser{err: errors.New("could not drop the session: disk full at /var/lib/x"), result: sessionReleaseResult{restart: true}}
+	recorder = httptest.NewRecorder()
+	newSessionTestHandler(failed, &restarts).ServeHTTP(recorder, sessionRequest(t, "/api/internal/v1/session/logout",
+		map[string]interface{}{"connectionId": testConnectionID, "generation": 5}))
+	if recorder.Code != http.StatusInternalServerError || decodeSessionBody(t, recorder)["code"] != "session_release_failed" {
+		t.Fatalf("failed: %d %s", recorder.Code, recorder.Body.String())
+	}
+	if strings.Contains(recorder.Body.String(), "/var/lib") {
+		t.Fatal("the response leaked the internal error")
+	}
+	if restarts != 2 {
+		t.Fatalf("restarts = %d: a failure after touching the session must restart too", restarts)
+	}
+}
