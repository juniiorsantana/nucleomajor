+class RecusaDiagnosticavelTests(unittest.TestCase):
+    """A recusa precisa dizer o que foi, sem dizer o que estava sendo enviado.
+
+    Nasceu de um apagão de diagnóstico: entre 08 e 10/09/2026 a sincronia de
+    conversas foi recusada quase três mil vezes, e como o erro era sempre a
+    mesma frase não havia como saber, do lado de cá, se era limite de taxa,
+    permissão ou falha do banco.
+    """
+
+    def _verificador(self, directory, resposta):
+        path = Path(directory) / "robot.json"
+        credential(path)
+        return OperatorVerifier(path, session=FakeSession([resposta]))
+
+    def test_o_status_http_aparece_na_recusa(self):
+        with tempfile.TemporaryDirectory() as directory:
+            verificador = self._verificador(directory, FakeResponse(429, {}))
+
+            with self.assertRaises(OperatorVerificationError) as erro:
+                verificador.conversation_sync({"conversas": []})
+
+            self.assertIn("HTTP 429", str(erro.exception))
+            self.assertIn("sincronia de conversas", str(erro.exception))
+
+    def test_o_codigo_do_postgrest_viaja_junto(self):
+        with tempfile.TemporaryDirectory() as directory:
+            verificador = self._verificador(
+                directory, FakeResponse(403, {"code": "42501", "message": "permission denied"})
+            )
+
+            with self.assertRaises(OperatorVerificationError) as erro:
+                verificador.conversation_sync({"conversas": []})
+
+            self.assertIn("HTTP 403", str(erro.exception))
+            self.assertIn("42501", str(erro.exception))
+
+    def test_a_mensagem_do_banco_nao_vaza_para_o_log(self):
+        """O erro termina no journal, e texto livre carrega o que foi enviado."""
+        with tempfile.TemporaryDirectory() as directory:
+            verificador = self._verificador(directory, FakeResponse(400, {
+                "code": "22023",
+                "message": "conversa 556599999999 invalida",
+                "details": "contato: Fulano de Tal",
+            }))
+
+            with self.assertRaises(OperatorVerificationError) as erro:
+                verificador.conversation_sync({"conversas": []})
+
+            texto = str(erro.exception)
+            self.assertNotIn("556599999999", texto)
+            self.assertNotIn("Fulano", texto)
+            self.assertIn("22023", texto)
+
+    def test_codigo_fora_do_formato_e_descartado(self):
+        """Peneira: o que não tem cara de código não entra no log."""
+        with tempfile.TemporaryDirectory() as directory:
+            verificador = self._verificador(
+                directory, FakeResponse(500, {"code": "erro no contato 556599999999"})
+            )
+
+            with self.assertRaises(OperatorVerificationError) as erro:
+                verificador.conversation_sync({"conversas": []})
+
+            self.assertIn("HTTP 500", str(erro.exception))
+            self.assertNotIn("556599999999", str(erro.exception))
+
+    def test_corpo_que_nao_e_json_nao_derruba_a_mensagem(self):
+        class RespostaOpaca:
+            status_code = 502
+
+            def json(self):
+                raise ValueError("not json")
+
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "robot.json"
+            credential(path)
+            verificador = OperatorVerifier(path, session=FakeSession([RespostaOpaca()]))
+
+            with self.assertRaises(OperatorVerificationError) as erro:
+                verificador.conversation_sync({"conversas": []})
+
+            self.assertIn("HTTP 502", str(erro.exception))
+
+    def test_a_reserva_de_comandos_ganha_o_mesmo_detalhe(self):
+        with tempfile.TemporaryDirectory() as directory:
+            verificador = self._verificador(directory, FakeResponse(429, {"code": "PGRST301"}))
+
+            with self.assertRaises(OperatorVerificationError) as erro:
+                verificador.runtime_commands_claim(5, "instancia")
+
+            self.assertIn("reserva de comandos do runtime", str(erro.exception))
+            self.assertIn("HTTP 429", str(erro.exception))
+            self.assertIn("PGRST301", str(erro.exception))
+
