+def _detalhe_da_recusa(response: Any) -> str:
+    """O suficiente para diagnosticar a recusa, e nada além disso.
+
+    Sem isto, toda recusa vira a mesma frase e a causa some: em 08-10/09/2026 a
+    sincronia de conversas foi recusada quase três mil vezes e não havia como
+    saber se era 429, 403 ou 500 sem abrir o Supabase do lado de lá.
+
+    Status sempre; o `code` do PostgREST quando vier e couber no formato. A
+    MENSAGEM fica de fora de propósito: é texto livre, pode carregar o que foi
+    enviado — telefone, nome, trecho de conversa — e este erro termina no
+    journal. Um 429 e um 42501 se distinguem pelo código; nenhum dos dois
+    precisa do corpo para ser entendido.
+    """
+    detalhe = f"HTTP {response.status_code}"
+    try:
+        corpo = response.json()
+    except ValueError:
+        return detalhe
+    if not isinstance(corpo, dict):
+        return detalhe
+    codigo = str(corpo.get("code") or "").strip()
+    if codigo and CODIGO_DE_ERRO_RE.fullmatch(codigo):
+        return f"{detalhe}, código {codigo}"
+    return detalhe
 
 
