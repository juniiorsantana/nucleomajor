+class HandoffAutomaticoTest(unittest.TestCase):
+    """O handoff que o runtime dá em si mesmo, e por que ele vence.
+
+    Nasceu de um silêncio real: em 06/09/2026 o modelo saiu com 1 no meio de um
+    turno de cliente, o runtime entregou a conversa a um humano que nunca
+    existiu, e ela ficou muda até 11/09 — dez mensagens, nenhuma resposta. O
+    handoff estava certo; o que faltava era ele saber acabar.
+
+    A regra em uma frase: handoff com prazo é do runtime e vence; handoff sem
+    prazo é de gente e não vence.
+    """
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.arbitro = Arbitro(Path(self.tmp.name) / "arbitro.db")
+        self.arbitro.definir_ia(CONN_A, True)
+        self.arbitro.definir_dono(CONN_A, CONTATO, DONO_IA)
+
+    def tearDown(self):
+        self.arbitro.close()
+        self.tmp.cleanup()
+
+    def _vencer(self, contato=CONTATO):
+        """Empurra o vencimento para o passado, como o tempo faria.
+
+        E como o tempo, só mexe em prazo que existe: uma sessão sem `dono_ate`
+        continua sem, porque relógio nenhum cria vencimento onde ninguém pôs.
+        """
+        with self.arbitro._db as db:
+            db.execute(
+                "UPDATE conversa_sessao SET dono_ate = ?"
+                " WHERE contato = ? AND dono_ate IS NOT NULL",
+                ("2020-01-01T00:00:00.000+00:00", contato),
+            )
+
+    def test_enquanto_o_prazo_corre_a_ia_continua_calada(self):
+        self.arbitro.assumir_por_falha(CONN_A, CONTATO, MOTIVO_FALHA_DO_MODELO)
+        d = self.arbitro.decidir(CONN_A, CONTATO)
+        self.assertFalse(d.responder)
+        self.assertEqual(d.motivo, IGNORADO_HANDOFF)
+
+    def test_vencido_o_prazo_a_ia_volta_sozinha(self):
+        self.arbitro.assumir_por_falha(CONN_A, CONTATO, MOTIVO_FALHA_DO_CONTEXTO)
+        self._vencer()
+
+        d = self.arbitro.decidir(CONN_A, CONTATO)
+        self.assertTrue(d.responder, "ninguém assumiu, e o cliente não pode ficar mudo")
+        self.assertEqual(d.motivo, PODE_RESPONDER)
+        self.assertEqual(self.arbitro.sessao_aberta(CONN_A, CONTATO).dono, DONO_IA)
+
+    def test_a_retomada_apaga_o_prazo_e_nao_se_repete(self):
+        self.arbitro.assumir_por_falha(CONN_A, CONTATO)
+        self._vencer()
+        self.arbitro.decidir(CONN_A, CONTATO)
+
+        sessao = self.arbitro.sessao_aberta(CONN_A, CONTATO)
+        self.assertIsNone(sessao.dono_ate)
+        self.assertTrue(self.arbitro.decidir(CONN_A, CONTATO).responder)
+
+    def test_handoff_de_gente_nao_tem_prazo_e_nao_vence(self):
+        """A garantia oposta, e a mais importante das duas.
+
+        Um atendente que assumiu não pode perder a conversa para um relógio.
+        """
