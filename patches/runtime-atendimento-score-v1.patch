@@ -0,0 +1,138 @@
+"""As perguntas do Atendimento Score v1 (att_*) que o Jev responde.
+
+Os cenários semânticos da especificação (seção 17, de 5 a 18) dependem de o
+Jev entender a conversa: não dá para prová-los aqui. O que estes testes
+prendem é que cada regra da especificação está escrita na pergunta que o Jev
+recebe, com os estados certos, e que o playbook efetivo chega a ela. A
+calibração com conversas reais vem depois, com as leituras gravadas.
+"""
+
+import unittest
+from datetime import date
+
+import jev_framework as j
+
+ESTADOS = {"bom", "atencao", "ruim", "critico", "nao_avaliado"}
+PLAYBOOK_DA_EMPRESA = {
+    "origem": "empresa", "version": 3, "segmento": "Agência",
+    "oferta": [{"nome": "Site", "preco": "Faixa de R$ 3 a 6 mil; valor fechado só no diagnóstico"}],
+    "clienteIdeal": {"atende": ["investe ao menos 1 mil em anúncios"], "naoAtende": ["quem só quer orçamento"]},
+    "objecoes": [{"chave": "preco", "nome": "Preço", "resposta": "Passar a faixa e levar ao diagnóstico"}],
+    "criterios": [{"chave": "perguntou_ads", "pergunta": "Perguntou quanto investe em anúncios?", "sim": "Perguntou"}],
+}
+
+
+def perguntas(playbook=None):
+    return {p.chave: p for p in j.montar_perguntas(playbook, None, hoje=date(2026, 10, 2))}
+
+
+class EstruturaTests(unittest.TestCase):
+    def test_as_oito_perguntas_com_os_estados_da_especificacao(self):
+        p = perguntas()
+        for chave in ("att_discovery", "att_conversation_coherence", "att_communication_adaptation",
+                      "att_qualification", "att_playbook_adherence", "att_objection_handling"):
+            self.assertEqual(p[chave].tipo, "choice")
+            self.assertEqual(set(p[chave].criterios), ESTADOS, chave)
+        self.assertEqual(set(p["att_next_step"].criterios), {
+            "avancou_com_acao", "aguardando_acao_do_lead", "desqualificado_com_motivo", "ainda_em_descoberta", "ficou_em_aberto"})
+        self.assertEqual(set(p["att_follow_up"].criterios), {"not_due", "done", "overdue", "not_applicable"})
+        self.assertEqual(j.FRAMEWORK_VERSION, "major-v2")
+
+    def test_cabem_no_teto_do_banco_mesmo_com_playbook_e_jeito(self):
+        cheio = {**PLAYBOOK_DA_EMPRESA, "proximosPassos": [{"chave": "diag", "nome": "Diagnóstico"}],
+                 "criterios": [{"chave": f"c{i}x", "pergunta": f"Pergunta número {i}?"} for i in range(8)]}
+        todas = j.montar_perguntas(cheio, "direto")
+        self.assertLessEqual(len(todas), j.LIMITE_DE_PERGUNTAS)
+        self.assertTrue({"att_next_step", "att_follow_up", "segue_o_jeito"} <= {p.chave for p in todas})
+
+    def test_a_resposta_do_jev_e_normalizada_como_as_outras(self):
+        p = perguntas()["att_next_step"]
+        r = j.normalizar(p, {"type": "choice", "choice": "ficou_em_aberto", "probabilities": {"ficou_em_aberto": 0.81, "avancou_com_acao": 0.1}})
+        self.assertEqual((r["question"], r["answer"], r["probability"]), ("att_next_step", "ficou_em_aberto", 0.81))
+        self.assertIsNone(j.normalizar(p, {"type": "choice", "choice": "talvez"}))
+
+
+class RegrasNasPerguntasTests(unittest.TestCase):
+    """Cada regra da especificação, no texto que o Jev lê."""
+
+    def setUp(self):
+        self.p = perguntas()
+
+    def texto(self, chave):
+        pergunta = self.p[chave]
+        return pergunta.instrucao + " " + " ".join(f"{k}: {v}" for k, v in pergunta.criterios.items())
+
+    def test_descoberta_avalia_resultado_e_nao_quantidade(self):
+        t = self.texto("att_discovery")
+        self.assertIn("não a quantidade de perguntas", t)  # [6]
+        self.assertIn("se o lead já explicou tudo sozinho, não precisava perguntar de novo", t)  # [5]
+        self.assertIn("muitas perguntas sem chegar a entender", t)  # [6]
+
+    def test_coerencia(self):
+        t = self.texto("att_conversation_coherence")
+        self.assertIn("Repete pergunta já respondida", t)  # [7]
+        self.assertIn("recomendação precipitada", t)  # [8]
+        self.assertIn("hipótese com cuidado", t)  # [9]
+        self.assertIn("NÃO é recomendação", t)  # [9]
+
+    def test_comunicacao_olha_padrao_e_nao_uma_mensagem(self):
+        t = self.texto("att_communication_adaptation")
+        self.assertIn("insiste em áudio com quem só escreve", t)  # [10]
+        self.assertIn("Uma única mensagem fora do padrão não basta para uma penalização forte", t)  # [11]
+        self.assertIn("textos longos seguidos", t)  # [12]
+
+    def test_qualificacao_e_trabalho_do_atendente(self):
+        t = self.texto("att_qualification")
+        self.assertIn("não se o lead é bom", t)
+        self.assertIn("ainda não era hora de perguntar", t)  # [13]
+        self.assertIn("se recusou a responder no WhatsApp (por exemplo, o orçamento), isso NÃO é falha", t)  # [14]
+        self.assertIn("levou a um passo comercial errado", t)  # [15]
+
+    def test_playbook_sem_regra_nao_e_violacao(self):
+        t = self.texto("att_playbook_adherence")
+        self.assertIn("Se a estratégia da empresa não define uma regra", t)  # [17]
+        self.assertIn("NÃO é violação", t)  # [17]
+        self.assertIn("Não avalie se a objeção foi vencida", t)
+
+    def test_proximo_passo_e_follow_up(self):
+        self.assertIn("esperando o lead", self.texto("att_next_step"))  # [20]
+        self.assertIn("ficou no limbo", self.texto("att_next_step"))  # [22]
+        self.assertIn("O lead não tem fit", self.texto("att_next_step"))  # [21]
+        follow = self.texto("att_follow_up")
+        self.assertIn("Hoje é 02/10/2026.", follow)
+        self.assertIn("o prazo ainda não chegou", follow)  # [23]
+        self.assertIn("o prazo já passou e ele não foi feito", follow)  # [25]
+
+
+class PlaybookEfetivoTests(unittest.TestCase):
+    def test_sem_playbook_da_empresa_vale_o_base_major(self):
+        for vindo_do_banco in (None, {"origem": "base_major", "version": 0, "regras": list(j.REGRAS_BASE_MAJOR)}):
+            contexto = j.contexto_do_playbook(vindo_do_banco)
+            self.assertIn("Playbook Base Major", contexto)
+            self.assertIn("Não criar regra específica de preço se a empresa não tiver definido uma.", contexto)  # [17]
+            self.assertNotIn("R$", contexto)
+            self.assertIn(contexto, perguntas(vindo_do_banco)["att_playbook_adherence"].instrucao)
+
+    def test_o_da_empresa_prevalece(self):
+        # [16] e [18]: a regra da empresa (faixa permitida, valor fechado só no
+        # diagnóstico) chega inteira ao Jev, e o Base Major não entra.
+        p = perguntas(PLAYBOOK_DA_EMPRESA)
+        for chave in ("att_playbook_adherence", "att_qualification"):
+            texto = p[chave].instrucao
+            self.assertIn("Estratégia definida pela empresa:", texto)
+            self.assertIn("Faixa de R$ 3 a 6 mil; valor fechado só no diagnóstico", texto)
+            self.assertIn("Passar a faixa e levar ao diagnóstico", texto)
+            self.assertIn("investe ao menos 1 mil em anúncios", texto)
+            self.assertNotIn("Playbook Base Major", texto)
+
+    def test_playbook_da_empresa_vazio_nao_inventa_regra(self):
+        contexto = j.contexto_do_playbook({"origem": "empresa", "version": 1})
+        self.assertIn("não penalize comportamento que ela não definiu", contexto)
+
+    def test_texto_do_playbook_tem_teto(self):
+        enorme = {**PLAYBOOK_DA_EMPRESA, "objecoes": [{"chave": f"o{i}x", "nome": f"Objeção {i}", "resposta": "x" * 300} for i in range(12)]}
+        self.assertLessEqual(len(j.contexto_do_playbook(enorme)), j.TETO_DO_PLAYBOOK)
+
+
+if __name__ == "__main__":
+    unittest.main()
