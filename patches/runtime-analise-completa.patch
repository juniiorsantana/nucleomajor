+def resumo_do_lead(notas: Any) -> str:
+    """A nota do lead pronta, ponto por ponto, para o Claude explicar."""
+    lead = _dict(_dict(notas).get("lead"))
+    if not lead:
+        return ""
+    if lead.get("score") is None:
+        return "Nota do lead: ainda não avaliável (nenhum ponto com dado suficiente)."
+    fatores = _dict(lead.get("stateFactors")) or FATORES_PADRAO
+    avaliado, maximo = lead.get("evaluatedWeight") or 0, lead.get("maxWeight") or 0
+    cobertura = round(100 * avaliado / maximo) if maximo else 0
+    linhas = [
+        f"Nota do lead: {lead['score']}/100, faixa \"{faixa_do_lead(lead['score'])}\" "
+        f"({avaliado} de {maximo} de peso avaliado, cobertura de {cobertura}%). Ela mede o lead, não a equipe.",
+    ]
+    if cobertura < 50:
+        linhas.append("Cobertura baixa: não trate a nota do lead como conclusiva.")
+    for dimensao in lead.get("dimensions") or []:
+        if not isinstance(dimensao, dict):
+            continue
+        chave = str(dimensao.get("key") or "")
+        estado = _estado_pelo_fator(dimensao.get("factor"), fatores)
+        valor = _texto(_dict((dimensao.get("criteria") or [{}])[0]).get("value"), 40)
+        linha = f"- {NOMES_DOS_CRITERIOS_DO_LEAD.get(chave, chave)} ({chave}, peso {dimensao.get('weight')}): {estado}"
+        if dimensao.get("points") is not None:
+            linha += f", {dimensao.get('points')} de {dimensao.get('weight')}"
+        if valor and valor != estado:
+            linha += f" [resposta: {valor}]"
+        linhas.append(linha)
+    return "\n".join(linhas)
+
