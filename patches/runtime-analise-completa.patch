+def veredito_do_cruzamento(notas: Any) -> str:
+    """A mesma regra de private.veredito_do_cruzamento: a chave do quadro."""
+    atendimento, lead = _dict(_dict(notas).get("atendimento")), _dict(_dict(notas).get("lead"))
