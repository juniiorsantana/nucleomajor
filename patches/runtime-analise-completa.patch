+"""A Análise Completa (migration 20261010100000) no runtime.
+
+O que estes testes prendem:
+  * com a régua v3, o Jev recebe as perguntas do vendedor e as duas do lead
+    (lead_objection, lead_fit), cabendo no teto do banco; com a v2, nada muda;
+  * o pedido ao Claude depende do tipo: atendimento (o vendedor), lead (a
+    qualidade do lead) e completa (os dois e o veredito do cruzamento, que
+    segue a mesma regra do banco);
+  * a resposta volta conferida, com o porquê do lead só dos pontos avaliados e
+    o lado de cada ação.
+"""
+
+import json
+import tempfile
+import unittest
+from datetime import date
+from pathlib import Path
+from unittest.mock import patch
+
+import analista
+import jev_framework as j
+import runner
+from test_vendedor_v2 import CARGA_V2, NOTAS_V2, PLAYBOOK_V2, relatorio_v2
+
+
+def lead(chave, peso, fator, valor):
+    return {"key": chave, "weight": peso, "factor": fator, "points": None if fator is None else round(peso * fator, 2),
+            "criteria": [{"key": chave, "value": valor, "factor": fator}]}
+
+
+NOTAS_V3 = {
+    **NOTAS_V2,
+    "lead": {
+        "score": 83, "points": 79, "evaluatedWeight": 95, "maxWeight": 100,
+        "stateFactors": {"bom": 1.0, "atencao": 0.6, "ruim": 0.2, "critico": 0.0},
+        "dimensions": [
+            lead("need", 20, 1.0, "sim"), lead("intent", 20, 1.0, "comprar_agora"), lead("urgency", 15, 0.6, "este_mes"),
+            lead("decision", 15, 0.6, "outra_pessoa"), lead("engagement", 15, 1.0, "quente"),
+            lead("objection", 10, 0.6, "contornavel"), lead("fit", 5, None, "nao_avaliado"),
+        ],
+    },
+}
+PLAYBOOK_V3 = {**PLAYBOOK_V2, "regua": "atendimento.v3",
+               "clienteIdeal": {"atende": ["Renda a partir de R$ 5 mil"], "naoAtende": ["Quer data de contemplação"]}}
+CARGA_COMPLETA = {**CARGA_V2, "kind": "completa", "scores": NOTAS_V3, "playbook": PLAYBOOK_V3}
+CARGA_LEAD = {**CARGA_COMPLETA, "kind": "lead"}
+
+
+def relatorio_completo(**sobrepor):
+    dados = relatorio_v2(
+        lead_verdict="Quer comprar e tem pressa (#2), mas depende da esposa.",
+        lead_why=[
+            {"criterion": "decision", "explanation": "Precisa ver com a esposa.", "evidence": [2]},
+            {"criterion": "fit", "explanation": "Não avaliado, não deveria vir.", "evidence": []},
+            {"criterion": "decision", "explanation": "Repetido.", "evidence": []},
+            {"criterion": "outra_coisa", "explanation": "Observação geral do lead.", "evidence": []},
+        ],
+        matrix_explanation="Lead bom e atendimento abaixo do corte: venda escorrendo.",
+        what_to_do_now=[
+            {"priority": "alta", "action_type": "reply", "title": "Retomar com o casal", "instruction": "x", "reason": "y",
+             "due_at": None, "side": "atendimento", "evidence": [3]},
+            {"priority": "media", "action_type": "create_task", "title": "Marcar lead quente", "instruction": "x", "reason": "y",
+             "due_at": None, "side": "lead", "evidence": []},
+            {"priority": "baixa", "action_type": "review", "title": "Sem lado", "instruction": "x", "reason": "y",
+             "due_at": None, "side": "outro", "evidence": []},
+        ],
+    )
+    dados.update(sobrepor)
+    return dados
+
+
+class PerguntasV3Tests(unittest.TestCase):
+    def chaves(self, playbook):
+        return [p.chave for p in j.montar_perguntas(playbook, "direto", hoje=date(2026, 10, 4))]
+
+    def test_v3_tem_vendedor_e_lead_e_cabe_no_teto(self):
+        chaves = self.chaves(PLAYBOOK_V3)
+        self.assertIn("vnd_advance", chaves)
+        self.assertIn("lead_objection", chaves)
+        self.assertIn("lead_fit", chaves)
+        self.assertIn("intencao", chaves)  # base, usada pela nota do lead
+        self.assertFalse(any(c.startswith("att_") for c in chaves))
+        self.assertLessEqual(len(chaves), j.LIMITE_DE_PERGUNTAS)
+        self.assertIn("pb_c7x", chaves)  # cabe com os 8 critérios próprios e o jeito
+        self.assertEqual(j.FRAMEWORK_VERSION, "major-v4")
+
+    def test_v2_continua_sem_as_do_lead(self):
+        chaves = self.chaves(PLAYBOOK_V2)
+        self.assertIn("vnd_advance", chaves)
+        self.assertNotIn("lead_objection", chaves)
+
+    def test_encaixe_recebe_o_cliente_ideal(self):
+        p = {x.chave: x for x in j.montar_perguntas(PLAYBOOK_V3, None, hoje=date(2026, 10, 4))}
+        self.assertIn("Renda a partir de R$ 5 mil", p["lead_fit"].instrucao)
+        self.assertEqual(set(p["lead_fit"].criterios), {"dentro", "parcial", "fora", "nao_avaliado"})
+        self.assertEqual(set(p["lead_objection"].criterios), {"nenhuma", "contornavel", "forte", "impeditiva", "nao_avaliado"})
+        r = j.normalizar("lead_objection", {"type": "choice", "choice": "forte", "probabilities": {"forte": 0.7}})
+        self.assertEqual((r["question"], r["answer"]), ("lead_objection", "forte"))
+
+
+class PromptPorTipoTests(unittest.TestCase):
+    def test_completa_tem_as_duas_notas_e_o_veredito(self):
+        prompt = analista.montar_prompt(CARGA_COMPLETA, hoje=date(2026, 10, 4))
+        self.assertIn("Nota do vendedor: 45/100", prompt)
+        self.assertIn('Nota do lead: 83/100, faixa "Bom" (95 de 100 de peso avaliado, cobertura de 95%)', prompt)
+        self.assertIn("- Quem decide (decision, peso 15): atencao, 9.0 de 15 [resposta: outra_pessoa]", prompt)
+        self.assertIn("Veredito do cruzamento (pelo corte de 75 nas duas notas): Oportunidade em risco [em_risco].", prompt)
+        self.assertIn("análise completa", prompt)
+        self.assertIn('"side": "atendimento|lead"', prompt)
+        self.assertIn('"matrix_explanation"', prompt)
+        self.assertIn("UMA lista só, pelos dois lados", prompt)
+        self.assertEqual(analista.sistema_da_analise(CARGA_COMPLETA), analista.SISTEMA_COMPLETA)
+        self.assertIn("e a QUALIDADE DO LEAD", analista.SISTEMA_COMPLETA)
+
+    def test_lead_so_tem_a_nota_do_lead(self):
+        prompt = analista.montar_prompt(CARGA_LEAD, hoje=date(2026, 10, 4))
+        self.assertIn("Nota do lead: 83/100", prompt)
+        self.assertNotIn("Nota do vendedor", prompt)
+        self.assertNotIn("Veredito do cruzamento", prompt)
+        self.assertIn("análise do lead", prompt)
+        self.assertNotIn('"did_well"', prompt)
+        self.assertEqual(analista.sistema_da_analise(CARGA_LEAD), analista.SISTEMA_LEAD)
+
+    def test_atendimento_na_v3_continua_so_o_vendedor(self):
+        carga = {**CARGA_COMPLETA, "kind": "atendimento"}
+        prompt = analista.montar_prompt(carga, hoje=date(2026, 10, 4))
+        self.assertIn("Nota do vendedor", prompt)
+        self.assertNotIn("Nota do lead", prompt)
+        self.assertEqual(analista.sistema_da_analise(carga), analista.SISTEMA_V2)
+
+    def test_o_veredito_segue_a_regra_do_banco(self):
+        def notas(vend, ld, cobertura=100):
+            return {"atendimento": {"score": vend, "evaluatedWeight": cobertura, "maxWeight": 100},
+                    "lead": {"score": ld, "evaluatedWeight": 100, "maxWeight": 100}}
+        self.assertEqual(analista.veredito_do_cruzamento(notas(80, 80)), "avancar")
+        self.assertEqual(analista.veredito_do_cruzamento(notas(60, 80)), "em_risco")
+        self.assertEqual(analista.veredito_do_cruzamento(notas(80, 60)), "nutrir_ou_soltar")
+        self.assertEqual(analista.veredito_do_cruzamento(notas(60, 60)), "revisar_processo")
+        self.assertEqual(analista.veredito_do_cruzamento(notas(80, 80, 49)), "sem_conclusao")
+        self.assertEqual(analista.veredito_do_cruzamento(notas(75, 75)), "avancar")
+        self.assertEqual(analista.veredito_do_cruzamento({}), "sem_conclusao")
+
+
+class LeituraCompletaTests(unittest.TestCase):
+    def test_le_e_confere_a_completa(self):
+        r = analista.ler_resultado(json.dumps(relatorio_completo()), CARGA_COMPLETA)
+        self.assertEqual(r["formatVersion"], 5)
+        self.assertEqual(r["lead_verdict"], "Quer comprar e tem pressa, mas depende da esposa.")
+        self.assertEqual(r["matrix_explanation"], "Lead bom e atendimento abaixo do corte: venda escorrendo.")
+        self.assertEqual([a.get("side") for a in r["what_to_do_now"]], ["atendimento", "lead", None])
+        self.assertEqual([m["criterion"] for m in r["lead_why"]], ["decision", "fit", None])
+        r, descartes = analista.conferir_com_os_estados(r, NOTAS_V3)
+        self.assertEqual([m["criterion"] for m in r["lead_why"]], ["decision", None])
+        self.assertEqual(descartes["lead_why"], 1)
+
+    def test_lead_nao_tem_explicacao_do_cruzamento(self):
+        r = analista.ler_resultado(json.dumps(relatorio_completo()), CARGA_LEAD)
+        self.assertIn("lead_why", r)
+        self.assertNotIn("matrix_explanation", r)
+
+    def test_atendimento_nao_ganha_campos_do_lead(self):
+        r = analista.ler_resultado(json.dumps(relatorio_completo()), {**CARGA_COMPLETA, "kind": "atendimento"})
+        self.assertNotIn("lead_why", r)
+        self.assertEqual(r["formatVersion"], 4)
+
+
+class FakeVerifier:
+    def __init__(self):
+        self.gravadas = []
+
+    def analysis_record(self, payload):
+        self.gravadas.append(payload)
+        return {"recorded": True}
+
+
+class AnalistaCompletaTests(unittest.TestCase):
+    def test_completa_de_ponta_a_ponta(self):
+        pasta = tempfile.TemporaryDirectory()
+        self.addCleanup(pasta.cleanup)
+        conta = Path(pasta.name) / "analise"
+        conta.mkdir()
+        (conta / ".credentials.json").write_text("{}", encoding="utf-8")
+        recebido = {}
+
+        def executar(prompt, claude_bin, vault, timeout, **kwargs):
+            recebido.update(kwargs, prompt=prompt)
+            return runner.RunResult(reply=json.dumps(relatorio_completo()), session_id=None, exit_code=0, duration_ms=10, tools_used=[])
+
+        verifier = FakeVerifier()
+        with patch.object(analista.audit, "log") as log:
+            a = analista.Analista(verifier=verifier, executar=executar, claude_bin="claude", vault=Path(pasta.name),
+                                  config_dir=conta, modelo="sonnet")
+            self.assertEqual(a.analisar(CARGA_COMPLETA), "done")
+        self.assertEqual(recebido["system_prompt"], analista.SISTEMA_COMPLETA)
+        resultado = verifier.gravadas[-1]["result"]
+        self.assertEqual(resultado["lead_why"][0]["criterion"], "decision")
+        feito = [c.kwargs for c in log.call_args_list if c.args and c.args[0] == "analysis.done"][0]
+        self.assertEqual((feito["kind"], feito["lead_score"], feito["service_score"]), ("completa", 83, 45))
+
+
+if __name__ == "__main__":
+    unittest.main()
