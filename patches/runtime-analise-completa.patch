+def faixa_do_lead(nota: Any) -> str:
+    if not isinstance(nota, (int, float)) or isinstance(nota, bool):
+        return ""
+    return next(rotulo for minimo, rotulo in FAIXAS_DO_LEAD if nota >= minimo)
