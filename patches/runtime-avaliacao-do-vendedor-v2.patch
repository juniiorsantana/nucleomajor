+"""A Avaliação do vendedor v2 (migration 20261008100000) no runtime.
+
+O que estes testes prendem:
+  * com a régua v2 em vigor (`regua` no playbook), o Jev recebe as perguntas
+    vnd_* no lugar das att_*, cabendo no teto do banco, e cada uma com o que
+    ela precisa (playbook, próximos passos da empresa, data de hoje);
+  * sem a régua v2, nada muda: as perguntas e o pedido ao Claude são os da v1;
+  * o Analista pede o analysis_report.v2 (veredito, o que fez bem, o que custou
+    a venda, crítica e "o que um vendedor top teria feito" por ponto), com o
+    tom combinado, e a resposta volta conferida contra os estados da nota.
+"""
+
+import json
+import tempfile
+import unittest
+from datetime import date
+from pathlib import Path
+from unittest.mock import patch
+
+import analista
+import jev_framework as j
+import runner
+
+PLAYBOOK_V2 = {
+    "origem": "empresa", "version": 1, "regua": "atendimento.v2", "segmento": "Consórcio (Ademicon)",
+    "objecoes": [{"chave": "falar_com_conjuge", "nome": "Preciso falar com meu marido/esposa",
+                  "resposta": "Incluir o decisor numa conversa com o casal"}],
+    "proximosPassos": [{"chave": "enviar_simulacao", "nome": "Enviar simulação personalizada"},
+                       {"chave": "conversa_com_casal", "nome": "Conversa com o casal (decisores)"}],
+    "criterios": [{"chave": f"c{i}x", "pergunta": f"Pergunta própria número {i}?"} for i in range(8)],
+}
+ESTADOS = {"bom", "atencao", "ruim", "critico", "nao_avaliado"}
+
+
