+    def test_cada_pergunta_recebe_o_que_precisa(self):
+        p = self.perguntas(PLAYBOOK_V2)
+        self.assertIn("Preciso falar com meu marido/esposa", p["vnd_objection"].instrucao)
+        self.assertIn("Estratégia definida pela empresa", p["vnd_diagnosis"].instrucao)
