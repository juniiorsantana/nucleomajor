+class LeituraV2Tests(unittest.TestCase):
+    def test_le_o_relatorio_v2(self):
+        r = analista.ler_resultado(json.dumps(relatorio_v2()), CARGA_V2)
+        self.assertEqual((r["schema_version"], r["formatVersion"]), ("analysis_report.v2", 4))
+        self.assertEqual(r["verdict"], "Mandou a simulação, ouviu 'vou ver com minha esposa' e deixou o cliente sem caminho.")
+        self.assertEqual(r["did_well"], [{"title": "Respondeu em 4 minutos", "evidence_message_ids": ["M1"]}])
+        self.assertEqual(r["cost_the_sale"][0]["evidence_message_ids"], ["M3"])
+        motivos = {m["criterion"]: m for m in r["why_this_score"]}
+        self.assertEqual(len([m for m in r["why_this_score"] if m["criterion"] == "advance"]), 1)
+        self.assertTrue(motivos["advance"]["better"].startswith("Te ligo amanhã"))
+        self.assertIsNone(motivos["speed"]["better"])  # "null" escrito vira nulo
+        self.assertEqual(motivos["objection"]["evidence_message_ids"], ["M2", "M3"])
+        self.assertNotIn("repeated_communication_mismatch", [f["code"] for f in r["red_flags"]])
+
+    def test_confere_com_os_estados_da_v2(self):
+        r = analista.ler_resultado(json.dumps(relatorio_v2()), CARGA_V2)
+        r, descartes = analista.conferir_com_os_estados(r, NOTAS_V2)
+        self.assertEqual([f["code"] for f in r["red_flags"]], ["conversation_left_open"])
+        self.assertNotIn("close", [m["criterion"] for m in r["why_this_score"]])
+        self.assertEqual(descartes, {"red_flags": 1, "why_this_score": 1})
