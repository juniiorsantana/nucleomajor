+    def test_sem_a_regua_v2_nada_muda(self):
+        for playbook in (None, {"origem": "empresa", "regua": "atendimento.v1"}, {"origem": "base_major"}):
+            p = self.perguntas(playbook)
+            self.assertIn("att_next_step", p)
+            self.assertFalse(any(c.startswith("vnd_") for c in p))
