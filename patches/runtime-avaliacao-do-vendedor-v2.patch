+class AnalistaV2Tests(unittest.TestCase):
+    def test_analisa_na_v2_com_o_sistema_da_v2(self):
+        pasta = tempfile.TemporaryDirectory()
+        self.addCleanup(pasta.cleanup)
+        conta = Path(pasta.name) / "analise"
+        conta.mkdir()
+        (conta / ".credentials.json").write_text("{}", encoding="utf-8")
+        recebido = {}
+
+        def executar(prompt, claude_bin, vault, timeout, **kwargs):
+            recebido.update(kwargs, prompt=prompt)
+            return runner.RunResult(reply=json.dumps(relatorio_v2()), session_id=None, exit_code=0, duration_ms=10, tools_used=[])
+
+        verifier = FakeVerifier()
+        with patch.object(analista.audit, "log") as log:
+            a = analista.Analista(verifier=verifier, executar=executar, claude_bin="claude", vault=Path(pasta.name),
+                                  config_dir=conta, modelo="sonnet")
+            self.assertEqual(a.analisar(CARGA_V2), "done")
+        self.assertEqual(recebido["system_prompt"], analista.SISTEMA_V2)
+        resultado = verifier.gravadas[-1]["result"]
+        self.assertEqual(resultado["schema_version"], "analysis_report.v2")
+        self.assertEqual([f["code"] for f in resultado["red_flags"]], ["conversation_left_open"])
+        feito = [c.kwargs for c in log.call_args_list if c.args and c.args[0] == "analysis.done"][0]
+        self.assertEqual(feito["report"], "analysis_report.v2")
+        bruto = json.dumps([c.kwargs for c in log.call_args_list], ensure_ascii=False, default=str)
+        self.assertNotIn("esposa", bruto)
