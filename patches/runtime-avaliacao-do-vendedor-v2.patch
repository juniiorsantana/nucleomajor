+        vnd = {c for c in p if c.startswith("vnd_")}
+        self.assertEqual(vnd, {"vnd_advance", "vnd_diagnosis", "vnd_objection", "vnd_leads", "vnd_close",
+                               "vnd_follow_up", "vnd_empathy", "vnd_promises"})
