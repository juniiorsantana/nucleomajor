+                    connection_id=connection_id or None,
+                    session_id=session_id,
+                    via="whatsapp",
+                    stage=etapa,
+                )
+                return "human_active"
+
+        if self.arbitro is not None and connection_id:
+            if not self.arbitro.ia_ativa(connection_id):
