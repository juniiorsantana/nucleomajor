+class DonoEIaNoMesmoSegundoTest(PresencaHumanaTest):
+    """13/09/2026: o dono respondeu no mesmo segundo em que a IA enviava.
+
+    Herda o `setUp` da classe acima (e roda os casos dela de novo, o que é
+    barato e prova que nada ali mudou de sentido).
+    """
+
+    def test_a_conversa_de_13_09_tem_gente(self):
+        """Linha do tempo real, em segundos relativos ao envio da IA.
+
+        "Eaaae" um segundo antes, "Um instante…" e a resposta no mesmo segundo,
+        "Simmm" um segundo depois. A regra antiga (hora OU texto, 20 s) lia as
+        duas mensagens do dono como da IA, e a IA seguia falando.
+        """
+        self._mensagem(self._atras(segundos=2), texto="Eaaae")
+        self.presenca.anotar_saida_do_agente(TELEFONE, "Um instante, estou vendo isso.")
+        self.presenca.anotar_saida_do_agente(TELEFONE, "Eai! Show, nos vemos daqui a pouco")
+        self._mensagem(self._atras(segundos=1), texto="Um instante, estou vendo isso.", chat=LID)
+        self._mensagem(self._atras(segundos=1), texto="Eai! Show, nos vemos daqui a pouco", chat=LID)
+        self._mensagem(self._atras(segundos=2), texto="Eaaae", chat=LID)
+        self._mensagem(self._atras(segundos=0), texto="Simmm", chat=LID)
+        self.assertIsNotNone(
+            self.presenca.ultima_resposta_humana(LID, 30, tambem=(TELEFONE,))
+        )
+
+    def test_so_as_mensagens_da_ia_no_mesmo_segundo_nao_tem_gente(self):
+        self.presenca.anotar_saida_do_agente(TELEFONE, "Um instante, estou vendo isso.")
+        self.presenca.anotar_saida_do_agente(TELEFONE, "Eai! Show")
+        self._mensagem(self._atras(segundos=1), texto="Um instante, estou vendo isso.", chat=LID)
+        self._mensagem(self._atras(segundos=1), texto="Eai! Show", chat=LID)
+        self.assertIsNone(
+            self.presenca.ultima_resposta_humana(LID, 30, tambem=(TELEFONE,))
+        )
+
+    def test_mesmo_texto_muito_depois_e_gente(self):
+        """O "ok" que a IA mandou há meia hora não torna nosso o "ok" de agora."""
+        self.presenca.anotar_saida_do_agente(CHAT, "ok")
+        self._mensagem(self._atras(minutos=30), texto="ok")
+        self.assertIsNotNone(self.presenca.ultima_resposta_humana(CHAT, 60))
+
+    def test_midia_sem_texto_longe_do_envio_e_gente(self):
+        """Áudio mandado do celular 30 s depois da IA é de gente."""
+        self.presenca.anotar_saida_do_agente(CHAT, "claro")
+        self._mensagem(self._atras(segundos=30), texto="")
+        self.assertIsNotNone(self.presenca.ultima_resposta_humana(CHAT, 30))
+
+    def test_desde_ignora_o_que_veio_antes_do_marco(self):
+        """Depois de devolvida para a IA, a conversa não sai de novo pelo que já passou."""
