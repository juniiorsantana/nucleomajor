+    def _conversa_saiu_da_ia(
+        self,
+        batch: List[Pending],
+        run_id: str,
+        *,
+        etapa: str,
+        checar_rajada: bool = False,
+    ) -> str:
+        """Esta conversa ainda é da IA? Devolve o motivo de não ser, ou vazio.
+
+        Existe porque em 13/09/2026 a porta de entrada decidiu e o turno seguiu
+        sozinho: o dono respondeu o amigo pelo celular às 09:13:05, e a IA
+        enviou às 09:13:06 e às 09:13:16 respostas que já estavam a caminho.
+
+        Três perguntas, na ordem do que é mais grave errar:
+
+        1. alguém da equipe escreveu depois da primeira mensagem deste lote (ou
+           depois de a conversa ter voltado para a IA)? Se sim, a conversa passa
+           para a equipe aqui mesmo — a próxima mensagem já chega ignorada;
+        2. o freio de mão foi puxado, ou a sessão mudou de dono no meio (alguém
+           assumiu pelo portal)?
+        3. com `checar_rajada`, o mesmo contato mandou mensagem nova que está na
+           fila? A resposta foi pensada sem ela.
+
+        Falha aberto como a presença: sem banco, sem árbitro ou sem hora legível,
+        a pergunta correspondente responde "ainda é da IA".
+        """
+        first = batch[0]
+        contato = first.sender or first.chat_jid
+        connection_id = first.connection_id
+        horas = float(getattr(self.cfg, "human_takeover_lookback_hours", 0.0) or 0.0)
+
+        if self.presenca is not None and horas > 0:
+            desde = None
+            for item in batch:
+                quando = self.presenca.instante_da_mensagem(item.wa_id or item.message_id, item.chat_jid)
+                if quando is not None and (desde is None or quando < desde):
+                    desde = quando
+            if desde is None:
+                # Sem a hora da mensagem, só o que é recente: o que veio antes
+                # dela a porta de entrada já viu.
+                desde = datetime.now(timezone.utc) - timedelta(minutes=2)
+            if self.arbitro is not None and connection_id:
+                marco = self.arbitro.marco_da_ia(connection_id, contato)
+                if marco is not None and marco > desde:
+                    desde = marco
+            humano_em = self.presenca.ultima_resposta_humana(
+                first.chat_jid, horas * 60, tambem=(first.sender,), desde=desde
+            )
+            if humano_em is not None:
+                session_id = None
+                if self.arbitro is not None and connection_id:
+                    session_id = self.arbitro.assumir_pela_equipe(connection_id, contato).id
+                audit.log(
+                    "conversation.team_took_over",
