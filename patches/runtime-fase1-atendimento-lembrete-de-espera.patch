+    def assumir_pela_equipe(
+        self,
+        connection_id: str,
+        contato: str,
+        motivo: str = MOTIVO_EQUIPE_RESPONDEU,
+    ) -> Sessao:
+        """Alguém da equipe escreveu nesta conversa. A IA sai até devolverem.
+
+        Sem prazo, ao contrário de `assumir_por_falha`: aqui existe uma pessoa
+        do outro lado, e decisão de gente não vence por relógio. Substitui a
+        pausa de 30 minutos (`pausar_por_humano`), que devolvia a conversa à IA
+        no meio de um atendimento.
+
+        Não pisa em quem já está registrado: uma conversa atribuída a alguém
+        pelo portal continua dela, e uma que a equipe já assumiu não é reescrita
+        a cada mensagem. O handoff automático (com prazo) e o pedido do cliente
+        viram atendimento da equipe — é exatamente o que aconteceu.
+        """
+        with self._lock:
+            atual = self._sessao(self._linha_aberta(self._db, connection_id, contato))
+        if (
+            atual is not None
+            and atual.dono == DONO_HUMANO
+            and not atual.dono_ate
+            and (str(atual.atendente_id or "").strip() or atual.motivo in MOTIVOS_DA_EQUIPE)
+        ):
+            return atual
+        return self.definir_dono(connection_id, contato, DONO_HUMANO, motivo)
