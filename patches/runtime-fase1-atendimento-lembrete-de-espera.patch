+    def _chegou_mensagem_nova(self, batch: List[Pending]) -> bool:
+        """O mesmo contato escreveu de novo enquanto este turno rodava?
+
+        A mensagem nova já passou pela porta de entrada e está na fila deste
+        worker. "Eai mano" e "Tdo certo pra hoje?", com 19 s entre elas, viraram
+        duas respostas em 13/09/2026; descartar a primeira deixa o próximo turno
+        responder as duas, com a primeira no histórico.
+        """
+        first = batch[0]
+        ids = {item.message_id for item in batch}
+        with self.queue.mutex:
+            pendentes = list(self.queue.queue)
+        return any(
+            isinstance(item, Pending)
+            and item.chat_jid == first.chat_jid
+            and item.connection_id == first.connection_id
+            and item.message_id not in ids
+            for item in pendentes
+        )
+
