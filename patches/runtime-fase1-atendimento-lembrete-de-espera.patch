+class EquipeAssumeTest(unittest.TestCase):
+    """A equipe escreveu: a conversa é dela até alguém devolver (13/09/2026).
+
+    Substitui a pausa de 30 minutos. O dono respondeu um amigo pelo celular, a
+    IA continuou falando, e meia hora depois voltaria de qualquer jeito.
+    """
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.arbitro = Arbitro(Path(self.tmp.name) / "arbitro.db")
+        self.arbitro.definir_ia(CONN_A, True)
+        self.arbitro.definir_dono(CONN_A, CONTATO, DONO_IA)
+
+    def tearDown(self):
+        self.arbitro.close()
+        self.tmp.cleanup()
+
+    def test_a_equipe_assume_sem_prazo(self):
+        sessao = self.arbitro.assumir_pela_equipe(CONN_A, CONTATO)
+        self.assertEqual(sessao.dono, DONO_HUMANO)
+        self.assertEqual(sessao.motivo, MOTIVO_EQUIPE_RESPONDEU)
+        self.assertIsNone(sessao.dono_ate)
+        d = self.arbitro.decidir(CONN_A, CONTATO)
+        self.assertFalse(d.responder)
+        self.assertEqual(d.motivo, IGNORADO_HANDOFF)
+
+    def test_conversa_atribuida_a_alguem_nao_e_reescrita(self):
+        self.arbitro.assumir(CONN_A, CONTATO, "atribuído pelo portal", "a-1", "Aline")
+        sessao = self.arbitro.assumir_pela_equipe(CONN_A, CONTATO)
+        self.assertEqual(sessao.atendente_nome, "Aline")
+        self.assertEqual(sessao.motivo, "atribuído pelo portal")
+
+    def test_handoff_por_falha_vira_da_equipe_e_perde_o_prazo(self):
+        """Com prazo, a conversa voltaria à IA no meio do atendimento de gente."""
+        self.arbitro.assumir_por_falha(CONN_A, CONTATO)
+        sessao = self.arbitro.assumir_pela_equipe(CONN_A, CONTATO)
+        self.assertIsNone(sessao.dono_ate)
+        self.assertEqual(sessao.motivo, MOTIVO_EQUIPE_RESPONDEU)
