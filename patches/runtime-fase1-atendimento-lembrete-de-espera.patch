+    def marco_da_ia(self, connection_id: str, contato: str) -> Optional[datetime]:
+        """Desde quando a IA responde esta conversa sem ninguém da equipe no meio.
+
+        O mais recente entre a devolução para a IA da sessão aberta e o
+        encerramento da sessão anterior. O que a equipe escreveu antes disso já
+        foi decidido: encerrar ou devolver é o gesto de quem terminou.
+        """
+        with self._lock:
+            aberta = self._linha_aberta(self._db, connection_id, contato)
+            fechada = self._db.execute(
+                "SELECT fechada_em FROM conversa_sessao"
+                " WHERE connection_id = ? AND contato = ? AND fechada_em IS NOT NULL"
+                " ORDER BY fechada_em DESC LIMIT 1",
+                (str(connection_id), str(contato)),
+            ).fetchone()
+        marcos = []
+        for bruto in (
+            aberta["devolvida_em"] if aberta is not None else None,
+            fechada["fechada_em"] if fechada is not None else None,
+        ):
+            if not bruto:
+                continue
+            try:
+                quando = datetime.fromisoformat(str(bruto))
+            except ValueError:
+                continue
+            marcos.append(quando if quando.tzinfo else quando.replace(tzinfo=timezone.utc))
+        return max(marcos) if marcos else None
