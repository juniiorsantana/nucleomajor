+"""A primeira linha que diz quem escreveu, no WhatsApp de quem recebe.
+
+A queixa que originou isto (13/09/2026): "não dá para saber, nas mensagens,
+quem escreveu". Do lado do portal a resposta é uma coluna nova no banco; do
+lado do CONTATO não há coluna nenhuma — o WhatsApp dele mostra uma conversa com
+um número, e tudo que sai da empresa chega igual, venha da IA, do atendente ou
+do celular do dono. A única forma de o contato saber é o próprio texto dizer.
+
+Formato, decidido pelo dono: nome em negrito na primeira linha, texto a partir
+da segunda.
+
+    *Bia:*
+    Oi! Tudo bem?
+
+Linha própria, e não `*Bia:* Oi!` na mesma linha, porque em texto longo o nome
+se perderia no começo do parágrafo — e a maioria das respostas que importam
+(preço, prazo, endereço) é longa.
+
+**O limite físico, que nenhuma versão deste arquivo resolve:** mensagem digitada
+no aplicativo do celular sai direto do aparelho, sem passar por lugar nenhum do
+runtime, e não tem como ganhar assinatura. É por isso que a regra do dono é
+"mensagem sem registro de autor foi do celular, e fica sem nome" — e não um
+rótulo "celular", que seria um palpite.
+
+**Por que existe `remover`.** O histórico da conversa volta ao prompt a cada
+turno (`messages.fetch_recent_history`), lido cru do `messages.db` — ou seja,
+COM a assinatura. Doze mensagens começando por `*Bia:*` ensinam o modelo a
+escrevê-la sozinho, e aí ela sai de dentro do texto, fora do controle deste
+arquivo, em mensagem que talvez nem seja da Bia. O histórico entra sem
+assinatura; quem assina é o runtime, no último passo antes do envio.
+"""
+
+from __future__ import annotations
+
+import re
+
+# Teto do nome na assinatura.
+#
+# `assistant_profiles.display_name` aceita até 100 e `profiles.display_name`
+# não tem teto curto, mas uma assinatura de 100 caracteres ocuparia a bolha
+# inteira no celular de quem recebe. Cortar é melhor do que recusar: uma
+# mensagem sem nome é pior do que uma com nome abreviado.
+NOME_MAXIMO = 40
+
+# A assinatura como ela é escrita e como ela é reconhecida.
+#
+# Estrita de propósito: linha inteira, nome sem asterisco nem quebra dentro,
+# dois-pontos antes do fecho. Uma expressão frouxa aqui apagaria a primeira
+# linha de uma mensagem legítima que por acaso começasse em negrito — o
+# contrário de perder uma assinatura, que não machuca ninguém.
+ASSINATURA_RE = re.compile(r"^\*([^*\r\n]{1,%d}):\*(?:\r?\n|$)" % NOME_MAXIMO)
+
+
+def limpar_nome(nome: str) -> str:
+    """O nome pronto para entrar na assinatura, ou vazio se não houver nome.
+
+    Tira o que quebraria o formato: asterisco (que desmontaria o negrito),
+    dois-pontos no fim (que viraria `*Bia::*`) e qualquer quebra de linha, que
+    transformaria a assinatura em duas linhas e o resto da mensagem em parte
+    dela.
+    """
+    texto = str(nome or "")
+    texto = texto.replace("*", "").replace("\r", " ").replace("\n", " ")
+    texto = re.sub(r"\s+", " ", texto).strip().rstrip(":").strip()
+    return texto[:NOME_MAXIMO]
+
+
+def aplicar(texto: str, nome: str) -> str:
+    """Põe a assinatura na frente do texto. Sem nome, devolve o texto igual.
+
+    Nunca assina duas vezes: se o texto já começa por uma assinatura — porque o
+    modelo a imitou, apesar do cuidado de `remover` — a dele é trocada pela
+    nossa, que é a única que sabe de verdade quem está escrevendo.
+
+    Texto vazio continua vazio. Uma mensagem que é só assinatura não diz nada e
+    o envio já a recusaria; devolvê-la aqui só trocaria o erro de lugar.
+    """
+    corpo = str(texto or "")
+    limpo = limpar_nome(nome)
+    if not limpo or not corpo.strip():
+        return corpo
+    return f"*{limpo}:*\n{remover(corpo).lstrip()}"
+
+
+def remover(texto: str) -> str:
+    """Tira a assinatura da frente do texto, se houver uma.
+
+    Uma só, e só no começo: o que vem depois é conteúdo, e uma linha no meio da
+    mensagem que se pareça com assinatura é o contato falando, não nós.
+    """
+    corpo = str(texto or "")
+    return ASSINATURA_RE.sub("", corpo, count=1)
+
+
+def nome_assinado(texto: str) -> str:
+    """O nome que está assinando este texto, ou vazio. Para teste e diagnóstico."""
+    achado = ASSINATURA_RE.match(str(texto or ""))
+    return achado.group(1) if achado else ""
