+        # Fechado aqui dentro, e não por `addCleanup`: a limpeza do diretório
+        # temporário roda no `tearDown`, ANTES dos cleanups, e no Windows um
+        # SQLite ainda aberto prende o arquivo — o teste passaria e a limpeza
+        # quebraria, que é a pior combinação para quem for ler o resultado.
+        presenca = PresencaHumana(messages_db=self.messages_db, registro=registro)
+        try:
