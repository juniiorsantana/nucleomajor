+        foram gravadas pelo único caminho que anotava até aqui, o envio
+        automático. Marcá-las de outra coisa faria a IA parar de reconhecer as
+        próprias respostas das últimas 48 h e se calar sozinha.
+        """
+        registro = self.root / "antigo.db"
+        banco = sqlite3.connect(registro)
+        banco.execute(
+            "CREATE TABLE saida_do_agente (chat TEXT NOT NULL, quando TEXT NOT NULL,"
+            " texto TEXT NOT NULL DEFAULT '')"
+        )
+        banco.execute(
+            "INSERT INTO saida_do_agente (chat, quando, texto) VALUES (?, ?, ?)",
+            (TELEFONE,
+             datetime.now(timezone.utc).isoformat(timespec="milliseconds"),
+             "resposta de ontem"),
