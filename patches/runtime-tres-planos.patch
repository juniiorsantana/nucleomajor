+++ b/scripts/vps/test_connection_operators.py
@@ -0,0 +1,163 @@
+"""Testes de scripts/vps/connection-operators.sh.
+
+O script roda de verdade, num HOME descartável, com o systemctl substituído por
+um dublê que só anota a chamada.
+
+Rodar:
+  python -m unittest scripts/vps/test_connection_operators.py -v
+"""
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from test_provision_connection import BASH, CONEXAO, _posix  # mesmos dublês e conversões
+
+SCRIPT = Path(__file__).resolve().parent / "connection-operators.sh"
+DONO = "5565988887777"
+
+
+@unittest.skipIf(BASH is None, "bash indisponível")
+class ConnectionOperatorsTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.home = self.tmp / "home"
+        self.bin = self.tmp / "bin"
+        self.log = self.tmp / "systemctl.log"
+        self.politica = self.home / ".local/share/nucleo-major/whatsapp" / CONEXAO / "config.json"
+        self.politica.parent.mkdir(parents=True)
+        self.bin.mkdir(parents=True)
+        self._escrever(
+            {
+                "allowed_recipients": [DONO],
+                "allow_unlisted": False,
+                "allowed_media_dirs": ["outbox"],
+                "assistant": {
+                    "enabled": True,
+                    "owner": DONO,
+                    "operators": [],
+                    "notify_url": "http://127.0.0.1:8103/inbound",
+                    "customer_inbound": True,
+                    "customer_reply_window_seconds": 900,
+                },
+            }
+        )
+        python = _posix(Path(sys.executable))
+        self._executavel("systemctl", f'#!/usr/bin/env bash\necho "$*" >> "{_posix(self.log)}"\n')
+        self._executavel("python3", f'#!/usr/bin/env bash\nexport PYTHONIOENCODING=utf-8\nexec "{python}" "$@"\n')
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _executavel(self, nome: str, conteudo: str) -> None:
+        caminho = self.bin / nome
+        caminho.write_text(conteudo, encoding="utf-8", newline="\n")
+        caminho.chmod(0o755)
+
+    def _escrever(self, politica: dict) -> None:
+        self.politica.write_text(json.dumps(politica), encoding="utf-8")
+
+    def _ler(self) -> dict:
+        return json.loads(self.politica.read_text(encoding="utf-8"))
+
+    def _reinicios(self) -> list[str]:
+        if not self.log.exists():
+            return []
+        return [l for l in self.log.read_text(encoding="utf-8").splitlines() if l.strip()]
+
+    def rodar(self, *args: str) -> subprocess.CompletedProcess:
+        usuario = subprocess.run([BASH, "-c", "id -un"], capture_output=True, text=True, encoding="utf-8").stdout.strip()
+        env = {
+            **os.environ,
+            "HOME": _posix(self.home),
+            "SERVICE_USER": usuario,
+            "JSON_PY": _posix(self.bin / "python3"),
+            "SYSTEMCTL": _posix(self.bin / "systemctl"),
+        }
+        separador = ";" if os.name == "nt" else ":"
+        env["PATH"] = str(self.bin) + separador + os.environ.get("PATH", "")
+        return subprocess.run(
+            [BASH, _posix(SCRIPT), CONEXAO, *args],
+            capture_output=True, text=True, encoding="utf-8", env=env, timeout=60,
+        )
+
+    def test_add_poe_o_operador_na_lista_e_nos_destinos(self) -> None:
+        r = self.rodar("add", "(65) 97777-6666")
+        self.assertEqual(r.returncode, 0, r.stderr + r.stdout)
+        politica = self._ler()
+        self.assertEqual(politica["assistant"]["operators"], ["5565977776666"])
+        # Sem estar nos destinos, o operador falaria e não seria respondido.
+        self.assertEqual(politica["allowed_recipients"], ["5565977776666", DONO])
+        self.assertEqual(politica["allow_unlisted"], False)
+        self.assertEqual(self._reinicios(), [f"--user restart whatsapp-bridge@{CONEXAO}.service"])
+
+    def test_add_repetido_nao_duplica_nem_reinicia(self) -> None:
+        self.assertEqual(self.rodar("add", "5565977776666").returncode, 0)
+        self.log.unlink()
+        r = self.rodar("add", "5565977776666")
+        self.assertEqual(r.returncode, 0, r.stderr)
+        self.assertIn("Nada a fazer", r.stdout)
+        self.assertEqual(self._ler()["assistant"]["operators"], ["5565977776666"])
+        self.assertEqual(self._reinicios(), [])
+
+    def test_remove_tira_dos_dois_lugares(self) -> None:
+        self.rodar("add", "5565977776666")
+        self.rodar("add", "5565966665555")
+        r = self.rodar("remove", "5565977776666")
+        self.assertEqual(r.returncode, 0, r.stderr + r.stdout)
+        politica = self._ler()
+        self.assertEqual(politica["assistant"]["operators"], ["5565966665555"])
+        self.assertEqual(politica["allowed_recipients"], ["5565966665555", DONO])
+
+    def test_o_dono_nao_sai_por_aqui(self) -> None:
+        r = self.rodar("remove", DONO)
+        self.assertEqual(r.returncode, 1)
+        self.assertIn("--atualizar --dono", r.stderr)
+        self.assertIn(DONO, self._ler()["allowed_recipients"])
+
+    def test_listar_mostra_quem_esta_la(self) -> None:
+        self.assertIn("nenhum operador", self.rodar("listar").stdout)
+        self.rodar("add", "5565977776666")
+        r = self.rodar("listar")
+        self.assertEqual(r.returncode, 0)
+        self.assertIn("5565977776666", r.stdout)
+        # Listar não mexe em nada.
+        self.assertEqual(self._reinicios(), [f"--user restart whatsapp-bridge@{CONEXAO}.service"])
+
+    def test_conexao_sem_ia_e_recusada(self) -> None:
+        politica = self._ler()
+        politica["assistant"]["enabled"] = False
+        self._escrever(politica)
+        r = self.rodar("add", "5565977776666")
+        self.assertEqual(r.returncode, 1)
+        self.assertIn("desligado", r.stderr)
+        self.assertEqual(self._ler()["assistant"]["operators"], [])
+        self.assertEqual(self._reinicios(), [])
+
+    def test_entradas_invalidas_param_antes_de_gravar(self) -> None:
+        for args, pedaco in (
+            (("add", "123"), "telefone inválido"),
+            (("add",), "informe o telefone"),
+            (("mexer", "5565977776666"), "ação inválida"),
+        ):
+            r = self.rodar(*args)
+            self.assertEqual(r.returncode, 1, args)
+            self.assertIn(pedaco, r.stderr, args)
+        self.assertEqual(self._ler()["assistant"]["operators"], [])
+
+    def test_conexao_sem_politica_e_recusada(self) -> None:
+        self.politica.unlink()
+        r = self.rodar("listar")
+        self.assertEqual(r.returncode, 1)
+        self.assertIn("planos com IA", r.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
