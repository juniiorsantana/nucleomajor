+#!/usr/bin/env bash
+#
+# Monta na VPS a conexão de WhatsApp que um cliente pediu pelo portal.
+#
+# O pedido nasce no portal (`nucleo_connection_request`, migration
+# 20260921100000 do nucleomajor): a linha em `whatsapp_connections` já existe,
+# com status `created`, e o e-mail do pedido traz este comando pronto. Este
+# script faz o resto — que antes eram nove passos à mão (scripts/vps/README.md):
+# portas livres, os dois .env, store e vault, o api_token do Bridge, o
+# connections.json, a credencial do robô, as duas units — e marca a conexão
+# como `awaiting_pairing`. Quando o heartbeat chega, o QR aparece no portal.
+#
+# Uso, como o usuário `nucleo`, de dentro da release ativa:
+#
+#   bash scripts/vps/provision-connection.sh <organization-id> <connection-id> \
+#     --plano base|atendimento|completo [--telefone 5565999999999] \
+#     [--dono 5565988887777] [--equipe "Ana,Bruno"] [--fuso America/Sao_Paulo] \
+#     [--operadores 5565988887777,5565977776666] [--atualizar] [--dry-run]
+#
+# OS TRÊS PLANOS (os interruptores vêm do banco, ver 20260920100000):
+#
+#   base         sem IA nenhuma;
+#   atendimento  a IA responde os CLIENTES FINAIS (`ai_customer`);
+#   completo     também a equipe fala com o assistente (`ai_team`).
+#
+# O script confere no banco se o plano da empresa bate com o `--plano` pedido.
+#
+# PLANO BASE = SEM IA, e isto é garantido aqui, não só no banco:
+#
+#   * o Bridge sobe com a política padrão (`assistant.enabled=false`, ver
+#     whatsapp-bridge/policy.go): nenhuma mensagem é entregue ao assistente.
+#     O espelho de conversas lê o SQLite do Bridge direto, então Conversas,
+#     QR e envio pelo portal funcionam do mesmo jeito;
+#   * `ASSISTANT_CLAUDE_BIN=/bin/false` no .env do assistente. Sem isso, a unit
+#     apontaria para o `claude` da máquina, que sem CLAUDE_CONFIG_DIR usaria o
+#     login padrão — o da Major. O EnvironmentFile vence o Environment= da unit.
+#
+# NOS PLANOS COM IA:
+#
+#   * o Bridge recebe uma política escrita por este script, com o assistente
+#     ligado, `customer_inbound` e o `notify_url` na porta DESTE assistente
+#     (o default do Bridge é a 8090, que é a da Major);
+#   * no `atendimento`, o `owner` da política é o NÚMERO DA PRÓPRIA CONEXÃO:
+#     mensagem do próprio número chega como `IsFromMe` e é descartada, então
+#     não existe turno de dono nem de operador — só cliente;
+#   * no `completo`, o `owner` é o celular do dono e os operadores entram em
+#     `--operadores` (ou depois, por scripts/vps/connection-operators.sh);
+#   * o Claude usa a conta da Major, com login PRÓPRIO desta conexão em
+#     `~/.config/claude/<conexão>` (o CLAUDE_CONFIG_DIR nunca é compartilhado:
+#     dois processos no mesmo diretório brigam pela renovação do token);
+#   * o freio de mão da IA (`ia_ativa` no arbitro.db) é ligado aqui.
+#
+# Idempotente: rodar de novo depois de uma falha continua de onde parou e não
+# sobrescreve nada que já exista. Para mudar um plano já provisionado, use
+# `--atualizar`: ele reescreve as chaves do .env e a política do Bridge, e
+# reinicia as duas units. A service_role é pedida uma vez, sem eco, nunca vai
+# para a linha de comando de outro processo e não é gravada.
+set -euo pipefail
+
+UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
+
+falhar() {
+  echo "ERRO: $*" >&2
+  exit 1
+}
+
+ORGANIZATION_ID="$(printf '%s' "${1:-}" | tr 'A-F' 'a-f')"
+CONNECTION_ID="$(printf '%s' "${2:-}" | tr 'A-F' 'a-f')"
+if [[ ! "$ORGANIZATION_ID" =~ $UUID_RE ]] || [[ ! "$CONNECTION_ID" =~ $UUID_RE ]]; then
+  echo "uso: $0 <organization-id> <connection-id> --plano base|atendimento|completo [--telefone <numero>] [--dono <numero>] [--atualizar] [--dry-run]" >&2
+  exit 2
+fi
+shift 2
+
+PLANO=""
+TELEFONE=""
+DONO=""
+EQUIPE="atendente"
+FUSO="America/Sao_Paulo"
+OPERADORES=""
+ROTEAMENTO=""
+DRY_RUN=0
+ATUALIZAR=0
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    --plano) PLANO="${2:-}"; shift 2 ;;
+    --telefone) TELEFONE="${2:-}"; shift 2 ;;
+    --dono) DONO="${2:-}"; shift 2 ;;
+    --equipe) EQUIPE="${2:-}"; shift 2 ;;
+    --fuso) FUSO="${2:-}"; shift 2 ;;
+    --operadores) OPERADORES="${2:-}"; shift 2 ;;
+    --roteamento) ROTEAMENTO="${2:-}"; shift 2 ;;
+    --atualizar) ATUALIZAR=1; shift ;;
+    --dry-run) DRY_RUN=1; shift ;;
+    *) echo "opção desconhecida: $1" >&2; exit 2 ;;
+  esac
+done
+
+case "$PLANO" in
+  base|atendimento|completo) ;;
+  *) falhar "plano inválido: '${PLANO:-nenhum}'. Use base, atendimento ou completo." ;;
+esac
+COM_IA=0
+[ "$PLANO" = "base" ] || COM_IA=1
+COM_EQUIPE=0
+[ "$PLANO" = "completo" ] && COM_EQUIPE=1
+
+# O celular do dono é para onde vão os avisos de transferência, e no completo é
+# quem pode acionar o assistente. Sem ele, os avisos iriam para o chat da
+# empresa com ela mesma.
+DIGITOS_DONO=""
+if [ "$COM_IA" -eq 1 ]; then
+  if [ -z "$DONO" ]; then
+    read -rp 'Celular pessoal do dono da empresa (recebe os avisos de transferência): ' DONO
+  fi
+  DIGITOS_DONO="$(printf '%s' "$DONO" | tr -cd '0-9')"
+  if [ "${#DIGITOS_DONO}" -eq 10 ] || [ "${#DIGITOS_DONO}" -eq 11 ]; then
+    DIGITOS_DONO="55$DIGITOS_DONO"
+  fi
+  [[ "$DIGITOS_DONO" =~ ^[1-9][0-9]{9,14}$ ]] || falhar "--dono inválido: informe o celular com DDD"
+fi
+
+EXPECTED_USER="${SERVICE_USER:-nucleo}"
+if [ "$(id -u)" -eq 0 ] || [ "$(id -un)" != "$EXPECTED_USER" ]; then
+  falhar "execute como o usuário $EXPECTED_USER, nunca como root"
+fi
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+PYTHON_BIN="${PYTHON_BIN:-$HOME/.venvs/whatsapp-mcp-server/bin/python}"
+SYSTEMCTL="${SYSTEMCTL:-systemctl}"
+JSON_PY="${JSON_PY:-python3}"
+
+STORE_DIR="$HOME/.local/share/nucleo-major/whatsapp/$CONNECTION_ID"
+VAULT_DIR="$HOME/.local/share/nucleo-major/vault/$CONNECTION_ID"
+STATE_DIR="$HOME/.local/state/whatsapp-assistant/$CONNECTION_ID"
+CONNECTION_ENV="$HOME/.config/whatsapp-connections/$CONNECTION_ID.env"
+ASSISTANT_ENV="$HOME/.config/whatsapp-assistant/$CONNECTION_ID.env"
+CREDENTIAL="$STATE_DIR/supabase-robot.json"
+CONNECTIONS_JSON="$STATE_DIR/connections.json"
+CLAUDE_DIR="$HOME/.config/claude/$CONNECTION_ID"
+POLITICA="$STORE_DIR/config.json"
+BRIDGE_UNIT="whatsapp-bridge@$CONNECTION_ID.service"
+ASSISTANT_UNIT="whatsapp-assistant@$CONNECTION_ID.service"
+
+json() {
+  # json <arquivo-ou-> <expressao-python sobre `d`>
+  "$JSON_PY" -c 'import json,sys
+d = json.load(sys.stdin if sys.argv[1] == "-" else open(sys.argv[1], encoding="utf-8"))
+v = eval(sys.argv[2], {"d": d})
+print("" if v is None else v)' "$1" "$2"
+}
+
+# ------------------------------------------------------------------ o número
+if [ -z "$TELEFONE" ]; then
+  read -rp 'Número do WhatsApp do cliente, com DDD: ' TELEFONE
+fi
+DIGITOS="$(printf '%s' "$TELEFONE" | tr -cd '0-9')"
+if [ "${#DIGITOS}" -eq 10 ] || [ "${#DIGITOS}" -eq 11 ]; then
+  DIGITOS="55$DIGITOS"
+fi
+if ! [[ "$DIGITOS" =~ ^[1-9][0-9]{9,14}$ ]]; then
+  falhar "número inválido: informe com DDD"
+fi
+FINAL4="${DIGITOS: -4}"
+
+# ------------------------------------------------------------------ o Supabase
+# URL e chave publicável saem de uma credencial de robô que já existe nesta
+# máquina (a da Major); a service_role, só da digitação.
+if [ -z "${SUPABASE_URL:-}" ] || [ -z "${SUPABASE_PUBLISHABLE_KEY:-}" ]; then
+  MODELO=""
+  for candidato in "$HOME"/.local/state/whatsapp-assistant/*/supabase-robot.json; do
+    [ -r "$candidato" ] || continue
+    case "$candidato" in */"$CONNECTION_ID"/*) continue ;; esac
+    MODELO="$candidato"
+    break
+  done
+  [ -n "$MODELO" ] || falhar "nenhuma credencial de robô existente para tirar a URL do Supabase; defina SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY"
+  SUPABASE_URL="$(json "$MODELO" 'd["supabase_url"]')"
+  SUPABASE_PUBLISHABLE_KEY="$(json "$MODELO" 'd["publishable_key"]')"
+fi
+SUPABASE_URL="${SUPABASE_URL%/}"
+
+if [ -z "${SUPABASE_SERVICE_ROLE_KEY:-}" ]; then
+  read -rsp 'Cole a service_role do Supabase e pressione Enter: ' SUPABASE_SERVICE_ROLE_KEY
+  echo
+fi
+[ -n "$SUPABASE_SERVICE_ROLE_KEY" ] || falhar "service_role vazia"
+trap 'unset SUPABASE_SERVICE_ROLE_KEY' EXIT
+
+# A chave vai para o curl pela entrada padrão (--config -), nunca pela linha
+# de comando: argumento de processo aparece para qualquer um no `ps`.
+rest() {
+  local metodo="$1" caminho="$2" corpo="${3:-}"
+  local cabecalhos
+  cabecalhos="header = \"apikey: $SUPABASE_SERVICE_ROLE_KEY\""
+  if [ "$(printf '%s' "$SUPABASE_SERVICE_ROLE_KEY" | tr -cd '.' | wc -c)" -eq 2 ]; then
+    cabecalhos="$cabecalhos
+header = \"Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY\""
+  fi
+  if [ -n "$corpo" ]; then
+    printf '%s\n' "$cabecalhos" | curl -fsS --config - -X "$metodo" \
+      -H 'Content-Type: application/json' -H 'Prefer: return=representation' \
+      --data "$corpo" "$SUPABASE_URL/rest/v1/$caminho"
+  else
+    printf '%s\n' "$cabecalhos" | curl -fsS --config - -X "$metodo" \
+      "$SUPABASE_URL/rest/v1/$caminho"
+  fi
+}
+
+# ------------------------------------------------ o pedido existe e é este?
+PEDIDO="$(rest GET "whatsapp_connections?id=eq.$CONNECTION_ID&select=id,organization_id,name,status,expected_phone_hash,expected_phone_last4")" \
+  || falhar "não foi possível ler a conexão no Supabase"
+[ "$(printf '%s' "$PEDIDO" | json - 'len(d)')" = "1" ] || falhar "conexão $CONNECTION_ID não existe no banco"
+[ "$(printf '%s' "$PEDIDO" | json - 'd[0]["organization_id"]')" = "$ORGANIZATION_ID" ] \
+  || falhar "a conexão não pertence à organização informada"
+STATUS_NO_BANCO="$(printf '%s' "$PEDIDO" | json - 'd[0]["status"]')"
+[ "$STATUS_NO_BANCO" != "revoked" ] || falhar "a conexão está revogada"
+NOME_DA_CONEXAO="$(printf '%s' "$PEDIDO" | json - 'd[0]["name"]')"
+EMPRESA="$(rest GET "organizations?id=eq.$ORGANIZATION_ID&select=name" | json - 'd[0]["name"] if d else ""')"
+[ -n "$EMPRESA" ] || falhar "organização não encontrada"
+HASH_ESPERADO="$(printf '%s' "$PEDIDO" | json - 'd[0]["expected_phone_hash"] or ""')"
+if [ -n "$HASH_ESPERADO" ]; then
+  HASH_DIGITADO="$(printf '%s' "$CONNECTION_ID:$DIGITOS" | sha256sum | cut -d' ' -f1)"
+  [ "$HASH_DIGITADO" = "$HASH_ESPERADO" ] \
+    || falhar "o número digitado não é o do pedido (o pedido termina em $(printf '%s' "$PEDIDO" | json - 'd[0]["expected_phone_last4"]'))"
+fi
+
+# ------------------------------------------------ o plano é mesmo sem IA?
+ASSINATURA="$(rest GET "organization_subscriptions?organization_id=eq.$ORGANIZATION_ID&select=plan_code,status")" \
+  || falhar "não foi possível ler a assinatura"
+PLANO_NO_BANCO="$(printf '%s' "$ASSINATURA" | json - 'd[0]["plan_code"] if d else ""')"
+[ -n "$PLANO_NO_BANCO" ] || falhar "a organização não tem assinatura"
+RECURSOS="$(rest GET "saas_plans?code=eq.$PLANO_NO_BANCO&select=features")" || falhar "não foi possível ler o plano"
+IA_CLIENTES="$(printf '%s' "$RECURSOS" | json - '"sim" if d and d[0]["features"].get("ai_customer") is True else "nao"')"
+IA_EQUIPE="$(printf '%s' "$RECURSOS" | json - '"sim" if d and d[0]["features"].get("ai_team") is True else "nao"')"
+
+# O que o banco diz tem que ser o que a linha de comando pediu: provisionar com
+# IA uma empresa que não a comprou seria vender de graça, e sem IA uma que
+# comprou seria um cliente mudo.
+ESPERADO_CLIENTES="nao"; [ "$COM_IA" -eq 1 ] && ESPERADO_CLIENTES="sim"
+ESPERADO_EQUIPE="nao"; [ "$COM_EQUIPE" -eq 1 ] && ESPERADO_EQUIPE="sim"
+if [ "$IA_CLIENTES" != "$ESPERADO_CLIENTES" ] || [ "$IA_EQUIPE" != "$ESPERADO_EQUIPE" ]; then
+  falhar "o plano da empresa no banco é '$PLANO_NO_BANCO' (IA para clientes: $IA_CLIENTES, para a equipe: $IA_EQUIPE) e não combina com --plano $PLANO"
+fi
+
+# O modo de roteamento é o mesmo da Major: ele decide qual resolvedor responde,
+# e misturar modos entre conexões só criaria comportamento diferente sem motivo.
+# Tem de ser o .env DA MAJOR (o do assistente na 8090): todo cliente do plano
+# base tem `off` gravado, e pegar o primeiro .env da pasta acabaria copiando o
+# `off` de um cliente sem IA para um cliente que comprou IA.
+if [ "$COM_IA" -eq 1 ] && [ -z "$ROTEAMENTO" ]; then
+  ENV_DA_MAJOR="$(grep -lE '^ASSISTANT_PORT=8090$' "$HOME"/.config/whatsapp-assistant/*.env 2>/dev/null | head -1 || true)"
+  if [ -n "$ENV_DA_MAJOR" ]; then
+    ROTEAMENTO="$(grep -hoE '^NUCLEO_INTELLIGENCE_ROUTING_MODE=[a-z]+' "$ENV_DA_MAJOR" | cut -d= -f2 | head -1 || true)"
+  fi
+  # Sem essa resposta o cliente responderia por um resolvedor diferente do da
+  # plataforma. Melhor parar e perguntar do que adivinhar.
+  [ -n "$ROTEAMENTO" ] || falhar "não achei NUCLEO_INTELLIGENCE_ROUTING_MODE no .env do assistente da Major; informe --roteamento com o mesmo modo dela"
+fi
+[ "$COM_IA" -eq 1 ] || ROTEAMENTO="off"
+case "$ROTEAMENTO" in
+  off|shadow|active) ;;
+  *) falhar "--roteamento inválido: use off, shadow ou active" ;;
+esac
+
+# ------------------------------------------------------------ as portas
+# A Major usa 8080/8090. Clientes ficam em pares (N, N+1) a partir de 8100,
+# a mesma faixa do alocador de whatsapp-assistant/connections.py.
+portas_em_uso() {
+  {
+    echo 8080
+    echo 8090
+    grep -hoE '127\.0\.0\.1:[0-9]+' "$HOME"/.config/whatsapp-connections/*.env 2>/dev/null | cut -d: -f2 || true
+    grep -hoE '^ASSISTANT_PORT=[0-9]+' "$HOME"/.config/whatsapp-assistant/*.env 2>/dev/null | cut -d= -f2 || true
+    if command -v ss >/dev/null 2>&1; then
+      ss -ltnH 2>/dev/null | awk '{print $4}' | sed 's/.*://' || true
+    fi
+  } | sort -un
+}
+
+if [ -r "$CONNECTION_ENV" ] && [ -r "$ASSISTANT_ENV" ]; then
+  BRIDGE_PORT="$(grep -oE '^CONNECTION_LISTEN_ADDR=127\.0\.0\.1:[0-9]+' "$CONNECTION_ENV" | cut -d: -f2)"
+  ASSISTANT_PORT="$(grep -oE '^ASSISTANT_PORT=[0-9]+' "$ASSISTANT_ENV" | cut -d= -f2)"
+else
+  [ ! -e "$CONNECTION_ENV" ] && [ ! -e "$ASSISTANT_ENV" ] \
+    || falhar "só um dos dois .env existe; revise $CONNECTION_ENV e $ASSISTANT_ENV antes de continuar"
+  USADAS="$(portas_em_uso)"
+  BRIDGE_PORT=""
+  for porta in $(seq 8100 2 8198); do
+    if ! printf '%s\n' "$USADAS" | grep -qx "$porta" && ! printf '%s\n' "$USADAS" | grep -qx "$((porta + 1))"; then
+      BRIDGE_PORT="$porta"
+      break
+    fi
+  done
+  [ -n "$BRIDGE_PORT" ] || falhar "nenhum par de portas livre entre 8100 e 8199"
+  ASSISTANT_PORT="$((BRIDGE_PORT + 1))"
+fi
+
+echo "Empresa:   $EMPRESA · plano $PLANO_NO_BANCO (IA clientes: $IA_CLIENTES, equipe: $IA_EQUIPE)"
+echo "Conexão:   $NOME_DA_CONEXAO ($CONNECTION_ID), final $FINAL4"
+echo "Portas:    Bridge 127.0.0.1:$BRIDGE_PORT · assistente 127.0.0.1:$ASSISTANT_PORT"
+echo "Store:     $STORE_DIR"
+echo "Estado:    $STATE_DIR"
+
+if [ "$DRY_RUN" -eq 1 ]; then
+  for arquivo in "$STORE_DIR/api_token" "$CONNECTION_ENV" "$ASSISTANT_ENV" "$CONNECTIONS_JSON" "$CREDENTIAL"; do
+    if [ -e "$arquivo" ]; then echo "  já existe: $arquivo"; else echo "  criaria:   $arquivo"; fi
+  done
+  if [ "$COM_IA" -eq 1 ]; then
+    echo "  IA:        assistente ligado no Bridge, avisos para $DIGITOS_DONO, marca \"$EMPRESA\""
+    if [ ! -s "$CLAUDE_DIR/.credentials.json" ]; then
+      echo "  ATENÇÃO:   falta o login do Claude em $CLAUDE_DIR"
+    fi
+  fi
+  echo "  ligaria:   $BRIDGE_UNIT $ASSISTANT_UNIT"
+  echo "SIMULACAO_OK — nada foi gravado nem ligado"
+  exit 0
+fi
+
+# ------------------------------------------------------------ os arquivos
+umask 077
+for pasta in "$STORE_DIR" "$VAULT_DIR" "$STATE_DIR" \
+  "$HOME/.config/whatsapp-connections" "$HOME/.config/whatsapp-assistant"; do
+  mkdir -p "$pasta"
+  chmod 0700 "$pasta"
+done
+
+if [ ! -s "$STORE_DIR/api_token" ]; then
+  openssl rand -hex 32 >"$STORE_DIR/api_token"
+  chmod 0600 "$STORE_DIR/api_token"
+  echo "  criado:    api_token do Bridge"
+fi
+BRIDGE_TOKEN="$(tr -d '\r\n' <"$STORE_DIR/api_token")"
+[ -n "$BRIDGE_TOKEN" ] || falhar "api_token do Bridge vazio"
+
+if [ ! -e "$CONNECTION_ENV" ]; then
+  cat >"$CONNECTION_ENV" <<EOF
+ORGANIZATION_ID=$ORGANIZATION_ID
+CONNECTION_ID=$CONNECTION_ID
+CONNECTION_STORE_DIR=$STORE_DIR
+CONNECTION_LISTEN_ADDR=127.0.0.1:$BRIDGE_PORT
+# Só os quatro últimos dígitos, de propósito: o WhatsApp devolve o celular
+# brasileiro com ou sem o nono dígito, e o hash de uma forma recusaria a outra
+# (identity_mismatch). O final é o mesmo nas duas.
+CONNECTION_EXPECTED_PHONE_LAST4=$FINAL4
+EOF
+  chmod 0600 "$CONNECTION_ENV"
+  echo "  criado:    $CONNECTION_ENV"
+fi
+
+# O token da rota de envio manual do Bridge (`/api/send/human`), que é o que a
+# tela de Conversas usa. Sem ele, o comando de envio do portal falha com
+# `sending_disabled` e o cliente fica só recebendo.
+if ! grep -q '^WHATSAPP_HUMAN_SEND_TOKEN=' "$CONNECTION_ENV" 2>/dev/null; then
+  HUMAN_SEND_TOKEN="$(openssl rand -hex 32)"
+  printf 'WHATSAPP_HUMAN_SEND_TOKEN=%s\n' "$HUMAN_SEND_TOKEN" >>"$CONNECTION_ENV"
+  echo "  criado:    token de envio pelo portal"
+else
+  HUMAN_SEND_TOKEN="$(grep -oE '^WHATSAPP_HUMAN_SEND_TOKEN=.*' "$CONNECTION_ENV" | cut -d= -f2-)"
+fi
+
+# No plano com IA o dono é quem recebe os avisos de transferência; no base o
+# `ASSISTANT_OWNER` existe só porque o assistente exige um, e nada chega a ele.
+ASSISTANT_OWNER_VALOR="$DIGITOS"
+[ "$COM_IA" -eq 1 ] && ASSISTANT_OWNER_VALOR="$DIGITOS_DONO"
+
+if [ ! -e "$ASSISTANT_ENV" ]; then
+  cat >"$ASSISTANT_ENV" <<EOF
+ASSISTANT_OWNER=$ASSISTANT_OWNER_VALOR
+ASSISTANT_VAULT=$VAULT_DIR
+ASSISTANT_PORT=$ASSISTANT_PORT
+ASSISTANT_STATE_DB=$STATE_DIR/assistant.db
+ASSISTANT_MESSAGES_DB=$STORE_DIR/messages.db
+ASSISTANT_WHISPER_MODEL=small
+ASSISTANT_BRAND_NAME=$EMPRESA
+ASSISTANT_CUSTOMER_TIMEZONE=$FUSO
+EMYLEADS_TEAM_NAMES=$EQUIPE
+WHATSAPP_API_TOKEN=$BRIDGE_TOKEN
+WHATSAPP_HUMAN_SEND_TOKEN=$HUMAN_SEND_TOKEN
+WHATSAPP_API_BASE_URL=http://127.0.0.1:$BRIDGE_PORT/api
+WHATSAPP_OUTBOX_DIR=$STORE_DIR/outbox
+NUCLEO_CREDENTIAL_PATH=$CREDENTIAL
+NUCLEO_TOOL_AUDIT_PATH=$STATE_DIR/tool-audit.jsonl
+EMYLEADS_RUNTIME_CONNECTION_ID=$CONNECTION_ID
+EMYLEADS_RUNTIME_KIND=vps
+EMYLEADS_RUNTIME_HOST_LABEL="VPS Núcleo Major"
+EMYLEADS_RUNTIME_HEARTBEAT_SECONDS=20
+EMYLEADS_RUNTIME_HEARTBEAT=1
+EMYLEADS_CHATBOT_RUNTIME=0
+EMYLEADS_RUNTIME_COMMANDS=1
+EMYLEADS_RUNTIME_COMMANDS_POLL_SECONDS=2
+EMYLEADS_CONVERSATION_SYNC=1
+EMYLEADS_CONVERSATION_SYNC_SECONDS=15
+NUCLEO_INTELLIGENCE_REQUIRED=1
+NUCLEO_INTELLIGENCE_ROUTING_MODE=$ROTEAMENTO
+EMYLEADS_CONNECTIONS_PATH=$CONNECTIONS_JSON
+EMYLEADS_GATEWAY_TOKEN_PATH=$STATE_DIR/installations.json
+EMYLEADS_NOTIFICATION_DRY_RUN=1
+ASSISTANT_NOTIFICATION_TOKEN=$BRIDGE_TOKEN
+EOF
+  chmod 0600 "$ASSISTANT_ENV"
+  echo "  criado:    $ASSISTANT_ENV"
+fi
+
+# As chaves que dependem do plano ficam num lugar só: assim o `--atualizar`
+# (mudança de plano) reescreve exatamente as mesmas linhas que a criação.
+upsert_env() {
+  local arquivo="$1" chave="$2" valor="$3"
+  if grep -q "^$chave=" "$arquivo"; then
+    local tmp="$arquivo.tmp"
+    grep -v "^$chave=" "$arquivo" >"$tmp"
+    printf '%s=%s\n' "$chave" "$valor" >>"$tmp"
+    chmod 0600 "$tmp"
+    mv "$tmp" "$arquivo"
+  else
+    printf '%s=%s\n' "$chave" "$valor" >>"$arquivo"
+  fi
+}
+
+aplicar_plano_no_env() {
+  # Chaves que valem para todo plano, e que uma conexão provisionada por uma
+  # versão anterior deste script ainda não tem.
+  upsert_env "$ASSISTANT_ENV" WHATSAPP_HUMAN_SEND_TOKEN "$HUMAN_SEND_TOKEN"
+  upsert_env "$ASSISTANT_ENV" WHATSAPP_OUTBOX_DIR "$STORE_DIR/outbox"
+  upsert_env "$ASSISTANT_ENV" NUCLEO_TOOL_AUDIT_PATH "$STATE_DIR/tool-audit.jsonl"
+  upsert_env "$ASSISTANT_ENV" ASSISTANT_OWNER "$ASSISTANT_OWNER_VALOR"
+  upsert_env "$ASSISTANT_ENV" ASSISTANT_BRAND_NAME "$EMPRESA"
+  upsert_env "$ASSISTANT_ENV" NUCLEO_INTELLIGENCE_ROUTING_MODE "$ROTEAMENTO"
+  if [ "$COM_IA" -eq 1 ]; then
+    # O claude da máquina, com o login DESTA conexão. Sem o diretório próprio
+    # ele usaria o login padrão, que é o da Major.
+    upsert_env "$ASSISTANT_ENV" ASSISTANT_CLAUDE_BIN "$HOME/.local/bin/claude"
+    upsert_env "$ASSISTANT_ENV" ASSISTANT_CLAUDE_CONFIG_DIR "$CLAUDE_DIR"
+    upsert_env "$ASSISTANT_ENV" EMYLEADS_HANDOFF_NOTIFY_PHONES "$DIGITOS_DONO"
+    upsert_env "$ASSISTANT_ENV" EMYLEADS_TEAM_NAMES "$EQUIPE"
+    upsert_env "$ASSISTANT_ENV" ASSISTANT_CUSTOMER_TIMEZONE "$FUSO"
+    if [ "$COM_EQUIPE" -eq 1 ]; then
+      # Gatilho neutro: o cliente não fala "/major".
+      upsert_env "$ASSISTANT_ENV" EMYLEADS_OPERATOR_TRIGGER "/ia"
+    fi
+  else
+    # Falha fechada: mesmo que alguém ligue o assistente no Bridge por engano,
+    # não existe binário do Claude para chamar.
+    upsert_env "$ASSISTANT_ENV" ASSISTANT_CLAUDE_BIN /bin/false
+  fi
+}
+aplicar_plano_no_env
+
+# ------------------------------------------------------- a política do Bridge
+# Só nos planos com IA: no base, o Bridge cria sozinho a política padrão, que
+# já nasce com o assistente desligado.
+if [ "$COM_IA" -eq 1 ]; then
+  OWNER_DA_POLITICA="$DIGITOS"
+  [ "$COM_EQUIPE" -eq 1 ] && OWNER_DA_POLITICA="$DIGITOS_DONO"
+  if [ ! -e "$POLITICA" ] || [ "$ATUALIZAR" -eq 1 ]; then
+    "$JSON_PY" - "$POLITICA" "$OWNER_DA_POLITICA" "$DIGITOS_DONO" "$OPERADORES" \
+      "http://127.0.0.1:$ASSISTANT_PORT/inbound" <<'PY'
+import json, os, sys
+destino, owner, dono, operadores, notify = sys.argv[1:]
+lista = [p.strip() for p in operadores.split(",") if p.strip()]
+# `allow_unlisted` falso, como na Major: o agente só procura quem está na
+# lista. A janela do cliente (`customer_reply_window_seconds`) é o que deixa
+# responder quem escreveu, e a rota de envio manual do portal não passa por
+# aqui.
+politica = {
+    "allowed_recipients": sorted({dono, *lista}),
+    "allow_unlisted": False,
+    "allowed_media_dirs": ["outbox"],
+    "assistant": {
+        "enabled": True,
+        "owner": owner,
+        "operators": lista,
+        "allowed_users": [],
+        "notify_url": notify,
+        "allowed_groups": [],
+        "customer_inbound": True,
+        "customer_reply_window_seconds": 900,
+        "group_session_timeout_seconds": 0,
+    },
+}
+with open(destino, "w", encoding="utf-8") as saida:
+    json.dump(politica, saida, ensure_ascii=False, indent=2)
+os.chmod(destino, 0o600)
+PY
+    echo "  gravada:   política do Bridge (assistente ligado)"
+  fi
+
+  # O login do Claude é interativo e não dá para automatizar. Sem ele, o
+  # assistente sobe e falha em toda resposta.
+  if [ ! -s "$CLAUDE_DIR/.credentials.json" ]; then
+    mkdir -p "$CLAUDE_DIR"
+    chmod 0700 "$CLAUDE_DIR"
+    echo "" >&2
+    echo "FALTA O LOGIN DO CLAUDE desta conexão. Rode, como $EXPECTED_USER:" >&2
+    echo "" >&2
+    echo "  CLAUDE_CONFIG_DIR=$CLAUDE_DIR claude" >&2
+    echo "" >&2
+    echo "Entre com a conta da Major, saia do modo interativo e rode este mesmo" >&2
+    echo "comando de novo — ele continua de onde parou." >&2
+    exit 4
+  fi
+fi
+
+if [ ! -e "$CONNECTIONS_JSON" ]; then
+  "$JSON_PY" - "$CONNECTIONS_JSON" "$CONNECTION_ID" "$ORGANIZATION_ID" "$NOME_DA_CONEXAO" \
+    "http://127.0.0.1:$BRIDGE_PORT/api/internal/v1" "$STORE_DIR" "vps://$(hostname)" "$FINAL4" <<'PY'
+import json, os, sys
+destino, conexao, organizacao, nome, base_url, store, host, final4 = sys.argv[1:]
+registro = {
+    "version": 1,
+    "connections": [{
+        "connection_id": conexao,
+        "organization_id": organizacao,
+        "name": nome,
+        "internal_base_url": base_url,
+        "store_dir": store,
+        "host_ref": host,
+        "expected_phone_last4": final4,
+        "revoked": False,
+    }],
+}
+with open(destino, "w", encoding="utf-8") as saida:
+    json.dump(registro, saida, ensure_ascii=False, indent=2)
+os.chmod(destino, 0o600)
+PY
+  echo "  criado:    $CONNECTIONS_JSON"
+fi
+
+# ------------------------------------------------------------ o robô
+if [ ! -s "$CREDENTIAL" ]; then
+  [ -x "$PYTHON_BIN" ] || falhar "ambiente Python do MCP não encontrado: $PYTHON_BIN"
+  (
+    cd "$REPO_ROOT/whatsapp-mcp-server"
+    SUPABASE_URL="$SUPABASE_URL" \
+    SUPABASE_PUBLISHABLE_KEY="$SUPABASE_PUBLISHABLE_KEY" \
+    SUPABASE_SERVICE_ROLE_KEY="$SUPABASE_SERVICE_ROLE_KEY" \
+      "$PYTHON_BIN" provision_robot.py \
+        --organization-id "$ORGANIZATION_ID" \
+        --connection-id "$CONNECTION_ID" \
+        --output "$CREDENTIAL"
+  ) || falhar "o provisionamento do robô falhou; nada foi ligado"
+  chmod 0600 "$CREDENTIAL"
+  echo "  criado:    credencial do robô"
+fi
+
+# O árbitro nasce com a IA desligada (`ia_ativa = 0`) e só a rota /automation
+# do gateway liga. Num plano com IA, ligar é parte do provisionamento.
+if [ "$COM_IA" -eq 1 ]; then
+  ASSISTANT_PYTHON="${ASSISTANT_PYTHON:-$HOME/.venvs/whatsapp-assistant/bin/python}"
+  if [ -x "$ASSISTANT_PYTHON" ]; then
+    (
+      cd "$REPO_ROOT/whatsapp-assistant"
+      "$ASSISTANT_PYTHON" -c 'import sys; from arbitro import Arbitro; Arbitro(sys.argv[1]).definir_ia(sys.argv[2], True)' \
+        "$STATE_DIR/arbitro.db" "$CONNECTION_ID"
+    ) && echo "  ligada:    a IA no árbitro desta conexão"
+  else
+    echo "AVISO: ambiente Python do assistente não encontrado; ligue a IA pelo portal" >&2
+  fi
+fi
+
+if [ "$STATUS_NO_BANCO" = "created" ] || [ "$STATUS_NO_BANCO" = "provisioning" ]; then
+  rest PATCH "whatsapp_connections?id=eq.$CONNECTION_ID&status=in.(created,provisioning)" \
+    '{"status":"awaiting_pairing"}' >/dev/null || falhar "não foi possível marcar a conexão como awaiting_pairing"
+  echo "  banco:     conexão marcada como awaiting_pairing"
+fi
+
+# ------------------------------------------------------------ as units
+"$SYSTEMCTL" --user enable --now "$BRIDGE_UNIT" "$ASSISTANT_UNIT" >/dev/null
+echo "  ligadas:   $BRIDGE_UNIT $ASSISTANT_UNIT"
+if [ "$ATUALIZAR" -eq 1 ]; then
+  # A política e o .env são lidos na partida: mudar de plano exige reiniciar.
+  "$SYSTEMCTL" --user restart "$BRIDGE_UNIT" "$ASSISTANT_UNIT" >/dev/null
+  echo "  reiniciadas: $BRIDGE_UNIT $ASSISTANT_UNIT"
+fi
+
+# ------------------------------------------------------------ o sinal
+ESPERA="${HEARTBEAT_WAIT_SECONDS:-120}"
+echo "Aguardando o primeiro sinal da VPS (até ${ESPERA}s)…"
+decorrido=0
+while [ "$decorrido" -lt "$ESPERA" ]; do
+  SINAL="$(rest GET "connection_runtime_status?connection_id=eq.$CONNECTION_ID&select=heartbeat_at,bridge_status,assistant_status,whatsapp_status" || echo '[]')"
+  if [ "$(printf '%s' "$SINAL" | json - 'len(d)')" = "1" ]; then
+    echo "Sinal recebido: $(printf '%s' "$SINAL" | json - 'd[0]["bridge_status"] + " / " + d[0]["assistant_status"] + " / " + d[0]["whatsapp_status"]')"
+    echo "PROVISIONADA — o cliente já pode ler o QR no portal (Conversas ou Conexões)."
+    exit 0
+  fi
+  sleep 5
+  decorrido=$((decorrido + 5))
+done
+echo "AVISO: sem sinal em ${ESPERA}s. Confira: journalctl --user -u $ASSISTANT_UNIT -n 50" >&2
+exit 3
