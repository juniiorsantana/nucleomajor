+"""Testes de scripts/vps/provision-connection.sh.
+
+O script roda de verdade, num HOME descartável. O que ele chama de fora é
+substituído por dublês que registram o que receberam:
+
+  * curl       responde como o PostgREST, a partir de arquivos JSON;
+  * systemctl  só anota a chamada;
+  * o Python do MCP (provision_robot.py) grava uma credencial falsa.
+
+Rodar (na VPS ou em qualquer máquina com bash):
+  python -m unittest scripts/vps/test_provision_connection.py -v
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+SCRIPT = Path(__file__).resolve().parent / "provision-connection.sh"
+ORG = "338e44ca-36ab-437c-b8ac-aa7c60fee64a"
+CONEXAO = "7a1c2e3f-4b5d-4e6f-8a9b-0c1d2e3f4a5b"
+MAJOR = "8ee1e6d0-a9d0-4041-b6ea-878716a34a71"
+OUTRO = "11111111-2222-4333-8444-555555555555"
+CHAVE = "sb_secret_CHAVE_DE_TESTE_NAO_PODE_VAZAR"
+TELEFONE = "5565992178164"
+
+
+def _bash() -> str | None:
+    candidatos = [os.environ.get("BASH_BIN", "")]
+    if os.name == "nt":
+        # O bash de Git/usr/bin, e não o de Git/bin: aquele é um invólucro
+        # que põe /mingw64/bin na frente do PATH e acharia o curl de verdade.
+        candidatos.append(r"C:\Program Files\Git\usr\bin\bash.exe")
+    candidatos.append(shutil.which("bash") or "")
+    for candidato in candidatos:
+        if candidato and Path(candidato).exists() and "System32" not in candidato:
+            return candidato
+    return None
+
+
+BASH = _bash()
+
+FAKE_CURL = r'''
+import json, os, sys
+from pathlib import Path
+db = Path(os.environ["FAKE_DB"])
+config = sys.stdin.read()
+args = sys.argv[1:]
+metodo = args[args.index("-X") + 1] if "-X" in args else "GET"
+url = args[-1]
+dados = args[args.index("--data") + 1] if "--data" in args else None
+with open(db / "curl.log", "a", encoding="utf-8") as log:
+    log.write(json.dumps({"argv": args, "chave_na_entrada": os.environ["FAKE_KEY"] in config,
+                          "metodo": metodo, "url": url, "dados": dados}) + "\n")
+def ler(nome):
+    return json.loads((db / nome).read_text(encoding="utf-8"))
+if "whatsapp_connections" in url and metodo == "GET":
+    print(json.dumps(ler("conexao.json")))
+elif "whatsapp_connections" in url and metodo == "PATCH":
+    linhas = ler("conexao.json")
+    for linha in linhas:
+        linha.update(json.loads(dados))
+    (db / "conexao.json").write_text(json.dumps(linhas), encoding="utf-8")
+    print(json.dumps(linhas))
+elif "organizations?" in url:
+    print(json.dumps(ler("empresa.json")))
+elif "organization_subscriptions" in url:
+    print(json.dumps(ler("assinatura.json")))
+elif "saas_plans" in url:
+    print(json.dumps(ler("plano.json")))
+elif "connection_runtime_status" in url:
+    print(json.dumps(ler("sinal.json")))
+else:
+    sys.stderr.write("rota inesperada: " + url)
+    sys.exit(22)
+'''
+
+FAKE_ARBITRO = r'''
+import json, os, sys
+from pathlib import Path
+# O script chama `python -c "...Arbitro..."`; aqui só registramos a chamada.
+db = Path(os.environ["FAKE_DB"])
+with open(db / "arbitro.log", "a", encoding="utf-8") as log:
+    log.write(json.dumps({"args": sys.argv[1:]}) + "\n")
+'''
+
+FAKE_PYTHON_MCP = r'''
+import json, os, sys
+from pathlib import Path
+args = sys.argv[1:]
+saida = Path(args[args.index("--output") + 1])
+db = Path(os.environ["FAKE_DB"])
+with open(db / "robo.log", "a", encoding="utf-8") as log:
+    log.write(json.dumps({"args": args, "recebeu_chave": os.environ.get("SUPABASE_SERVICE_ROLE_KEY") == os.environ["FAKE_KEY"],
+                          "url": os.environ.get("SUPABASE_URL")}) + "\n")
+saida.write_text(json.dumps({"auth_user_id": "robo", "supabase_url": os.environ["SUPABASE_URL"]}), encoding="utf-8")
+'''
+
+
+def _posix(caminho: Path) -> str:
+    texto = str(caminho)
+    if os.name == "nt" and len(texto) > 1 and texto[1] == ":":
+        return "/" + texto[0].lower() + texto[2:].replace("\\", "/")
+    return texto
+
+
+@unittest.skipIf(BASH is None, "bash indisponível")
+class ProvisionConnectionTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.home = self.tmp / "home"
+        self.db = self.tmp / "db"
+        self.bin = self.tmp / "bin"
+        for pasta in (self.home, self.db, self.bin):
+            pasta.mkdir(parents=True)
+
+        # A Major e um cliente anterior já ocupam portas.
+        conexoes = self.home / ".config" / "whatsapp-connections"
+        assistentes = self.home / ".config" / "whatsapp-assistant"
+        conexoes.mkdir(parents=True)
+        assistentes.mkdir(parents=True)
+        (conexoes / f"{MAJOR}.env").write_text("CONNECTION_LISTEN_ADDR=127.0.0.1:8080\n", encoding="utf-8")
+        (assistentes / f"{MAJOR}.env").write_text(
+            "ASSISTANT_PORT=8090\nNUCLEO_INTELLIGENCE_ROUTING_MODE=active\n", encoding="utf-8")
+        (conexoes / f"{OUTRO}.env").write_text("CONNECTION_LISTEN_ADDR=127.0.0.1:8100\n", encoding="utf-8")
+        # Um cliente do plano base, que tem o roteamento desligado: ele não pode
+        # ser confundido com a Major na hora de descobrir o modo.
+        (assistentes / f"{OUTRO}.env").write_text(
+            "ASSISTANT_PORT=8101\nNUCLEO_INTELLIGENCE_ROUTING_MODE=off\n", encoding="utf-8")
+        modelo = self.home / ".local" / "state" / "whatsapp-assistant" / MAJOR
+        modelo.mkdir(parents=True)
+        (modelo / "supabase-robot.json").write_text(json.dumps({
+            "supabase_url": "https://projeto.supabase.co/", "publishable_key": "sb_publishable_x",
+        }), encoding="utf-8")
+
+        self._banco(
+            conexao=[{
+                "id": CONEXAO, "organization_id": ORG, "name": "WhatsApp principal", "status": "created",
+                "expected_phone_hash": hashlib.sha256(f"{CONEXAO}:{TELEFONE}".encode()).hexdigest(),
+                "expected_phone_last4": "8164",
+            }],
+            empresa=[{"name": "Clínica do Cliente"}],
+            assinatura=[{"plan_code": "base", "status": "active"}],
+            plano=[{"features": {"crm": True, "ai_customer": False, "ai_team": False}}],
+            sinal=[{"heartbeat_at": "2026-09-21T10:00:00Z", "bridge_status": "online",
+                    "assistant_status": "online", "whatsapp_status": "whatsapp_disconnected"}],
+        )
+
+        python = _posix(Path(sys.executable))
+        (self.bin / "fake_curl.py").write_text(FAKE_CURL, encoding="utf-8")
+        (self.bin / "fake_mcp.py").write_text(FAKE_PYTHON_MCP, encoding="utf-8")
+        self._executavel("curl", f'#!/usr/bin/env bash\nexec "{python}" "{_posix(self.bin / "fake_curl.py")}" "$@"\n')
+        self._executavel("systemctl", f'#!/usr/bin/env bash\necho "$*" >> "{_posix(self.db / "systemctl.log")}"\n')
+        self._executavel("ss", "#!/usr/bin/env bash\nexit 0\n")
+        # O python do assistente, que o script usa para ligar a IA no árbitro.
+        (self.bin / "fake_arbitro.py").write_text(FAKE_ARBITRO, encoding="utf-8")
+        self._executavel(
+            "python-assistente",
+            f'#!/usr/bin/env bash\nexec "{python}" "{_posix(self.bin / "fake_arbitro.py")}" "$@"\n',
+        )
+        self._executavel("python3", f'#!/usr/bin/env bash\nexec "{python}" "$@"\n')
+        self._executavel("python-mcp", f'#!/usr/bin/env bash\nexec "{python}" "{_posix(self.bin / "fake_mcp.py")}" "$@"\n')
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _banco(self, **tabelas) -> None:
+        for nome, linhas in tabelas.items():
+            (self.db / f"{nome}.json").write_text(json.dumps(linhas), encoding="utf-8")
+
+    def _executavel(self, nome: str, conteudo: str) -> None:
+        caminho = self.bin / nome
+        # No Windows o Python escreve na página de código do sistema, e o nome
+        # da empresa sairia em cp1252. Na VPS é UTF-8; os dublês fixam isso.
+        conteudo = conteudo.replace("#!/usr/bin/env bash\n", "#!/usr/bin/env bash\nexport PYTHONIOENCODING=utf-8\n", 1)
+        caminho.write_text(conteudo, encoding="utf-8", newline="\n")
+        caminho.chmod(0o755)
+
+    @property
+    def politica(self) -> Path:
+        return self.home / ".local/share/nucleo-major/whatsapp" / CONEXAO / "config.json"
+
+    @property
+    def claude_dir(self) -> Path:
+        return self.home / ".config" / "claude" / CONEXAO
+
+    def _plano_no_banco(self, ai_customer: bool, ai_team: bool, codigo: str) -> None:
+        self._banco(
+            plano=[{"features": {"crm": True, "ai_customer": ai_customer, "ai_team": ai_team}}],
+            assinatura=[{"plan_code": codigo, "status": "active"}],
+        )
+
+    def _com_login_do_claude(self) -> None:
+        self.claude_dir.mkdir(parents=True, exist_ok=True)
+        (self.claude_dir / ".credentials.json").write_text("{}", encoding="utf-8")
+
+    def rodar(self, *extra: str, telefone: str = "(65) 99217-8164") -> subprocess.CompletedProcess:
+        usuario = subprocess.run([BASH, "-c", "id -un"], capture_output=True, text=True, encoding="utf-8").stdout.strip()
+        env = {
+            **os.environ,
+            "HOME": _posix(self.home),
+            "SERVICE_USER": usuario,
+            "SUPABASE_SERVICE_ROLE_KEY": CHAVE,
+            "PYTHON_BIN": _posix(self.bin / "python-mcp"),
+            "ASSISTANT_PYTHON": _posix(self.bin / "python-assistente"),
+            "JSON_PY": _posix(self.bin / "python3"),
+            "SYSTEMCTL": _posix(self.bin / "systemctl"),
+            "HEARTBEAT_WAIT_SECONDS": "5",
+            "FAKE_DB": str(self.db),
+            "FAKE_KEY": CHAVE,
+        }
+        if os.name == "nt":
+            # O Git Bash converte o PATH do Windows para o formato dele na
+            # entrada; um PATH já em formato POSIX não seria reconhecido.
+            env["PATH"] = str(self.bin) + ";" + os.environ.get("PATH", "")
+        else:
+            env["PATH"] = str(self.bin) + ":" + os.environ.get("PATH", "")
+        plano = "base"
+        if "--plano" in extra:
+            plano = extra[list(extra).index("--plano") + 1]
+            extra = tuple(a for i, a in enumerate(extra) if i not in (list(extra).index("--plano"), list(extra).index("--plano") + 1))
+        args = [BASH, _posix(SCRIPT), ORG, CONEXAO, "--plano", plano, *extra]
+        if telefone is not None:
+            args += ["--telefone", telefone]
+        return subprocess.run(args, capture_output=True, text=True, encoding="utf-8", env=env, timeout=120)
+
+    def _log(self, nome: str) -> list:
+        caminho = self.db / nome
+        if not caminho.exists():
+            return []
+        texto = caminho.read_text(encoding="utf-8")
+        if nome.endswith(".log") and nome != "systemctl.log":
+            return [json.loads(linha) for linha in texto.splitlines() if linha.strip()]
+        return [linha for linha in texto.splitlines() if linha.strip()]
+
+    @property
+    def conn_env(self) -> Path:
+        return self.home / ".config" / "whatsapp-connections" / f"{CONEXAO}.env"
+
+    @property
+    def asst_env(self) -> Path:
+        return self.home / ".config" / "whatsapp-assistant" / f"{CONEXAO}.env"
+
+    @property
+    def estado(self) -> Path:
+        return self.home / ".local" / "state" / "whatsapp-assistant" / CONEXAO
+
+    def test_provisiona_o_plano_base_no_proximo_par_de_portas(self) -> None:
+        r = self.rodar()
+        self.assertEqual(r.returncode, 0, r.stderr + r.stdout)
+        self.assertIn("PROVISIONADA", r.stdout)
+
+        conn = self.conn_env.read_text(encoding="utf-8")
+        self.assertIn(f"CONNECTION_ID={CONEXAO}", conn)
