@@ -0,0 +1,108 @@
+"""O MCP do WhatsApp lê o store DA CONEXÃO, e só para leitura.
+
+Enquanto existia uma conexão só, os caminhos podiam morar no repositório. Numa
+VPS com mais de uma, esse default é o store de outra empresa — a ferramenta de
+leitura do assistente de um cliente leria as conversas da Major. Estes testes
+prendem as três garantias: o ambiente manda, o banco abre somente leitura, e um
+runtime que se identifica por conexão sem dizer qual banco ler não sobe.
+"""
+from __future__ import annotations
+
+import importlib
+import os
+import sqlite3
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+
+def recarregar():
+    import whatsapp
+
+    return importlib.reload(whatsapp)
+
+
+class CaminhosPorConexaoTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.store = Path(self.tmp.name)
+        self.banco = self.store / "messages.db"
+        # Um banco com a forma que as ferramentas esperam.
+        conexao = sqlite3.connect(self.banco)
+        conexao.execute("create table chats (jid text primary key, name text, last_message_time timestamp)")
+        conexao.execute(
+            """create table messages (
+                 id text, chat_jid text, sender text, content text, timestamp timestamp,
+                 is_from_me boolean, media_type text, filename text, url text,
+                 media_key blob, file_sha256 blob, file_enc_sha256 blob, file_length integer
+               )"""
+        )
+        conexao.execute(
+            "insert into chats values ('5565999990000@s.whatsapp.net', 'Cliente', '2026-09-22 10:00:00')"
+        )
+        conexao.execute(
+            """insert into messages (id, chat_jid, sender, content, timestamp, is_from_me, media_type)
+               values ('M1', '5565999990000@s.whatsapp.net', '5565999990000', 'oi', '2026-09-22 10:00:00', 0, '')"""
+        )
+        conexao.commit()
+        conexao.close()
+        # O módulo é recarregado nos testes; devolve o estado original no fim.
+        self.addCleanup(recarregar)
+
+    def _com_ambiente(self, **variaveis):
+        limpo = {k: v for k, v in os.environ.items() if not k.startswith(("ASSISTANT_", "WHATSAPP_", "EMYLEADS_"))}
+        limpo.update(variaveis)
+        return mock.patch.dict(os.environ, limpo, clear=True)
+
+    def test_o_ambiente_manda_nos_caminhos_e_na_porta(self):
+        with self._com_ambiente(
+            ASSISTANT_MESSAGES_DB=str(self.banco),
+            WHATSAPP_API_BASE_URL="http://127.0.0.1:8102/api",
+            WHATSAPP_OUTBOX_DIR=str(self.store / "outbox"),
+            WHATSAPP_API_TOKEN_PATH=str(self.store / "api_token"),
+            EMYLEADS_RUNTIME_CONNECTION_ID="7a1c2e3f-4b5d-4e6f-8a9b-0c1d2e3f4a5b",
+        ):
+            whatsapp = recarregar()
+            self.assertEqual(whatsapp.MESSAGES_DB_PATH, str(self.banco))
+            self.assertEqual(whatsapp.WHATSAPP_API_BASE_URL, "http://127.0.0.1:8102/api")
+            self.assertEqual(whatsapp.OUTBOX_PATH, str(self.store / "outbox"))
+            self.assertEqual(whatsapp.API_TOKEN_PATH, str(self.store / "api_token"))
+            chats = whatsapp.list_chats()
+            self.assertEqual([c.jid for c in chats], ["5565999990000@s.whatsapp.net"])
+
+    def test_sem_ambiente_o_caminho_do_repositorio_continua_valendo(self):
+        with self._com_ambiente():
+            whatsapp = recarregar()
+            self.assertTrue(whatsapp.MESSAGES_DB_PATH.endswith(os.path.join("whatsapp-bridge", "store", "messages.db")))
+            self.assertEqual(whatsapp.WHATSAPP_API_BASE_URL, "http://127.0.0.1:8080/api")
+
+    def test_banco_abre_somente_leitura_e_caminho_errado_falha(self):
+        with self._com_ambiente(ASSISTANT_MESSAGES_DB=str(self.banco)):
+            whatsapp = recarregar()
+            conexao = whatsapp._abrir_banco()
+            self.addCleanup(conexao.close)
+            with self.assertRaises(sqlite3.OperationalError):
+                conexao.execute("insert into chats values ('x@s.whatsapp.net', 'x', '2026-01-01 00:00:00')")
+
+        inexistente = self.store / "nao-existe" / "messages.db"
+        with self._com_ambiente(ASSISTANT_MESSAGES_DB=str(inexistente)):
+            whatsapp = recarregar()
+            with self.assertRaises(sqlite3.OperationalError):
+                whatsapp._abrir_banco()
+            # E nada de banco vazio criado no caminho errado.
+            self.assertFalse(inexistente.exists())
+
+    def test_runtime_por_conexao_sem_banco_declarado_nao_sobe(self):
+        with self._com_ambiente(EMYLEADS_RUNTIME_CONNECTION_ID="7a1c2e3f-4b5d-4e6f-8a9b-0c1d2e3f4a5b"):
+            with self.assertRaises(RuntimeError) as erro:
+                recarregar()
+            self.assertIn("ASSISTANT_MESSAGES_DB", str(erro.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
