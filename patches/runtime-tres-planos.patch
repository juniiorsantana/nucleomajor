index 0000000..934616e
--- /dev/null
+++ b/scripts/vps/connection-operators.sh
@@ -0,0 +1,141 @@
+#!/usr/bin/env bash
+#
+# Quem, na equipe do cliente, pode falar com o assistente (plano Completo).
+#
+# A lista mora na política do Bridge daquela conexão, escrita por
+# scripts/vps/provision-connection.sh: `assistant.operators` diz de quem o
+# Bridge aceita um turno de operador, e `allowed_recipients` diz para quem o
+# agente pode escrever. Um operador precisa dos dois — só em `operators` ele
+# fala e não é respondido.
+#
+# Uso, como o usuário `nucleo`:
+#
+#   bash scripts/vps/connection-operators.sh <connection-id> listar
+#   bash scripts/vps/connection-operators.sh <connection-id> add 5565988887777
+#   bash scripts/vps/connection-operators.sh <connection-id> remove 5565988887777
+#
+# O dono da empresa (o `owner` da política) não entra nem sai por aqui: ele já
+# é operador por ser dono, e tirá-lo da lista de destinos cortaria os avisos de
+# transferência. Para trocar o dono, rode o provision-connection.sh
+# `--atualizar --dono <novo>`.
+#
+# Depois de gravar, o Bridge daquela conexão é reiniciado: ele lê a política na
+# partida. O assistente não é tocado.
+set -euo pipefail
+
+UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
+
+falhar() {
+  echo "ERRO: $*" >&2
+  exit 1
+}
+
+CONNECTION_ID="${1:-}"
+ACAO="${2:-}"
+TELEFONE="${3:-}"
+[[ "$CONNECTION_ID" =~ $UUID_RE ]] || falhar "uso: connection-operators.sh <connection-id> listar|add|remove [telefone]"
+
+EXPECTED_USER="${SERVICE_USER:-nucleo}"
+if [ "$(id -u)" -eq 0 ] || [ "$(id -un)" != "$EXPECTED_USER" ]; then
+  falhar "execute como o usuário $EXPECTED_USER, nunca como root"
+fi
+
+JSON_PY="${JSON_PY:-python3}"
+SYSTEMCTL="${SYSTEMCTL:-systemctl}"
+POLITICA="$HOME/.local/share/nucleo-major/whatsapp/$CONNECTION_ID/config.json"
+BRIDGE_UNIT="whatsapp-bridge@$CONNECTION_ID.service"
+
+[ -r "$POLITICA" ] || falhar "não achei a política desta conexão em $POLITICA (ela só existe nos planos com IA)"
+
+DIGITOS=""
+if [ "$ACAO" = "add" ] || [ "$ACAO" = "remove" ]; then
+  [ -n "$TELEFONE" ] || falhar "informe o telefone do operador"
+  DIGITOS="$(printf '%s' "$TELEFONE" | tr -cd '0-9')"
+  if [ "${#DIGITOS}" -eq 10 ] || [ "${#DIGITOS}" -eq 11 ]; then
+    DIGITOS="55$DIGITOS"
+  fi
+  [[ "$DIGITOS" =~ ^[1-9][0-9]{9,14}$ ]] || falhar "telefone inválido: informe com DDD"
+fi
+
+case "$ACAO" in
+  listar|add|remove) ;;
+  *) falhar "ação inválida: '${ACAO:-nenhuma}'. Use listar, add ou remove." ;;
+esac
+
+# O Python faz a conta e devolve o que mudou; o bash só decide se reinicia.
+RESULTADO="$("$JSON_PY" - "$POLITICA" "$ACAO" "$DIGITOS" <<'PY'
+import json, os, sys, tempfile
+
+destino, acao, telefone = sys.argv[1:]
+with open(destino, encoding="utf-8") as entrada:
+    politica = json.load(entrada)
+
+assistente = politica.setdefault("assistant", {})
+if not assistente.get("enabled"):
+    print("ERRO|o assistente está desligado nesta conexão (plano sem IA)")
+    raise SystemExit(0)
+
+operadores = list(assistente.get("operators") or [])
+destinos = set(politica.get("allowed_recipients") or [])
+dono = (assistente.get("owner") or "").strip()
+
+if acao == "listar":
+    print("LISTA|" + ",".join(operadores))
+    raise SystemExit(0)
+
+if acao == "add":
+    if telefone in operadores:
+        print("IGUAL|" + telefone)
+        raise SystemExit(0)
+    operadores.append(telefone)
+    destinos.add(telefone)
+else:
+    if telefone == dono:
+        print("ERRO|esse número é o dono da conexão; troque o dono pelo provision-connection.sh --atualizar --dono")
+        raise SystemExit(0)
+    if telefone not in operadores:
+        print("IGUAL|" + telefone)
+        raise SystemExit(0)
+    operadores = [p for p in operadores if p != telefone]
+    destinos.discard(telefone)
+
+assistente["operators"] = operadores
+# O dono nunca sai dos destinos: é para ele que vão os avisos de transferência.
+if dono:
+    destinos.add(dono)
+politica["allowed_recipients"] = sorted(destinos)
+
+# Gravar por arquivo temporário no mesmo diretório: se faltar disco ou o
+# processo morrer no meio, o Bridge continua com a política antiga inteira.
+pasta = os.path.dirname(destino)
+with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=pasta, delete=False) as saida:
+    json.dump(politica, saida, ensure_ascii=False, indent=2)
+    temporario = saida.name
+os.chmod(temporario, 0o600)
+os.replace(temporario, destino)
+print("GRAVADO|" + ",".join(operadores))
+PY
+)"
+
+ESTADO="${RESULTADO%%|*}"
+LISTA="${RESULTADO#*|}"
+
+case "$ESTADO" in
+  ERRO) falhar "$LISTA" ;;
+  LISTA)
+    if [ -n "$LISTA" ]; then
+      printf '%s\n' "$LISTA" | tr ',' '\n'
+    else
+      echo "(nenhum operador além do dono)"
+    fi
+    ;;
+  IGUAL)
+    echo "Nada a fazer: $LISTA já estava como você pediu."
+    ;;
+  GRAVADO)
+    echo "Operadores agora: ${LISTA:-(nenhum)}"
+    "$SYSTEMCTL" --user restart "$BRIDGE_UNIT"
+    echo "Bridge reiniciado ($BRIDGE_UNIT)."
+    ;;
+  *) falhar "resposta inesperada: $RESULTADO" ;;
+esac
