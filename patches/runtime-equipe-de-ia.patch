+def contar_autores(mensagens: list) -> dict:
+    """Quantas mensagens foram da IA, da equipe e do contato.
+
+    É o que separa o Desempenho da IA do da equipe. Mensagem da empresa sem
+    autoria é o celular, e o celular é gente.
+    """
+    ia = equipe = contato = 0
+    for mensagem in mensagens:
+        if not isinstance(mensagem, dict):
+            continue
+        if not mensagem.get("fromMe"):
+            contato += 1
+        elif mensagem.get("authorKind") == "ia":
+            ia += 1
+        elif mensagem.get("authorKind") != "bot":
+            equipe += 1
+    return {"aiMessages": min(ia, 500), "teamMessages": min(equipe, 500), "contactMessages": min(contato, 500)}
+
+
+def normalizar_respostas(perguntas, brutas: dict) -> list:
+    respostas = []
+    for pergunta in perguntas:
+        normalizada = jev_framework.normalizar(pergunta, brutas.get(pergunta.chave))
+        if normalizada is not None:
+            respostas.append(normalizada)
+    return respostas
+
+
+# O resultado de um comando cabe em 2048 bytes (20260910130000). A avaliação
+# volta compacta: pergunta -> [resposta, chance com duas casas].
+TETO_DO_RESULTADO = 2000
+
+
+def avaliar_teste(jev: "JevClient", transcricao: str, agente: Any = None, playbook: Any = None) -> dict:
+    """Avalia uma conversa de teste escrita no portal (aba Testar do agente).
+
+    Sobe `JevPausa` e `JevRecusa` para quem chamou decidir o desfecho do
+    comando. O texto da conversa não vai para log nenhum.
+    """
+    agente = agente if isinstance(agente, dict) else {}
+    playbook = playbook if isinstance(playbook, dict) else None
+    texto = str(transcricao or "").strip()[-TEXTO_MAXIMO:]
+    if not texto:
+        raise JevRecusa("conversation_empty")
+    perguntas = jev_framework.montar_perguntas(playbook, agente.get("tone"))
+    dados = jev.decidir(texto, perguntas)
+    respostas = normalizar_respostas(perguntas, dados.get("answers") or {})
+    if not respostas:
+        raise JevRecusa("jev_answers_unusable")
+    resultado = {
+        "r": {
+            r["question"]: [r["answer"], None if r["probability"] is None else round(r["probability"], 2)]
+            for r in respostas
+        },
+        "pb": _inteiro((playbook or {}).get("version")),
+        "ms": _inteiro(dados.get("_latency_ms")),
+    }
+    # Se passar do teto, saem do fim: as perguntas do playbook e o jeito, que
+    # entram por último. O que sobra continua útil.
+    while len(json.dumps(resultado, ensure_ascii=False).encode("utf-8")) > TETO_DO_RESULTADO and resultado["r"]:
+        resultado["r"].pop(next(reversed(resultado["r"])))
+    return resultado
+
+
 def _inteiro(valor: Any) -> int:
     try:
         return max(0, int(valor))
