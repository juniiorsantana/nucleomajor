+def montar_perguntas(playbook: Any = None, jeito: Any = None) -> tuple[Pergunta, ...]:
+    """As perguntas desta conversa: a base da Major, o playbook e o jeito.
+
+    Sem playbook e sem jeito, é exatamente `PERGUNTAS`. Item do playbook com
+    chave fora do formato é ignorado, e não derruba a leitura: o banco já
+    confere o formato ao publicar, e isto é só a segunda trava.
+    """
+    perguntas = list(PERGUNTAS)
+    playbook = playbook if isinstance(playbook, dict) else {}
+
+    objecoes = [
+        item for item in (playbook.get("objecoes") or [])
+        if isinstance(item, dict) and CHAVE_RE.fullmatch(str(item.get("chave") or ""))
+    ]
+    if objecoes:
+        base = dict(POR_CHAVE["objecao_principal"].criterios)
+        da_empresa = {
+            item["chave"]: f"{_texto(item.get('nome'), 120)} (objeção que esta empresa costuma ouvir)."
+            for item in objecoes
+        }
+        # A da empresa vence a da base quando a chave é a mesma; "nenhuma" e
+        # "outra" ficam sempre, nas pontas.
+        criterios = {"nenhuma": base.pop("nenhuma")}
+        criterios.update({**base, **da_empresa})
+        criterios.pop("outra", None)
+        criterios["outra"] = "Outra objeção que não se encaixa acima."
+        indice = next(i for i, p in enumerate(perguntas) if p.chave == "objecao_principal")
+        perguntas[indice] = Pergunta(
+            "objecao_principal", "lead", "choice", POR_CHAVE["objecao_principal"].instrucao, criterios
+        )
+
+    passos = [
+        item for item in (playbook.get("proximosPassos") or [])
+        if isinstance(item, dict) and CHAVE_RE.fullmatch(str(item.get("chave") or ""))
+    ]
+    if passos:
+        criterios = {
+            item["chave"]: f"Ofereceu: {_texto(item.get('nome'), 120)}." for item in passos
+        }
+        criterios["nenhum"] = "Não ofereceu nenhum destes passos."
+        perguntas.append(Pergunta(
+            "proximo_passo_oferecido", "atendimento", "choice",
+            "Qual destes próximos passos a empresa ofereceu ao contato?", criterios,
+        ))
+
+    for item in playbook.get("criterios") or []:
+        if not isinstance(item, dict) or not CHAVE_RE.fullmatch(str(item.get("chave") or "")):
+            continue
+        pergunta = _texto(item.get("pergunta"), 300)
+        if len(pergunta) < 5:
+            continue
+        perguntas.append(Pergunta(
+            f"pb_{item['chave']}", "playbook", "noul", pergunta, {
+                "true": _texto(item.get("sim"), 300) or "Sim, aconteceu na conversa.",
+                "false": "Não aconteceu na conversa.",
+            },
+        ))
+
+    jeito = _texto(jeito, 500)
+    if jeito:
+        perguntas.append(Pergunta(
+            "segue_o_jeito", "atendimento", "noul",
+            f"As mensagens da empresa seguem este jeito de falar: \"{jeito}\"?", {
+                "true": "Sim: o tom, o tamanho e a forma das mensagens da empresa combinam com o jeito descrito.",
+                "false": "Não: as mensagens da empresa fogem do jeito descrito, ou a empresa quase não escreveu.",
+            },
+        ))
+
+    return tuple(perguntas[:LIMITE_DE_PERGUNTAS])
+
+
