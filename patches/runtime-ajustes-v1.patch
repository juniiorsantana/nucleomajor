+def conferir_com_os_estados(resultado: dict, notas: Any) -> tuple[dict, dict]:
+    """Tira do diagnóstico o que contradiz o estado estruturado dos critérios.
+
+    Alerta cujo critério não confirma sai; "por que essa nota" de critério não
+    avaliado sai; o gargalo perde a referência a critério não avaliado (o texto
+    fica). Sem nota nenhuma (banco antes do esquema), nada é conferido.
+    Devolve o resultado e quantos itens saíram, para o log.
+    """
+    if not _dict(_dict(notas).get("atendimento")).get("dimensions"):
+        return resultado, {}
+    estados = estados_dos_criterios(notas)
+
+    def confirma(codigo: str) -> bool:
+        criterios, regra = ALERTA_PRECISA[codigo]
+        for criterio in (criterios if isinstance(criterios, tuple) else (criterios,)):
+            if criterio in estados and regra(estados[criterio]):
+                return True
+        return False
+
+    alertas = [a for a in resultado["red_flags"] if confirma(a["code"])]
+    motivos = [m for m in resultado["why_this_score"] if m["criterion"] is None or m["criterion"] in estados]
+    gargalo = resultado["main_bottleneck"]
+    if gargalo and gargalo["criterion"] and gargalo["criterion"] not in estados:
+        gargalo = {**gargalo, "criterion": None}
+    descartes = {
+        "red_flags": len(resultado["red_flags"]) - len(alertas),
+        "why_this_score": len(resultado["why_this_score"]) - len(motivos),
+    }
+    return {**resultado, "red_flags": alertas, "why_this_score": motivos, "main_bottleneck": gargalo}, descartes
+
