+def _numero(valor: Any) -> float | None:
+    try:
+        numero = float(valor)
+    except (TypeError, ValueError):
+        return None
+    if numero != numero or numero < 0 or numero > 1:  # NaN ou fora de 0..1
+        return None
+    return round(numero, 4)
+
+
+def normalizar(chave: str, bruta: Any) -> dict[str, Any] | None:
+    """Uma resposta do Jev no formato que o banco guarda.
+
+    Devolve `{"question", "answer", "probability", "distribution"}` ou `None`
+    quando a resposta não bate com a pergunta — tipo trocado, opção que não
+    existe, nível fora da escala. Resposta que não se entende não é gravada:
+    um "talvez" inventado aqui contaminaria os números gerais.
+    """
+    pergunta = POR_CHAVE.get(chave)
+    if pergunta is None or not isinstance(bruta, dict) or bruta.get("type") != pergunta.tipo:
+        return None
+
+    if pergunta.tipo == "noul":
+        sim = _numero(bruta.get("noul"))
+        if sim is None:
+            return None
+        resposta = "sim" if sim >= 0.5 else "nao"
+        return {
+            "question": chave,
+            "answer": resposta,
+            "probability": sim if resposta == "sim" else round(1 - sim, 4),
+            "distribution": {"sim": sim, "nao": round(1 - sim, 4)},
+        }
+
+    if pergunta.tipo == "choice":
+        escolha = bruta.get("choice")
+        if escolha not in pergunta.criterios:
+            return None
+        probabilidades = bruta.get("probabilities") if isinstance(bruta.get("probabilities"), dict) else {}
+        distribuicao = {
+            opcao: valor
+            for opcao, valor in ((opcao, _numero(probabilidades.get(opcao))) for opcao in pergunta.criterios)
+            if valor is not None
+        }
+        chance = distribuicao.get(escolha)
+        if chance is None:
+            chance = _numero(bruta.get("confidence"))
+        return {"question": chave, "answer": escolha, "probability": chance, "distribution": distribuicao}
+
+    # score: o Jev devolve a posição esperada e a probabilidade de cada nível,
+    # indexada pelo número do nível ("0", "1", ...).
+    niveis = pergunta.criterios
+    probabilidades = bruta.get("probabilities") if isinstance(bruta.get("probabilities"), dict) else {}
+    distribuicao = {}
+    for indice, (nivel, _) in enumerate(niveis):
+        valor = _numero(probabilidades.get(str(indice)))
+        if valor is not None:
+            distribuicao[nivel] = valor
+    if distribuicao:
+        nivel_escolhido = max(distribuicao, key=distribuicao.get)
+        chance = distribuicao[nivel_escolhido]
+    else:
+        try:
+            posicao = round(float(bruta.get("score")))
+        except (TypeError, ValueError):
+            return None
+        if not 0 <= posicao < len(niveis):
+            return None
+        nivel_escolhido = niveis[posicao][0]
+        chance = _numero(bruta.get("confidence"))
+    return {"question": chave, "answer": nivel_escolhido, "probability": chance, "distribution": distribuicao}
