+class FrameworkTests(unittest.TestCase):
+    def test_chaves_unicas_e_validas_para_o_banco(self):
+        chaves = [pergunta.chave for pergunta in jev_framework.PERGUNTAS]
+        self.assertEqual(len(chaves), len(set(chaves)))
+        for chave in chaves:
+            self.assertRegex(chave, r"^[a-z][a-z0-9_]{1,40}$")
+        # O banco aceita até 40 respostas por leitura.
+        self.assertLessEqual(len(chaves), 40)
