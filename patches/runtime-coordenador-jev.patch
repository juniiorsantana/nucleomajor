+    def test_formato_da_api(self):
+        api = jev_framework.perguntas_para_api()
+        self.assertEqual(api["insatisfeito"]["type"], "noul")
+        self.assertEqual(set(api["insatisfeito"]["criteria"]), {"true", "false"})
+        self.assertEqual(api["temperatura"]["type"], "score")
+        self.assertIsInstance(api["temperatura"]["criteria"], list)
+        self.assertEqual(len(api["temperatura"]["criteria"]), 3)
+        self.assertIsInstance(api["intencao"]["criteria"], dict)
