--- /dev/null
+++ b/whatsapp-assistant/jev_framework.py
@@ -0,0 +1,238 @@
+"""As perguntas que o coordenador faz ao Jev sobre cada conversa.
+
+Framework da Major, versão `major-v1` (01/10/2026). Nasceu do teste com 30
+conversas reais da própria Major, que mostrou três ajustes em relação ao
+rascunho:
+
+  * a temperatura em cinco níveis deixava o Jev dividido entre vizinhos
+    (confiança média de 47%). Ficou em três: frio, morno, quente;
+  * "respondeu tudo?" dava "não" em 26 de 30 — qualquer pergunta solta virava
+    falha. Virou "ficou pergunta IMPORTANTE sem resposta?", com o que conta;
+  * "promessa pendente" contava "vou verificar" que se resolvia na mensagem
+    seguinte. Agora é promessa CONCRETA que a conversa terminou sem cumprir.
+
+Mudar uma pergunta muda o que os números gerais medem: troque a versão junto,
+para o banco saber separar uma régua da outra.
+
+Cada pergunta tem um tipo do Jev:
+  * `noul`: sim ou não. Guardada como `sim`/`nao`;
+  * `choice`: uma opção fechada. Guardada pela chave da opção;
+  * `score`: posição numa escala. Guardada pela chave do nível mais provável.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+FRAMEWORK_VERSION = "major-v1"
+
+
+@dataclass(frozen=True)
+class Pergunta:
+    chave: str
+    grupo: str  # lead, atendimento, sinais, desfecho
+    tipo: str  # noul, choice, score
+    instrucao: str
+    # noul: {"true": ..., "false": ...}; choice: {opcao: descricao};
+    # score: tuple de (chave_do_nivel, descricao), do menor para o maior.
+    criterios: Any
+
+    def para_api(self) -> dict[str, Any]:
+        if self.tipo == "score":
+            criteria: Any = [descricao for _, descricao in self.criterios]
+        else:
+            criteria = dict(self.criterios)
+        return {"type": self.tipo, "instructions": self.instrucao, "criteria": criteria}
+
+
+PERGUNTAS: tuple[Pergunta, ...] = (
+    # ------------------------------------------------------------- o lead
+    Pergunta("intencao", "lead", "choice", "Qual é a intenção principal do contato nesta conversa?", {
+        "comprar_agora": "Quer comprar ou contratar agora; pergunta como pagar, quando começar ou pede para fechar.",
+        "pesquisando": "Está comparando ou levantando informações (preço, horários, condições) antes de decidir.",
+        "curiosidade": "Só curiosidade, sem sinal de que pretende comprar.",
+        "ja_cliente": "Já é cliente e fala de algo do serviço que já usa (suporte, remarcação, dúvida, reclamação).",
+        "fora_do_perfil": "Não é um cliente possível: engano, fornecedor, parceiro, candidato a vaga, spam.",
+    }),
+    Pergunta("disse_necessidade", "lead", "noul", "O contato disse o que quer resolver ou qual é o objetivo dele?", {
+        "true": "Ele explica a necessidade, dor ou objetivo, mesmo que de forma curta.",
+        "false": "Ele só pergunta preço ou informação, sem dizer o que quer resolver.",
+    }),
+    Pergunta("prazo", "lead", "choice", "Para quando o contato quer resolver?", {
+        "agora": "Quer resolver hoje ou nos próximos dias.",
+        "este_mes": "Fala em resolver nas próximas semanas ou neste mês.",
+        "sem_prazo": "Diz que é para depois, sem pressa, ou que vai pensar.",
+        "nao_falou": "A conversa não dá nenhuma pista de prazo.",
+    }),
+    Pergunta("sensibilidade_preco", "lead", "score", "Como o contato reagiu ao preço?", (
+        ("nao_falou", "Não falou de preço."),
+        ("perguntou", "Perguntou o preço, sem reclamar."),
+        ("reclamou", "Reclamou do preço, achou caro ou pediu desconto."),
+    )),
+    Pergunta("decisor", "lead", "choice", "Quem decide a compra?", {
+        "o_proprio": "O próprio contato decide.",
+        "outra_pessoa": "Depende de outra pessoa (cônjuge, sócio, pais, chefe).",
+        "nao_da_para_saber": "A conversa não mostra quem decide.",
+    }),
+    Pergunta("objecao_principal", "lead", "choice", "Qual foi a principal objeção do contato?", {
+        "nenhuma": "Não houve objeção.",
+        "preco": "Preço, valor ou forma de pagamento.",
+        "horario_tempo": "Horário, agenda ou falta de tempo.",
+        "confianca": "Desconfiança da empresa, do resultado ou do serviço.",
+        "concorrente": "Está considerando outra empresa.",
+        "nao_e_o_momento": "Diz que agora não é o momento.",
+        "decisor_ausente": "Precisa consultar outra pessoa.",
+        "localizacao": "Distância ou localização.",
+        "outra": "Outra objeção que não se encaixa acima.",
+    }),
+    Pergunta("temperatura", "lead", "score", "Qual a temperatura do lead no fim da conversa?", (
+        ("frio", "Frio: sem interesse, respostas secas ou parou de responder."),
+        ("morno", "Morno: interessado, mas com dúvida, objeção aberta ou sem pressa."),
+        ("quente", "Quente: quer fechar, agendar ou comprar logo."),
+    )),
+    # -------------------------------------------------------- o atendimento
+    Pergunta("pergunta_sem_resposta", "atendimento", "noul",
+             "Ficou alguma pergunta importante do contato sem resposta da empresa?", {
+        "true": "Sim: uma pergunta clara do contato (preço, horário, como funciona, prazo) não recebeu resposta até o fim da conversa.",
+        "false": "Não: as perguntas importantes foram respondidas, mesmo que de forma curta, ou o contato não fez perguntas.",
+    }),
+    Pergunta("perguntou_antes_preco", "atendimento", "choice",
+             "A empresa fez perguntas para entender o contato antes de passar o preço?", {
+        "sim": "Perguntou objetivo, necessidade ou situação antes de falar de valor.",
+        "nao": "Passou o preço direto, sem perguntar nada antes.",
+        "nao_se_aplica": "Preço não foi assunto na conversa.",
+    }),
+    Pergunta("valor_antes_preco", "atendimento", "choice",
+             "A empresa mostrou o valor do serviço (benefícios, o que está incluso, resultados) antes ou junto do preço?", {
+        "sim": "Explicou benefícios ou o que está incluso antes ou junto do preço.",
+        "nao": "Só falou o número, sem mostrar valor.",
+        "nao_se_aplica": "Preço não foi assunto na conversa.",
+    }),
+    Pergunta("tratou_objecao", "atendimento", "choice", "Como a empresa lidou com a objeção do contato?", {
