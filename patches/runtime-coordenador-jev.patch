+        self.assertEqual([n for n, _ in jev_framework.POR_CHAVE["temperatura"].criterios], ["frio", "morno", "quente"])
+        self.assertIn("pergunta_sem_resposta", jev_framework.POR_CHAVE)
+        self.assertNotIn("respondeu_tudo", jev_framework.POR_CHAVE)
+        self.assertIn("CONCRETA", jev_framework.POR_CHAVE["promessa_pendente"].instrucao.upper())
+
+    def test_noul_vira_sim_ou_nao_com_a_chance_da_resposta(self):
+        r = jev_framework.normalizar("insatisfeito", {"type": "noul", "noul": 0.2})
+        self.assertEqual(r["answer"], "nao")
+        self.assertEqual(r["probability"], 0.8)
+        self.assertEqual(r["distribution"], {"sim": 0.2, "nao": 0.8})
+        r = jev_framework.normalizar("insatisfeito", {"type": "noul", "noul": 0.91})
+        self.assertEqual((r["answer"], r["probability"]), ("sim", 0.91))
+
+    def test_choice_guarda_a_opcao_e_a_distribuicao(self):
+        r = jev_framework.normalizar("intencao", {
+            "type": "choice", "choice": "pesquisando", "confidence": 0.5,
+            "probabilities": {"pesquisando": 0.78, "comprar_agora": 0.22, "inventada": 0.9},
+        })
+        self.assertEqual(r["answer"], "pesquisando")
+        self.assertEqual(r["probability"], 0.78)
+        self.assertNotIn("inventada", r["distribution"])
+
+    def test_score_vira_o_nivel_mais_provavel(self):
+        r = jev_framework.normalizar("temperatura", {
+            "type": "score", "score": 1.4, "confidence": 0.5,
+            "probabilities": {"0": 0.05, "1": 0.35, "2": 0.6},
+        })
+        self.assertEqual((r["answer"], r["probability"]), ("quente", 0.6))
+        self.assertEqual(r["distribution"], {"frio": 0.05, "morno": 0.35, "quente": 0.6})
+
+    def test_score_sem_distribuicao_usa_a_posicao(self):
+        r = jev_framework.normalizar("tom_empresa", {"type": "score", "score": 1.9, "confidence": 0.66})
+        self.assertEqual((r["answer"], r["probability"]), ("caloroso", 0.66))
+
+    def test_resposta_que_nao_bate_e_descartada(self):
+        self.assertIsNone(jev_framework.normalizar("intencao", {"type": "choice", "choice": "talvez"}))
+        self.assertIsNone(jev_framework.normalizar("intencao", {"type": "noul", "noul": 0.5}))
+        self.assertIsNone(jev_framework.normalizar("insatisfeito", {"type": "noul", "noul": 1.7}))
+        self.assertIsNone(jev_framework.normalizar("tom_empresa", {"type": "score", "score": 7}))
+        self.assertIsNone(jev_framework.normalizar("nao_existe", {"type": "noul", "noul": 0.1}))
+        self.assertIsNone(jev_framework.normalizar("insatisfeito", None))
+
