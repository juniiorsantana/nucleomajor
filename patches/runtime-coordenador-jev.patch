+class CoordenadorTests(unittest.TestCase):
+    def setUp(self):
+        self.logs = []
+        patcher = patch.object(coordenador.audit, "log", side_effect=lambda evento, **campos: self.logs.append((evento, campos)))
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def novo(self, pendentes, resultados):
+        verifier = FakeVerifier(pendentes)
+        jev = FakeJev(resultados)
+        return coordenador.Coordenador(verifier=verifier, jev=jev, interval=300, quiet_minutes=60, batch=5), verifier, jev
+
+    def test_desligada_no_painel_nao_chama_o_jev(self):
+        c, verifier, jev = self.novo({"enabled": False, "conversations": []}, [])
+        self.assertEqual(c.poll_once(), {"enabled": False, "ok": 0, "failed": 0})
+        self.assertEqual(jev.textos, [])
+        self.assertEqual(verifier.gravadas, [])
+        self.assertEqual(verifier.pedidos, [(5, 60)])
+
+    def test_le_e_grava_cada_conversa(self):
+        c, verifier, jev = self.novo(
+            {"enabled": True, "conversations": [conversa("5565900000001"), conversa("5565900000002")]},
+            [resposta_do_jev(), resposta_do_jev(insatisfeito={"type": "noul", "noul": 0.93})],
+        )
+        resumo = c.poll_once()
+        self.assertEqual((resumo["ok"], resumo["failed"]), (2, 0))
+        self.assertAlmostEqual(resumo["cost_usd"], 0.000336)
+        self.assertEqual(len(verifier.gravadas), 2)
+        gravada = verifier.gravadas[1]
+        self.assertEqual(gravada["status"], "ok")
+        self.assertEqual(gravada["phone"], "5565900000002")
+        self.assertEqual(gravada["analyzedUntil"], "2026-10-01T12:00:00+00:00")
+        self.assertEqual(gravada["frameworkVersion"], "major-v1")
+        self.assertEqual(gravada["model"], "typesafe/jev-1.13-20260917")
+        self.assertEqual((gravada["inputTokens"], gravada["latencyMs"]), (4005, 512))
+        self.assertEqual(len(gravada["answers"]), len(jev_framework.PERGUNTAS))
+        insatisfeito = next(r for r in gravada["answers"] if r["question"] == "insatisfeito")
+        self.assertEqual((insatisfeito["answer"], insatisfeito["probability"]), ("sim", 0.93))
+        self.assertIn("Lead: Quanto custa o plano?", jev.textos[0])
+
+    def test_resposta_parcial_grava_so_o_que_se_entende(self):
+        c, verifier, _ = self.novo(
+            {"enabled": True, "conversations": [conversa()]},
+            [resposta_do_jev(intencao={"type": "choice", "choice": "talvez"})],
+        )
+        c.poll_once()
+        chaves = {r["question"] for r in verifier.gravadas[0]["answers"]}
+        self.assertNotIn("intencao", chaves)
+        self.assertEqual(len(chaves), len(jev_framework.PERGUNTAS) - 1)
+
+    def test_recusa_do_jev_grava_falha_so_naquela_conversa(self):
+        c, verifier, _ = self.novo(
+            {"enabled": True, "conversations": [conversa("5565900000001"), conversa("5565900000002")]},
+            [coordenador.JevRecusa("jev_http_400"), resposta_do_jev()],
+        )
+        resumo = c.poll_once()
+        self.assertEqual((resumo["ok"], resumo["failed"]), (1, 1))
+        self.assertEqual(verifier.gravadas[0]["status"], "failed")
+        self.assertEqual(verifier.gravadas[0]["errorCode"], "jev_http_400")
+        self.assertEqual(verifier.gravadas[0]["answers"], [])
+        self.assertEqual(verifier.gravadas[1]["status"], "ok")
+
+    def test_pausa_para_o_ciclo_sem_gravar_falha(self):
+        c, verifier, jev = self.novo(
+            {"enabled": True, "conversations": [conversa("5565900000001"), conversa("5565900000002")]},
+            [coordenador.JevPausa("jev_http_402"), resposta_do_jev()],
+        )
+        with self.assertRaises(coordenador.JevPausa):
+            c.poll_once()
+        self.assertEqual(verifier.gravadas, [])
+        self.assertEqual(len(jev.textos), 1)
+
+    def test_conversa_sem_texto_e_respostas_inuteis_viram_falha(self):
+        c, verifier, jev = self.novo(
+            {"enabled": True, "conversations": [conversa(mensagens=[]), conversa("5565900000009")]},
+            [{"answers": {"intencao": {"type": "noul", "noul": 0.3}}}],
+        )
+        c.poll_once()
+        self.assertEqual([g["errorCode"] for g in verifier.gravadas], ["conversation_empty", "jev_answers_unusable"])
+        self.assertEqual(len(jev.textos), 1)
+
+    def test_log_nunca_leva_texto_nem_telefone_aberto(self):
+        c, _, _ = self.novo(
+            {"enabled": True, "conversations": [conversa()]},
+            [resposta_do_jev()],
+        )
+        c.poll_once()
+        bruto = json.dumps(self.logs, ensure_ascii=False, default=str)
+        self.assertNotIn("Quanto custa", bruto)
+        self.assertNotIn("R$ 289", bruto)
+        evento, campos = self.logs[0]
+        self.assertEqual(evento, "insights.read")
+        # `phone` é campo que o audit transforma em hash.
+        self.assertIn("phone", campos)
+        self.assertNotIn("content", campos)
+
+    def test_falha_ao_gravar_a_falha_nao_derruba_o_ciclo(self):
+        class VerifierQueRecusa(FakeVerifier):
+            def insights_record(self, payload):
+                if payload["status"] == "failed":
+                    raise OperatorVerificationError("Supabase recusou")
+                return super().insights_record(payload)
+
+        verifier = VerifierQueRecusa({"enabled": True, "conversations": [conversa(mensagens=[]), conversa("5565900000002")]})
+        c = coordenador.Coordenador(verifier=verifier, jev=FakeJev([resposta_do_jev()]))
+        resumo = c.poll_once()
+        self.assertEqual((resumo["ok"], resumo["failed"]), (1, 1))
+
+    def test_thread_sobe_e_para(self):
+        verifier = FakeVerifier({"enabled": False, "conversations": []})
+        c = coordenador.Coordenador(verifier=verifier, jev=FakeJev([]), interval=60)
+        c.start()
+        for _ in range(50):
+            if verifier.pedidos:
+                break
+            time.sleep(0.02)
+        c.stop()
+        self.assertEqual(len(verifier.pedidos), 1)
+        self.assertFalse(c._thread.is_alive())
