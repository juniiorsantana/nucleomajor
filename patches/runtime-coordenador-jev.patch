diff --git a/whatsapp-assistant/coordenador.py b/whatsapp-assistant/coordenador.py
new file mode 100644
index 0000000..1127a37
--- /dev/null
+++ b/whatsapp-assistant/coordenador.py
@@ -0,0 +1,339 @@
+"""O coordenador: lê as conversas com o Jev e grava o que entendeu.
+
+De tempos em tempos (`NUCLEO_INSIGHTS_POLL_SECONDS`, 5 minutos por padrão) ele
+pergunta ao banco quais conversas desta conexão pedem leitura
+(`nucleo_insights_pending`), monta cada uma como texto, manda para o Jev com as
+perguntas de `jev_framework.py` e devolve as respostas (`nucleo_insights_record`).
+
+O Jev é um modelo de DECISÃO da TypeSafe, chamado pelo OpenRouter: não escreve
+texto, responde cada pergunta com uma opção fechada e a chance de estar certa.
+Custa perto de US$ 0,0002 por conversa e responde em menos de um segundo
+(medido em 01/10/2026 com 30 conversas reais da Major).
+
+O que este trabalhador NÃO faz, de propósito:
+  * não age. Nenhuma etiqueta, tarefa ou aviso sai daqui na primeira versão: os
+    cortes de confiança vão ser medidos nas leituras reais antes;
+  * não fica no caminho da resposta ao cliente. Roda numa thread própria; se o
+    Jev cair, o atendimento não percebe;
+  * não registra texto de mensagem em log nenhum, nem a chave.
+
+Duas travas para ligar: `NUCLEO_INSIGHTS=1` no env desta conexão e a função
+`conversation_insights` ligada para a empresa no painel. Com a segunda
+desligada o banco responde `enabled = false` e o coordenador só espera.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Callable, Optional
+from zoneinfo import ZoneInfo
+
+import requests
+
+import audit
+import jev_framework
+from operator_verification import OperatorVerificationError
+
+JEV_ENDPOINT = "https://openrouter.ai/api/alpha/decisions"
+# Versão fixa, nunca a "latest": uma versão nova pode mudar as respostas, e os
+# números gerais precisam saber de que régua cada leitura veio.
+JEV_MODEL = "typesafe/jev-1.13"
+JEV_TIMEOUT = 30
+# Teto de texto por conversa. O Jev aceita 32 mil tokens; 60 mil caracteres
+# ficam bem abaixo disso mesmo com as perguntas junto.
+TEXTO_MAXIMO = 60000
+
+CONTEXTO = (
+    "Conversa de WhatsApp entre um contato (Lead) e uma empresa. As mensagens da "
+    "empresa podem ser da equipe, de um agente de IA ou automáticas. [áudio] e "
+    "[imagem] marcam mídias cujo conteúdo não está disponível."
+)
+
+ROTULO_MIDIA = {
+    "audio": "[áudio]",
+    "ptt": "[áudio]",
+    "image": "[imagem]",
+    "video": "[vídeo]",
+    "document": "[documento]",
+    "sticker": "[figurinha]",
+}
+
+
+class JevPausa(RuntimeError):
+    """Falha que não é desta conversa: chave, crédito, limite, Jev fora do ar.
+
+    Gravar falha em cada conversa por causa disso seria mentir no histórico e
+    segurar todas por uma hora. O ciclo para e o trabalhador espera mais.
+    """
+
+    def __init__(self, codigo: str):
+        super().__init__(codigo)
+        self.codigo = codigo
+
+
+class JevRecusa(RuntimeError):
+    """Falha desta conversa: o Jev recusou o pedido ou respondeu torto."""
+
+    def __init__(self, codigo: str):
+        super().__init__(codigo)
+        self.codigo = codigo
+
+
+def ler_chave(caminho: Optional[Path]) -> str:
+    if caminho is None:
+        raise JevPausa("jev_key_missing")
+    try:
+        chave = Path(caminho).read_text(encoding="utf-8").strip()
+    except OSError:
+        raise JevPausa("jev_key_unreadable")
+    # Aceita o arquivo com a linha `OPENROUTER_API_KEY=...`, que é como a chave
+    # costuma ser guardada, ou só a chave.
+    if "=" in chave and not chave.startswith("sk-or-"):
+        chave = chave.split("=", 1)[1].strip()
+    if not chave.startswith("sk-or-") or any(c.isspace() for c in chave):
+        raise JevPausa("jev_key_invalid")
+    return chave
+
+
+class JevClient:
+    def __init__(self, key_loader: Callable[[], str], session: Optional[requests.Session] = None):
+        self.key_loader = key_loader
+        self.session = session or requests.Session()
+
+    def decidir(self, conversa_em_texto: str) -> dict[str, Any]:
+        corpo = {
+            "model": JEV_MODEL,
+            "state": {"contexto": CONTEXTO, "conversa": conversa_em_texto},
+            "questions": jev_framework.perguntas_para_api(),
+        }
+        inicio = time.monotonic()
+        try:
+            resposta = self.session.post(
+                JEV_ENDPOINT,
+                json=corpo,
+                headers={
+                    "Authorization": f"Bearer {self.key_loader()}",
+                    "Content-Type": "application/json",
+                    "X-Title": "Nucleo Major",
+                },
+                timeout=JEV_TIMEOUT,
+            )
+        except requests.Timeout:
+            raise JevPausa("jev_timeout")
+        except requests.RequestException:
+            raise JevPausa("jev_unreachable")
+        latencia = int((time.monotonic() - inicio) * 1000)
+        if resposta.status_code in (401, 402, 403, 429) or resposta.status_code >= 500:
+            raise JevPausa(f"jev_http_{resposta.status_code}")
+        if resposta.status_code >= 400:
+            raise JevRecusa(f"jev_http_{resposta.status_code}")
+        try:
+            dados = resposta.json()
+        except ValueError:
+            raise JevRecusa("jev_invalid_json")
+        if not isinstance(dados, dict) or not isinstance(dados.get("answers"), dict):
+            raise JevRecusa("jev_no_answers")
+        dados["_latency_ms"] = latencia
+        return dados
+
+
+def _quando(valor: Any, fuso: ZoneInfo) -> str:
+    try:
+        instante = datetime.fromisoformat(str(valor).replace("Z", "+00:00"))
+    except ValueError:
+        return "--/-- --:--"
+    return instante.astimezone(fuso).strftime("%d/%m %H:%M")
+
+
+def conversa_em_texto(mensagens: list[dict], fuso: ZoneInfo) -> str:
+    """A conversa como o Jev lê: uma linha por mensagem, quem falou e quando."""
+    linhas = []
+    for mensagem in mensagens:
+        if not isinstance(mensagem, dict):
+            continue
+        if not mensagem.get("fromMe"):
+            autor = "Lead"
+        elif mensagem.get("authorKind") == "ia":
+            autor = "Empresa (agente de IA)"
+        elif mensagem.get("authorKind") == "bot":
+            autor = "Empresa (mensagem automática)"
+        else:
+            autor = "Empresa (equipe)"
+        texto = str(mensagem.get("content") or "").strip()
+        midia = str(mensagem.get("mediaType") or "").strip().lower()
+        if midia:
+            texto = (ROTULO_MIDIA.get(midia) or f"[{midia}]") + (f" {texto}" if texto else "")
+        if not texto:
+            continue
+        linhas.append(f"[{_quando(mensagem.get('sentAt'), fuso)}] {autor}: {texto}")
+    texto = "\n".join(linhas)
+    # Corta pelo começo: o fim da conversa é o que mais diz sobre o agora.
+    return texto[-TEXTO_MAXIMO:]
+
+
+class Coordenador:
+    def __init__(
+        self,
+        *,
+        verifier,
+        jev: JevClient,
+        interval: float = 300.0,
+        quiet_minutes: int = 60,
+        batch: int = 5,
+        timezone: str = "America/Sao_Paulo",
+    ) -> None:
+        self.verifier = verifier
+        self.jev = jev
+        self.interval = max(60.0, float(interval))
+        self.quiet_minutes = max(5, min(int(quiet_minutes), 1440))
+        self.batch = max(1, min(int(batch), 10))
+        try:
+            self.fuso = ZoneInfo(timezone)
+        except Exception:  # pragma: no cover - fuso inválido no env
+            self.fuso = ZoneInfo("America/Sao_Paulo")
+        self._stop = threading.Event()
+        self._thread: Optional[threading.Thread] = None
+
+    # ------------------------------------------------------------- um ciclo
+
+    def poll_once(self) -> dict:
+        pendentes = self.verifier.insights_pending(self.batch, self.quiet_minutes)
+        if not pendentes.get("enabled"):
+            return {"enabled": False, "ok": 0, "failed": 0}
+        resumo = {"enabled": True, "ok": 0, "failed": 0, "cost_usd": 0.0}
+        for conversa in pendentes.get("conversations") or []:
+            if self._stop.is_set():
+                break
+            situacao = self._ler(conversa)
+            resumo[situacao["status"]] += 1
+            resumo["cost_usd"] += situacao.get("cost_usd", 0.0)
+        resumo["cost_usd"] = round(resumo["cost_usd"], 8)
+        return resumo
+
+    def _ler(self, conversa: dict) -> dict:
+        telefone = str(conversa.get("phone") or "")
+        mensagens = conversa.get("messages") if isinstance(conversa.get("messages"), list) else []
+        base = {
+            "phone": telefone,
+            "analyzedUntil": conversa.get("lastMessageAt"),
+            "messagesCount": len(mensagens),
+            "frameworkVersion": jev_framework.FRAMEWORK_VERSION,
+        }
+        texto = conversa_em_texto(mensagens, self.fuso)
+        if not texto:
+            return self._falha(base, "conversation_empty")
+        try:
+            dados = self.jev.decidir(texto)
+        except JevRecusa as recusa:
+            return self._falha(base, recusa.codigo)
+        # JevPausa sobe: o ciclo inteiro para, e nada é gravado.
+
+        respostas = []
+        brutas = dados.get("answers") or {}
+        for pergunta in jev_framework.PERGUNTAS:
+            normalizada = jev_framework.normalizar(pergunta.chave, brutas.get(pergunta.chave))
+            if normalizada is not None:
+                respostas.append(normalizada)
+        if not respostas:
+            return self._falha(base, "jev_answers_unusable")
+
+        uso = dados.get("usage") if isinstance(dados.get("usage"), dict) else {}
+        custo = _custo(uso.get("cost"))
+        payload = {
+            **base,
+            "status": "ok",
+            "model": str(dados.get("model") or JEV_MODEL)[:80],
+            "inputTokens": _inteiro(uso.get("input_tokens")),
+            "costUsd": custo,
+            "latencyMs": _inteiro(dados.get("_latency_ms")),
+            "answers": respostas,
+        }
+        self.verifier.insights_record(payload)
+        audit.log(
+            "insights.read",
+            phone=telefone or None,
+            messages=len(mensagens),
+            answers=len(respostas),
+            missing=len(jev_framework.PERGUNTAS) - len(respostas),
+            input_tokens=payload["inputTokens"],
+            cost_usd=custo,
+            latency_ms=payload["latencyMs"],
+            model=payload["model"],
+        )
+        return {"status": "ok", "cost_usd": custo}
+
+    def _falha(self, base: dict, codigo: str) -> dict:
+        try:
+            self.verifier.insights_record({**base, "status": "failed", "errorCode": codigo, "answers": []})
+        except OperatorVerificationError as exc:
+            audit.log("insights.record_failed", error_code=codigo, error=str(exc))
+        audit.log("insights.failed", phone=base.get("phone") or None, error_code=codigo)
+        return {"status": "failed"}
+
+    # ------------------------------------------------------------- a thread
+
+    def start(self) -> None:
+        if self._thread and self._thread.is_alive():
+            return
+        self._stop.clear()
+        self._thread = threading.Thread(target=self._run, name="coordenador", daemon=True)
+        self._thread.start()
+
+    def stop(self) -> None:
+        self._stop.set()
+        if self._thread:
+            self._thread.join(timeout=JEV_TIMEOUT + 5)
+
+    def _run(self) -> None:
+        delay = self.interval
+        ultimo = ""
+        ultimo_log = 0.0
+        while not self._stop.is_set():
+            try:
+                resumo = self.poll_once()
+                if resumo.get("ok") or resumo.get("failed"):
+                    audit.log("insights.cycle", **resumo)
+                elif not resumo.get("enabled") and time.monotonic() - ultimo_log >= 3600:
+                    # Desligada no painel: uma linha por hora basta para se
+                    # saber, pelo journal, por que nada está sendo lido.
+                    audit.log("insights.disabled")
+                    ultimo_log = time.monotonic()
+                delay = self.interval
+                ultimo = ""
+            except JevPausa as pausa:
+                agora = time.monotonic()
+                if pausa.codigo != ultimo or agora - ultimo_log >= 600:
+                    audit.log("insights.paused", error_code=pausa.codigo)
+                    ultimo = pausa.codigo
+                    ultimo_log = agora
+                delay = min(3600.0, delay * 2.0)
+            except OperatorVerificationError as exc:
+                agora = time.monotonic()
+                erro = str(exc)
+                if erro != ultimo or agora - ultimo_log >= 600:
+                    audit.log("insights.failed", error_code="control_plane_unavailable", error=erro)
+                    ultimo = erro
+                    ultimo_log = agora
+                delay = min(3600.0, delay * 2.0)
+            except Exception as exc:  # pragma: no cover - última barreira de um daemon
+                audit.log("insights.failed", error_code="unexpected", error=type(exc).__name__)
+                delay = min(3600.0, delay * 2.0)
+            self._stop.wait(delay)
+
+
+def _inteiro(valor: Any) -> int:
+    try:
+        return max(0, int(valor))
+    except (TypeError, ValueError):
+        return 0
+
+
+def _custo(valor: Any) -> float:
+    try:
+        numero = float(valor)
+    except (TypeError, ValueError):
+        return 0.0
+    return round(numero, 8) if numero >= 0 else 0.0
