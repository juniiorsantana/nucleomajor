+"""O coordenador e o framework de perguntas do Jev.
+
+O que estes testes prendem:
+  * as perguntas saem no formato que o Jev aceita (medido em 01/10/2026) e
+    as respostas voltam no formato que o banco aceita, recusando o que não
+    bate com a pergunta;
+  * falha de chave, crédito ou Jev fora do ar PARA o ciclo sem gravar falha
+    em conversa nenhuma; falha da conversa grava `failed` só nela;
+  * com a função desligada no painel, o Jev não é chamado;
+  * texto de mensagem e chave nunca vão para o log.
+"""
+
+import json
+import os
+import re
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+from zoneinfo import ZoneInfo
+
+import requests
+
+import coordenador
+import jev_framework
+from config import Config
+from operator_verification import OperatorVerificationError, OperatorVerifier
+
+
+class FakeResponse:
+    def __init__(self, status_code, payload=None, raw=None):
+        self.status_code = status_code
+        self._payload = payload
+        self.content = (raw if raw is not None else json.dumps(payload)).encode("utf-8")
+
+    def json(self):
+        if self._payload is None:
+            raise ValueError("not json")
+        return self._payload
+
+
+class FakeSession:
+    def __init__(self, responses):
+        self.responses = list(responses)
+        self.calls = []
+
+    def post(self, url, **kwargs):
+        self.calls.append((url, kwargs))
+        resposta = self.responses.pop(0)
+        if isinstance(resposta, Exception):
+            raise resposta
+        return resposta
+
+
+def resposta_do_jev(**sobrepor):
+    """Uma resposta no formato real do Jev, para todas as perguntas."""
+    answers = {}
+    for pergunta in jev_framework.PERGUNTAS:
+        if pergunta.tipo == "noul":
+            answers[pergunta.chave] = {"type": "noul", "noul": 0.2}
+        elif pergunta.tipo == "choice":
+            opcoes = list(pergunta.criterios)
+            answers[pergunta.chave] = {
+                "type": "choice",
+                "choice": opcoes[0],
+                "confidence": 0.6,
+                "probabilities": {opcao: (0.8 if i == 0 else 0.2 / (len(opcoes) - 1)) for i, opcao in enumerate(opcoes)},
+            }
+        else:
+            answers[pergunta.chave] = {
+                "type": "score",
+                "score": 1.1,
+                "confidence": 0.7,
+                "probabilities": {"0": 0.1, "1": 0.7, "2": 0.2},
+            }
+    answers.update(sobrepor)
+    return {
+        "id": "gen-dec-1",
+        "model": "typesafe/jev-1.13-20260917",
+        "provider": "TypeSafe",
+        "answers": answers,
+        "usage": {"input_tokens": 4005, "output_tokens": 70, "cost": 0.000168},
+    }
+
+
+class FakeVerifier:
+    def __init__(self, pendentes):
+        self.pendentes = pendentes
+        self.gravadas = []
+        self.pedidos = []
+
+    def insights_pending(self, max_items, quiet_minutes):
+        self.pedidos.append((max_items, quiet_minutes))
+        return self.pendentes
+
+    def insights_record(self, payload):
+        self.gravadas.append(payload)
+        return {"recorded": True}
+
+
+class FakeJev:
+    def __init__(self, resultados):
+        self.resultados = list(resultados)
+        self.textos = []
+
+    def decidir(self, texto):
+        self.textos.append(texto)
+        resultado = self.resultados.pop(0)
+        if isinstance(resultado, Exception):
+            raise resultado
+        return {**resultado, "_latency_ms": 512}
+
+
+def conversa(telefone="5565900000001", mensagens=None):
+    return {
+        "phone": telefone,
+        "lastMessageAt": "2026-10-01T12:00:00+00:00",
+        "messages": mensagens if mensagens is not None else [
+            {"sentAt": "2026-10-01T11:00:00+00:00", "fromMe": False, "authorKind": "", "mediaType": "", "content": "Quanto custa o plano?"},
+            {"sentAt": "2026-10-01T11:01:00+00:00", "fromMe": True, "authorKind": "ia", "mediaType": "", "content": "R$ 289 por mês."},
+        ],
+    }
